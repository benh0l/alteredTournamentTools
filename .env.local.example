# Local environment configuration template
# Copy this file to .env.local and adjust values for your environment
# NEVER commit .env.local to version control!

###> symfony/framework-bundle ###
# Override APP_SECRET for local development (generate with: php -r "echo bin2hex(random_bytes(16));")
# APP_SECRET=your_generated_secret_here
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
# PostgreSQL connection for local development
# Option 1: Docker (after Story 1-3 setup)
# DATABASE_URL="postgresql://app:!ChangeMe!@database:5432/alteredtournamenttools?serverVersion=16&charset=utf8"
#
# Option 2: Local PostgreSQL installation
# DATABASE_URL="postgresql://postgres:your_password@127.0.0.1:5432/alteredtournamenttools?serverVersion=16&charset=utf8"
###< doctrine/doctrine-bundle ###

###> symfony/mailer ###
# Configure email sending for local development
# MAILER_DSN=smtp://localhost:1025
###< symfony/mailer ###
