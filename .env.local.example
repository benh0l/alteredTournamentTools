# =============================================================================
# LOCAL ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this file to .env.local and fill in your actual values.
# .env.local is NOT committed to version control.
# =============================================================================

###> symfony/framework-bundle ###
# For production, set APP_ENV=prod and APP_DEBUG=0
APP_ENV=dev
APP_DEBUG=1
# Generate a unique secret: php -r "echo bin2hex(random_bytes(16));"
APP_SECRET=your_unique_32_char_secret_here
###< symfony/framework-bundle ###

###> docker/postgres ###
POSTGRES_USER=your_db_username
POSTGRES_PASSWORD=your_secure_db_password
###< docker/postgres ###

###> symfony/mercure-bundle ###
# Generate with: openssl rand -base64 64
MERCURE_JWT_SECRET="your_mercure_jwt_secret_here"
###< symfony/mercure-bundle ###

###> symfony/mailer ###
# Example: smtp://username:password@smtp.example.com:587
MAILER_DSN=smtp://username:password@smtp.yourprovider.com:587
###< symfony/mailer ###
