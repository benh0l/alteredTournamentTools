{% extends 'emails/base.html.twig' %}

{% block title %}{{ 'email.password_reset.subject'|trans }}{% endblock %}

{% block content %}
<h1 style="color: #1a56db; margin-bottom: 20px;">{{ 'email.password_reset.subject'|trans }}</h1>

<p>{{ 'email.common.greeting'|trans({'%name%': user.pseudo}) }}</p>

<p>{{ 'email.password_reset.body'|trans }}</p>

<p>{{ 'email.password_reset.click_below'|trans|default('Cliquez sur le bouton ci-dessous pour choisir un nouveau mot de passe :') }}</p>

<p style="text-align: center; margin: 30px 0;">
    <a href="{{ resetUrl }}" style="background-color: #1a56db; color: white; padding: 12px 24px; text-decoration: none; border-radius: 6px; display: inline-block; font-weight: bold;">
        {{ 'email.password_reset.link_text'|trans }}
    </a>
</p>

<p style="color: #666; font-size: 14px;">
    {{ 'email.password_reset.expiry'|trans }} <strong>{{ expirationMinutes }} {{ 'common.minutes'|trans|default('minutes') }}</strong>.
</p>

<p style="color: #666; font-size: 14px;">
    {{ 'email.password_reset.if_not_requested'|trans|default('Si vous n\'avez pas demande cette reinitialisation, ignorez simplement cet email. Votre mot de passe restera inchange.') }}
</p>

<hr style="border: none; border-top: 1px solid #eee; margin: 30px 0;">

<p style="color: #999; font-size: 12px;">
    {{ 'email.password_reset.copy_link'|trans|default('Si le bouton ne fonctionne pas, copiez et collez ce lien dans votre navigateur :') }}<br>
    <a href="{{ resetUrl }}" style="color: #1a56db;">{{ resetUrl }}</a>
</p>
{% endblock %}
