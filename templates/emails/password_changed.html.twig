{% extends 'emails/base.html.twig' %}

{% block title %}{{ 'email.password_changed.subject'|trans }}{% endblock %}

{% block content %}
<h1 style="color: #1a56db; margin-bottom: 20px;">{{ 'email.password_changed.subject'|trans }}</h1>

<p>{{ 'email.common.greeting'|trans({'%name%': user.pseudo}) }}</p>

<p>{{ 'email.password_changed.body'|trans }}</p>

<p>{{ 'email.password_changed.if_not_you'|trans|default('Si vous n\'etes pas a l\'origine de ce changement, veuillez nous contacter immediatement en repondant a cet email.') }}</p>

<p style="text-align: center; margin: 30px 0;">
    <a href="{{ url('app_login') }}" style="background-color: #1a56db; color: white; padding: 12px 24px; text-decoration: none; border-radius: 6px; display: inline-block; font-weight: bold;">
        {{ 'auth.login.submit'|trans }}
    </a>
</p>

<hr style="border: none; border-top: 1px solid #eee; margin: 30px 0;">

<p style="color: #999; font-size: 12px;">
    {{ 'email.password_changed.security_notice'|trans|default('Pour votre securite, nous vous informons de chaque modification de mot de passe sur votre compte.') }}
</p>
{% endblock %}
