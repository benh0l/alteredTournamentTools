{% extends 'emails/base.html.twig' %}

{% block title %}{{ 'email.welcome.subject'|trans }}{% endblock %}

{% block content %}
<h1 style="color: #1a56db; margin-bottom: 20px;">{{ 'email.common.greeting'|trans({'%name%': user.pseudo}) }}</h1>

<p>{{ 'email.welcome.body'|trans }}</p>

<p>{{ 'email.welcome.can_now'|trans|default('Vous pouvez maintenant :') }}</p>

<ul style="margin: 20px 0; padding-left: 20px;">
    <li>{{ 'email.welcome.feature_1'|trans|default('Participer a des tournois de cartes Altered') }}</li>
    <li>{{ 'email.welcome.feature_2'|trans|default('Suivre vos resultats et classements') }}</li>
    <li>{{ 'email.welcome.feature_3'|trans|default('Organiser vos propres tournois') }}</li>
</ul>

<p style="text-align: center; margin: 30px 0;">
    <a href="{{ url('app_home') }}" style="background-color: #1a56db; color: white; padding: 12px 24px; text-decoration: none; border-radius: 6px; display: inline-block; font-weight: bold;">
        {{ 'email.welcome.start_button'|trans|default('Commencer') }}
    </a>
</p>

<p>{{ 'email.welcome.see_you'|trans|default('A bientot sur les tables de jeu !') }}</p>
{% endblock %}
