{% extends 'base.html.twig' %}

{% block title %}Ronde {{ round.roundNumber }} - {{ tournament.name }}{% endblock %}

{% block body %}
{# Check if pairing modification is available #}
{% set canEditPairings = is_organizer and round.pending and tournament.structure.hasSwiss and not round.eliminationRound %}

<div class="max-w-6xl mx-auto px-4 sm:px-6"
     {% if canEditPairings %}
     data-controller="pairing-editor"
     data-pairing-editor-tournament-id-value="{{ tournament.id }}"
     data-pairing-editor-round-number-value="{{ round.roundNumber }}"
     {% endif %}>
    <div class="mb-4 sm:mb-6">
        <a href="{{ path('round_list', {id: tournament.id}) }}"
           class="inline-flex items-center px-4 py-2 font-medium rounded-xl border-2 shadow-md hover:shadow-lg transition-all duration-200"
           style="background-color: var(--card-bg); color: var(--color-primary-600); border-color: var(--color-primary-200);">
            {{ ux_icon('lucide:arrow-left', {class: 'w-4 h-4 sm:mr-2'}) }}
            <span class="hidden sm:inline">{{ 'round.back_to_rounds'|trans }}</span>
        </a>
    </div>

    <div class="flex items-center justify-between gap-3 mb-4 sm:mb-6">
        <h1 class="text-2xl sm:text-3xl font-bold truncate" style="color: var(--text-primary);">{{ 'dashboard.round.title'|trans({'%number%': round.roundNumber}) }}</h1>
        <div class="flex items-center gap-2">
            {% if canEditPairings %}
                <button data-pairing-editor-target="editButton"
                        data-action="click->pairing-editor#enableEditMode"
                        class="inline-flex items-center px-3 py-1.5 text-sm font-medium rounded-lg bg-amber-500/20 text-amber-600 dark:text-amber-400 hover:bg-amber-500/30 transition">
                    {{ ux_icon('lucide:edit-3', {class: 'w-4 h-4 mr-1'}) }}
                    {{ 'round.edit_pairings'|trans|default('Modifier pairings') }}
                </button>
                <button data-pairing-editor-target="saveButton"
                        data-action="click->pairing-editor#saveChanges"
                        class="hidden inline-flex items-center px-3 py-1.5 text-sm font-medium rounded-lg bg-green-500 text-white hover:bg-green-600 transition">
                    {{ ux_icon('lucide:check', {class: 'w-4 h-4 mr-1'}) }}
                    {{ 'common.save'|trans|default('Enregistrer') }}
                </button>
                <button data-pairing-editor-target="cancelButton"
                        data-action="click->pairing-editor#cancelChanges"
                        class="hidden inline-flex items-center px-3 py-1.5 text-sm font-medium rounded-lg bg-gray-500/20 text-gray-600 dark:text-gray-400 hover:bg-gray-500/30 transition">
                    {{ ux_icon('lucide:x', {class: 'w-4 h-4 mr-1'}) }}
                    {{ 'common.cancel'|trans|default('Annuler') }}
                </button>
            {% endif %}
            {% if is_organizer and round.pending %}
                <form action="{{ path('round_start', {id: tournament.id, roundNumber: round.roundNumber}) }}" method="post" class="inline"
                      {% if canEditPairings %}data-pairing-editor-target="startRoundForm"{% endif %}>
                    <input type="hidden" name="_token" value="{{ csrf_token('start-round-' ~ tournament.id) }}">
                    <button type="submit"
                            class="inline-flex items-center px-4 py-2 text-sm font-semibold rounded-lg bg-gradient-to-r from-emerald-500 to-teal-500 text-white hover:from-emerald-600 hover:to-teal-600 shadow-md hover:shadow-lg transition-all">
                        {{ ux_icon('lucide:play', {class: 'w-4 h-4 mr-1.5'}) }}
                        {{ 'round.start'|trans|default('Démarrer la ronde') }}
                    </button>
                </form>
            {% endif %}
            <span class="{{ round.status.badgeClasses }} px-2 sm:px-3 py-1 rounded text-xs sm:text-sm flex-shrink-0">
                {{ round.status.label|trans }}
            </span>
        </div>
    </div>

    {% if round.startedAt %}
        <p class="mb-4 sm:mb-6 text-sm sm:text-base" style="color: var(--text-secondary);">
            {{ 'round.started_at'|trans({'%date%': round.startedAt|date('d/m/Y H:i')}) }}
            {% if round.completedAt %}
                - {{ 'round.completed_at'|trans({'%date%': round.completedAt|date('d/m/Y H:i')}) }}
            {% endif %}
        </p>
    {% endif %}

    {# BYE Zone for drag & drop (hidden by default) #}
    {% if canEditPairings %}
    <div data-pairing-editor-target="byeZone"
         class="hidden mb-4 p-4 rounded-lg border-2 border-dashed border-amber-400 bg-amber-50/50 dark:bg-amber-900/20 text-center transition-all">
        {{ ux_icon('lucide:user-minus', {class: 'w-8 h-8 mx-auto mb-2 text-amber-500'}) }}
        <p class="text-sm font-medium text-amber-600 dark:text-amber-400">{{ 'round.bye_zone'|trans|default('Deposer ici pour attribuer un BYE') }}</p>
    </div>
    {% endif %}

    <div class="rounded-lg shadow overflow-hidden" style="background-color: var(--card-bg);" {% if canEditPairings %}data-pairing-editor-target="matchesContainer"{% endif %}>
        {# Mobile view: Cards #}
        <div class="lg:hidden p-3 sm:p-4 space-y-3">
            {% for match in matches %}
                {% set isUserInMatch = user_registration_id and (match.player1.id == user_registration_id or (match.player2 and match.player2.id == user_registration_id)) %}
                {% set canSubmit = not match.completed and not match.isByeMatch and (is_organizer or isUserInMatch) %}
                <div class="rounded-lg p-4 {% if isUserInMatch %}bg-blue-500/10 border-blue-300 dark:border-blue-500/50{% elseif match.disputed %}bg-red-500/10{% endif %}" style="background-color: var(--bg-subtle); border: 1px solid {% if isUserInMatch %}{% elseif match.disputed %}{% else %}var(--border-default){% endif %};">
                    {# Header: Table number + Status #}
                    <div class="flex justify-between items-center mb-3">
                        <span class="text-xs font-medium px-2 py-1 rounded" style="background-color: var(--card-bg); color: var(--text-secondary);">
                            {{ 'common.table'|trans }} {{ match.tableNumber }}
                        </span>
                        <span class="{{ match.status.badgeClasses }} px-2 py-1 rounded text-xs">
                            {{ match.status.label|trans }}
                        </span>
                    </div>

                    {# Players and Score #}
                    <div class="flex items-center justify-between gap-2">
                        {# Player 1 #}
                        <div class="flex-1 text-center p-2 rounded-lg transition-all"
                             {% if canEditPairings and not match.isByeMatch %}
                             data-pairing-editor-target="playerCard"
                             data-player-id="{{ match.player1.id }}"
                             {% endif %}>
                            <div class="text-sm font-medium truncate {% if match.winner and match.winner == match.player1 %}text-green-600{% endif %}" style="{% if not (match.winner and match.winner == match.player1) %}color: var(--text-primary);{% endif %}">
                                {{ match.player1.player.displayName }}
                                {% if user_registration_id and match.player1.id == user_registration_id %}
                                    <span class="text-xs" style="color: var(--color-primary-600);">({{ 'common.you'|trans }})</span>
                                {% endif %}
                            </div>
                            {% if match.winner and match.winner == match.player1 %}
                                <div class="text-xs text-green-600">{{ 'dashboard.matches.winner'|trans }}</div>
                            {% endif %}
                        </div>

                        {# Score #}
                        <div class="flex-shrink-0 px-3">
                            {% if match.completed %}
                                {% if match.winner %}
                                    <span class="text-lg font-bold" style="color: var(--text-primary);">{{ match.player1Score ?? '-' }} - {{ match.player2Score ?? '-' }}</span>
                                {% else %}
                                    <span class="text-lg font-bold text-amber-600" title="{{ 'dashboard.matches.draw'|trans }}">{{ match.player1Score ?? '-' }} - {{ match.player2Score ?? '-' }}</span>
                                {% endif %}
                            {% elseif match.isByeMatch %}
                                <span class="text-sm" style="color: var(--text-muted);">{{ 'home.bye'|trans }}</span>
                            {% else %}
                                <span class="text-lg font-bold" style="color: var(--text-muted);">vs</span>
                            {% endif %}
                        </div>

                        {# Player 2 #}
                        <div class="flex-1 text-center p-2 rounded-lg transition-all"
                             {% if canEditPairings and match.player2 %}
                             data-pairing-editor-target="playerCard"
                             data-player-id="{{ match.player2.id }}"
                             {% endif %}>
                            {% if match.player2 %}
                                <div class="text-sm font-medium truncate {% if match.winner and match.player2 and match.winner == match.player2 %}text-green-600{% endif %}" style="{% if not (match.winner and match.player2 and match.winner == match.player2) %}color: var(--text-primary);{% endif %}">
                                    {{ match.player2.player.displayName }}
                                    {% if user_registration_id and match.player2.id == user_registration_id %}
                                        <span class="text-xs" style="color: var(--color-primary-600);">({{ 'common.you'|trans }})</span>
                                    {% endif %}
                                </div>
                                {% if match.winner and match.winner == match.player2 %}
                                    <div class="text-xs text-green-600">{{ 'dashboard.matches.winner'|trans }}</div>
                                {% endif %}
                            {% else %}
                                <span class="text-sm italic" style="color: var(--text-muted);">{{ 'home.bye'|trans }}</span>
                            {% endif %}
                        </div>
                    </div>

                    {# Action button #}
                    <div class="mt-3 pt-3" style="border-top: 1px solid var(--border-default);">
                        {% if match.isByeMatch %}
                            <span class="block text-center text-sm" style="color: var(--text-muted);">-</span>
                        {% elseif match.completed %}
                            {% if is_organizer %}
                                <a href="{{ path('match_submit_form', {id: match.id}) }}"
                                   class="block w-full text-center px-4 py-2 rounded-lg text-sm font-medium transition-colors text-purple-600 dark:text-purple-400" style="background-color: var(--card-bg); border: 1px solid var(--border-default);">
                                    {{ 'round.correct'|trans }}
                                </a>
                            {% else %}
                                <span class="block text-center text-sm text-green-600">{{ 'dashboard.matches.match_completed'|trans }}</span>
                            {% endif %}
                        {% elseif match.disputed %}
                            {% if is_organizer %}
                                <a href="{{ path('dispute_show', {tournamentId: tournament.id, matchId: match.id}) }}"
                                   class="block w-full text-center px-4 py-2 bg-red-500 text-white rounded-lg text-sm font-medium hover:bg-red-600 transition-colors">
                                    {{ 'dashboard.matches.resolve'|trans }}
                                </a>
                            {% else %}
                                <span class="block text-center text-sm text-red-600">{{ 'round.dispute'|trans }}</span>
                            {% endif %}
                        {% elseif canSubmit %}
                            <a href="{{ path('match_submit_form', {id: match.id}) }}"
                               class="block w-full text-center px-4 py-2 rounded-lg text-sm font-semibold transition-all shadow-sm
                                      {% if is_organizer and not isUserInMatch %}
                                          bg-purple-500 text-white hover:bg-purple-600
                                      {% else %}
                                          bg-gradient-to-r from-emerald-500 to-teal-500 text-white hover:from-emerald-600 hover:to-teal-600
                                      {% endif %}">
                                {{ ux_icon('lucide:pencil', {class: 'w-4 h-4 inline mr-1'}) }}
                                {% if is_organizer and not isUserInMatch %}
                                    {{ 'round.validate'|trans }}
                                {% else %}
                                    {{ 'dashboard.matches.submit'|trans }}
                                {% endif %}
                            </a>
                        {% else %}
                            <span class="block text-center text-sm" style="color: var(--text-muted);">-</span>
                        {% endif %}
                    </div>
                </div>
            {% else %}
                <div class="text-center py-8" style="color: var(--text-muted);">
                    {{ 'dashboard.round.no_matches'|trans }}
                </div>
            {% endfor %}
        </div>

        {# Desktop view: Table #}
        <div class="hidden lg:block overflow-x-auto">
            <table class="min-w-full" style="border-collapse: separate; border-spacing: 0;">
                <thead style="background-color: var(--bg-subtle);">
                    <tr>
                        <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider" style="color: var(--text-muted); border-bottom: 1px solid var(--border-default);">
                            {{ 'common.table'|trans }}
                        </th>
                        <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider" style="color: var(--text-muted); border-bottom: 1px solid var(--border-default);">
                            {{ 'dashboard.matches.player1'|trans }}
                        </th>
                        <th class="px-6 py-3 text-center text-xs font-medium uppercase tracking-wider" style="color: var(--text-muted); border-bottom: 1px solid var(--border-default);">
                            {{ 'common.score'|trans }}
                        </th>
                        <th class="px-6 py-3 text-right text-xs font-medium uppercase tracking-wider" style="color: var(--text-muted); border-bottom: 1px solid var(--border-default);">
                            {{ 'dashboard.matches.player2'|trans }}
                        </th>
                        <th class="px-6 py-3 text-center text-xs font-medium uppercase tracking-wider" style="color: var(--text-muted); border-bottom: 1px solid var(--border-default);">
                            {{ 'common.status'|trans }}
                        </th>
                        <th class="px-6 py-3 text-center text-xs font-medium uppercase tracking-wider" style="color: var(--text-muted); border-bottom: 1px solid var(--border-default);">
                            {{ 'common.actions'|trans }}
                        </th>
                    </tr>
                </thead>
                <tbody style="background-color: var(--card-bg);">
                    {% for match in matches %}
                        {% set isUserInMatch = user_registration_id and (match.player1.id == user_registration_id or (match.player2 and match.player2.id == user_registration_id)) %}
                        {% set canSubmit = not match.completed and not match.isByeMatch and (is_organizer or isUserInMatch) %}
                        <tr class="{% if isUserInMatch %}bg-blue-500/10{% endif %}" style="border-bottom: 1px solid var(--border-default);">
                            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium" style="color: var(--text-primary);">
                                {{ match.tableNumber }}
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm {% if match.winner and match.winner == match.player1 %}font-bold text-green-600{% endif %}" style="{% if not (match.winner and match.winner == match.player1) %}color: var(--text-primary);{% endif %}">
                                <span class="inline-block p-1 rounded transition-all"
                                      {% if canEditPairings and not match.isByeMatch %}
                                      data-pairing-editor-target="playerCard"
                                      data-player-id="{{ match.player1.id }}"
                                      {% endif %}>
                                    {{ match.player1.player.displayName }}
                                    {% if user_registration_id and match.player1.id == user_registration_id %}
                                        <span class="ml-1 text-xs" style="color: var(--color-primary-600);">({{ 'common.you'|trans }})</span>
                                    {% endif %}
                                </span>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-center" style="color: var(--text-primary);">
                                {% if match.completed %}
                                    {% if match.winner %}
                                        {{ match.player1Score ?? '-' }} - {{ match.player2Score ?? '-' }}
                                    {% else %}
                                        <span class="text-amber-600 font-medium" title="{{ 'dashboard.matches.draw'|trans }}">{{ match.player1Score ?? '-' }} - {{ match.player2Score ?? '-' }}</span>
                                    {% endif %}
                                {% elseif match.isByeMatch %}
                                    {{ 'home.bye'|trans }}
                                {% else %}
                                    -
                                {% endif %}
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-right {% if match.winner and match.player2 and match.winner == match.player2 %}font-bold text-green-600{% endif %}" style="{% if not (match.winner and match.player2 and match.winner == match.player2) %}color: var(--text-primary);{% endif %}">
                                {% if match.player2 %}
                                    <span class="inline-block p-1 rounded transition-all"
                                          {% if canEditPairings %}
                                          data-pairing-editor-target="playerCard"
                                          data-player-id="{{ match.player2.id }}"
                                          {% endif %}>
                                        {{ match.player2.player.displayName }}
                                        {% if user_registration_id and match.player2.id == user_registration_id %}
                                            <span class="ml-1 text-xs" style="color: var(--color-primary-600);">({{ 'common.you'|trans }})</span>
                                        {% endif %}
                                    </span>
                                {% else %}
                                    <span class="italic" style="color: var(--text-muted);">{{ 'home.bye'|trans }}</span>
                                {% endif %}
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-center">
                                <span class="{{ match.status.badgeClasses }} px-2 py-1 rounded text-xs">
                                    {{ match.status.label|trans }}
                                </span>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-center">
                                {% if match.isByeMatch %}
                                    <span class="text-sm" style="color: var(--text-muted);">-</span>
                                {% elseif match.completed %}
                                    {% if is_organizer %}
                                        <a href="{{ path('match_submit_form', {id: match.id}) }}"
                                           class="text-purple-600 hover:text-purple-800 text-sm">
                                            {{ 'round.correct'|trans }}
                                        </a>
                                    {% else %}
                                        <span class="text-green-600 text-sm">{{ 'dashboard.matches.match_completed'|trans }}</span>
                                    {% endif %}
                                {% elseif match.disputed %}
                                    {% if is_organizer %}
                                        <a href="{{ path('dispute_show', {tournamentId: tournament.id, matchId: match.id}) }}"
                                           class="text-red-600 hover:text-red-800 text-sm font-medium">
                                            {{ 'dashboard.matches.resolve'|trans }}
                                        </a>
                                    {% else %}
                                        <span class="text-red-600 text-sm">{{ 'round.dispute'|trans }}</span>
                                    {% endif %}
                                {% elseif canSubmit %}
                                    <a href="{{ path('match_submit_form', {id: match.id}) }}"
                                       class="inline-flex items-center px-3 py-1.5 text-sm font-medium rounded-lg transition
                                              {% if is_organizer and not isUserInMatch %}
                                                  bg-purple-500/20 text-purple-600 dark:text-purple-400 hover:bg-purple-500/30
                                              {% else %}
                                                  bg-blue-500/20 text-blue-600 dark:text-blue-400 hover:bg-blue-500/30
                                              {% endif %}">
                                        {{ ux_icon('lucide:pencil', {class: 'w-4 h-4 mr-1'}) }}
                                        {% if is_organizer and not isUserInMatch %}
                                            {{ 'round.validate'|trans }}
                                        {% else %}
                                            {{ 'dashboard.matches.submit'|trans }}
                                        {% endif %}
                                    </a>
                                {% else %}
                                    <span class="text-sm" style="color: var(--text-muted);">-</span>
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    <div class="mt-4 sm:mt-6 flex flex-col sm:flex-row justify-between items-center gap-3">
        <div class="text-sm" style="color: var(--text-secondary);">
            {{ 'dashboard.round.matches_completed'|trans({'%completed%': round.completedMatchesCount, '%total%': matches|length}) }}
        </div>
        <a href="{{ path('round_standings', {id: tournament.id}) }}"
           class="inline-flex items-center px-4 py-2 font-medium rounded-xl border-2 shadow-md hover:shadow-lg transition-all duration-200"
           style="background-color: var(--card-bg); color: var(--color-primary-600); border-color: var(--color-primary-200);">
            {{ 'dashboard.matches.standings'|trans }}
            {{ ux_icon('lucide:arrow-right', {class: 'w-4 h-4 ml-2'}) }}
        </a>
    </div>

    {# Rematch Warning Modal #}
    {% if canEditPairings %}
    <div data-pairing-editor-target="rematchModal"
         class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/50">
        <div class="rounded-xl shadow-2xl max-w-md w-full p-6" style="background-color: var(--card-bg);">
            <div class="flex items-start gap-4">
                <div class="flex-shrink-0 w-10 h-10 rounded-full bg-amber-100 dark:bg-amber-900/30 flex items-center justify-center">
                    {{ ux_icon('lucide:alert-triangle', {class: 'w-5 h-5 text-amber-600'}) }}
                </div>
                <div class="flex-1">
                    <h3 class="text-lg font-semibold mb-2" style="color: var(--text-primary);">
                        {{ 'round.rematch_warning_title'|trans|default('Attention : Rematch detecte') }}
                    </h3>
                    <p data-pairing-editor-target="rematchMessage" class="text-sm mb-4" style="color: var(--text-secondary);">
                        {# Message will be set dynamically #}
                    </p>
                    <div class="flex gap-3 justify-end">
                        <button data-action="click->pairing-editor#cancelRematch"
                                class="px-4 py-2 text-sm font-medium rounded-lg transition"
                                style="background-color: var(--bg-subtle); color: var(--text-primary);">
                            {{ 'common.cancel'|trans|default('Annuler') }}
                        </button>
                        <button data-action="click->pairing-editor#confirmRematch"
                                class="px-4 py-2 text-sm font-medium rounded-lg bg-amber-500 text-white hover:bg-amber-600 transition">
                            {{ 'round.confirm_rematch'|trans|default('Continuer quand meme') }}
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    {% endif %}
</div>
{% endblock %}
