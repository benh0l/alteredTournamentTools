{% extends 'base.html.twig' %}

{% block title %}Classement - {{ tournament.name }}{% endblock %}

{% block body %}
<div class="max-w-6xl mx-auto">
    <div class="mb-6">
        <a href="{{ path('round_list', {id: tournament.id}) }}" class="hover:underline" style="color: var(--color-primary-600);">
            &larr; Retour aux rondes
        </a>
    </div>

    <h1 class="text-3xl font-bold mb-6" style="color: var(--text-primary);">{{ tournament.name }} - Classement</h1>

    {% if standings|length == 0 %}
        <div class="bg-yellow-500/10 border border-yellow-500/30 rounded-lg p-6 text-center">
            <p class="text-yellow-800 dark:text-yellow-400">Aucun classement disponible. Le tournoi n'a pas encore demarre.</p>
        </div>
    {% else %}
        <div class="rounded-lg shadow overflow-hidden" style="background-color: var(--card-bg);">
            <table class="min-w-full" style="border-collapse: separate; border-spacing: 0;">
                <thead style="background-color: var(--bg-subtle);">
                    <tr>
                        <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider" style="color: var(--text-muted); border-bottom: 1px solid var(--border-default);">
                            Rang
                        </th>
                        <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider" style="color: var(--text-muted); border-bottom: 1px solid var(--border-default);">
                            Joueur
                        </th>
                        <th class="px-6 py-3 text-center text-xs font-medium uppercase tracking-wider" style="color: var(--text-muted); border-bottom: 1px solid var(--border-default);">
                            Heros
                        </th>
                        <th class="px-6 py-3 text-center text-xs font-medium uppercase tracking-wider" style="color: var(--text-muted); border-bottom: 1px solid var(--border-default);">
                            Points
                        </th>
                        <th class="px-6 py-3 text-center text-xs font-medium uppercase tracking-wider" style="color: var(--text-muted); border-bottom: 1px solid var(--border-default);">
                            V-N-D
                        </th>
                        {% if is_round_robin|default(false) %}
                            <th class="px-6 py-3 text-center text-xs font-medium uppercase tracking-wider" title="Differentiel de parties (gagnees - perdues)" style="color: var(--text-muted); border-bottom: 1px solid var(--border-default);">
                                Diff
                            </th>
                            <th class="px-6 py-3 text-center text-xs font-medium uppercase tracking-wider" title="Parties gagnees" style="color: var(--text-muted); border-bottom: 1px solid var(--border-default);">
                                PG
                            </th>
                        {% else %}
                            <th class="px-6 py-3 text-center text-xs font-medium uppercase tracking-wider" title="Opponent Match Win Percentage" style="color: var(--text-muted); border-bottom: 1px solid var(--border-default);">
                                OMW%
                            </th>
                        {% endif %}
                    </tr>
                </thead>
                <tbody style="background-color: var(--card-bg);">
                    {% for standing in standings %}
                        <tr class="{% if loop.index <= 8 %}bg-green-500/10{% endif %}" style="border-bottom: 1px solid var(--border-default);">
                            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium" style="color: var(--text-primary);">
                                {{ loop.index }}
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm" style="color: var(--text-primary);">
                                {{ standing.registration.player.displayName }}
                                {% if standing.hasReceivedBye %}
                                    <span class="text-xs" style="color: var(--text-muted);">(BYE)</span>
                                {% endif %}
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-center">
                                {% if standing.registration.hero %}
                                    <div class="flex flex-col items-center">
                                        <div class="w-10 h-10 rounded-full overflow-hidden border-2 mb-1" style="border-color: {{ standing.registration.faction ? standing.registration.faction.color : 'var(--border-muted)' }};">
                                            <img src="{{ standing.registration.heroImage }}" alt="{{ standing.registration.heroLabel }}" class="w-full h-full object-cover" onerror="this.parentElement.innerHTML='<div class=\'w-full h-full flex items-center justify-center bg-gray-200\'><span class=\'text-xs text-gray-500\'>?</span></div>'">
                                        </div>
                                        <span class="text-xs" style="color: var(--text-muted);">{{ standing.registration.heroLabel }}</span>
                                    </div>
                                {% else %}
                                    <span class="text-xs" style="color: var(--text-muted);">-</span>
                                {% endif %}
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-center font-bold" style="color: var(--text-primary);">
                                {{ standing.matchPoints }}
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-center" style="color: var(--text-secondary);">
                                <span class="text-green-600">{{ standing.wins }}</span>-<span class="text-amber-600">{{ standing.draws }}</span>-<span class="text-red-600">{{ standing.losses }}</span>
                            </td>
                            {% if is_round_robin|default(false) %}
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-center font-medium" style="color: {% if standing.gameDifferential > 0 %}var(--color-success-600){% elseif standing.gameDifferential < 0 %}var(--color-error-600){% else %}var(--text-secondary){% endif %};">
                                    {% if standing.gameDifferential > 0 %}+{% endif %}{{ standing.gameDifferential }}
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-center" style="color: var(--text-secondary);">
                                    {{ standing.gamesWon }}
                                </td>
                            {% else %}
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-center" style="color: var(--text-secondary);">
                                    {{ (standing.opponentMatchWinPercentage * 100)|number_format(1) }}%
                                </td>
                            {% endif %}
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        <div class="mt-4 text-sm" style="color: var(--text-secondary);">
            <p><strong>Points:</strong> 3 par victoire, 1 par egalite, 0 par defaite</p>
            <p><strong>V-N-D:</strong> Victoires - Nuls (egalites) - Defaites</p>
            {% if is_round_robin|default(false) %}
                <p><strong>Diff:</strong> Differentiel de parties (gagnees - perdues)</p>
                <p><strong>PG:</strong> Parties gagnees</p>
                <p class="mt-2"><strong>Ordre de departage:</strong> Points > Differentiel > Parties gagnees > Confrontation directe</p>
            {% else %}
                <p><strong>OMW%:</strong> Pourcentage de victoires moyen des adversaires rencontres (departage)</p>
            {% endif %}
        </div>
    {% endif %}
</div>
{% endblock %}
