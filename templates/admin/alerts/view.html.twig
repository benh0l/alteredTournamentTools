{% extends 'admin/base.html.twig' %}

{% block title %}Alerte #{{ alert.id }} - Administration{% endblock %}

{% block admin_content %}
<div class="py-8">
    <div class="container mx-auto px-4">
        {# Breadcrumb #}
        <div class="mb-6">
            <a href="{{ path('admin_alerts') }}" class="hover:underline" style="color: var(--color-primary-600);">
                &larr; Retour aux alertes
            </a>
        </div>

        <div class="max-w-3xl">
            {# Alert Header #}
            <div class="rounded-lg shadow mb-6 border-l-4
                {% if alert.severity.value == 'critical' %}border-red-500
                {% elseif alert.severity.value == 'warning' %}border-yellow-500
                {% else %}border-blue-500{% endif %}" style="background-color: var(--card-bg);">
                <div class="px-6 py-5" style="border-bottom: 1px solid var(--border-default);">
                    <div class="flex items-center justify-between">
                        <div class="flex items-center space-x-3">
                            {# Severity icon #}
                            {% if alert.severity.value == 'critical' %}
                                {{ ux_icon('lucide:alert-triangle', {class: 'h-8 w-8 text-red-500'}) }}
                            {% elseif alert.severity.value == 'warning' %}
                                {{ ux_icon('lucide:alert-triangle', {class: 'h-8 w-8 text-yellow-500'}) }}
                            {% else %}
                                {{ ux_icon('lucide:info', {class: 'h-8 w-8 text-blue-500'}) }}
                            {% endif %}

                            <div>
                                <h1 class="text-xl font-bold" style="color: var(--text-primary);">{{ alert.type.label|trans }}</h1>
                                <p class="text-sm" style="color: var(--text-muted);">Alerte #{{ alert.id }}</p>
                            </div>
                        </div>

                        <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium
                            {% if alert.severity.value == 'critical' %}bg-red-100 text-red-800
                            {% elseif alert.severity.value == 'warning' %}bg-yellow-100 text-yellow-800
                            {% else %}bg-blue-100 text-blue-800{% endif %}">
                            {{ alert.severity.label|trans }}
                        </span>
                    </div>
                </div>

                <div class="px-6 py-5">
                    <p class="text-lg mb-4" style="color: var(--text-primary);">{{ alert.message }}</p>

                    <dl class="grid grid-cols-2 gap-4">
                        <div>
                            <dt class="text-sm font-medium" style="color: var(--text-muted);">Creee le</dt>
                            <dd class="mt-1 text-sm" style="color: var(--text-primary);">{{ alert.createdAt|date('d/m/Y H:i:s') }}</dd>
                        </div>
                        <div>
                            <dt class="text-sm font-medium" style="color: var(--text-muted);">Statut</dt>
                            <dd class="mt-1">
                                {% if alert.acknowledged %}
                                    <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-gray-100 text-gray-800">
                                        Acquittee
                                    </span>
                                {% else %}
                                    <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-green-100 text-green-800">
                                        Active
                                    </span>
                                {% endif %}
                            </dd>
                        </div>

                        {% if alert.acknowledged %}
                            <div>
                                <dt class="text-sm font-medium" style="color: var(--text-muted);">Acquittee le</dt>
                                <dd class="mt-1 text-sm" style="color: var(--text-primary);">{{ alert.acknowledgedAt|date('d/m/Y H:i:s') }}</dd>
                            </div>
                            <div>
                                <dt class="text-sm font-medium" style="color: var(--text-muted);">Acquittee par</dt>
                                <dd class="mt-1 text-sm" style="color: var(--text-primary);">
                                    {% if alert.acknowledgedBy %}
                                        {{ alert.acknowledgedBy.pseudo }}
                                    {% else %}
                                        Inconnu
                                    {% endif %}
                                </dd>
                            </div>
                        {% endif %}
                    </dl>

                    {% if not alert.acknowledged %}
                        <div class="mt-6">
                            <form action="{{ path('admin_alert_acknowledge', {id: alert.id}) }}" method="POST">
                                <input type="hidden" name="_token" value="{{ csrf_token('admin_alert_acknowledge') }}">
                                <button type="submit"
                                        class="inline-flex items-center px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-green-600 hover:bg-green-700">
                                    {{ ux_icon('lucide:check', {class: 'h-4 w-4 mr-2'}) }}
                                    Acquitter cette alerte
                                </button>
                            </form>
                        </div>
                    {% endif %}
                </div>
            </div>

            {# Details Section #}
            {% if alert.details %}
                <div class="rounded-lg shadow mb-6" style="background-color: var(--card-bg);">
                    <div class="px-6 py-4" style="border-bottom: 1px solid var(--border-default);">
                        <h2 class="text-lg font-medium" style="color: var(--text-primary);">Details techniques</h2>
                    </div>
                    <div class="px-6 py-5">
                        <pre class="rounded-lg p-4 text-sm overflow-x-auto" style="background-color: var(--bg-subtle); color: var(--text-secondary);">{{ alert.details|json_encode(constant('JSON_PRETTY_PRINT') b-or constant('JSON_UNESCAPED_UNICODE')) }}</pre>
                    </div>
                </div>
            {% endif %}

            {# Related Logs Link #}
            <div class="rounded-lg shadow" style="background-color: var(--card-bg);">
                <div class="px-6 py-4" style="border-bottom: 1px solid var(--border-default);">
                    <h2 class="text-lg font-medium" style="color: var(--text-primary);">Logs associes</h2>
                </div>
                <div class="px-6 py-5">
                    <p class="text-sm mb-4" style="color: var(--text-secondary);">
                        Consultez les logs systeme pour plus d'informations sur cette alerte.
                    </p>
                    <a href="{{ path('admin_logs', {level: 'error'}) }}"
                       class="inline-flex items-center px-4 py-2 rounded-md shadow-sm text-sm font-medium" style="border: 1px solid var(--border-default); color: var(--text-secondary); background-color: var(--card-bg);">
                        {{ ux_icon('lucide:file-text', {class: 'h-4 w-4 mr-2'}) }}
                        Voir les logs d'erreur
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
