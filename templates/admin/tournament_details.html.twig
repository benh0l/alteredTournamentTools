{% extends 'admin/base.html.twig' %}

{% block title %}{{ tournament.name }} - Administration{% endblock %}

{% block admin_content %}
<div class="py-8">
    <div class="container mx-auto px-4">
        {# Breadcrumb #}
        <div class="mb-6">
            <a href="{{ path('admin_dashboard') }}" class="hover:underline" style="color: var(--color-primary-600);">
                &larr; Retour au tableau de bord
            </a>
        </div>

        {# Tournament Header #}
        <div class="rounded-lg shadow mb-8" style="background-color: var(--card-bg);">
            <div class="px-6 py-5" style="border-bottom: 1px solid var(--border-default);">
                <div class="flex items-center justify-between">
                    <div>
                        <h1 class="text-2xl font-bold" style="color: var(--text-primary);">{{ tournament.name }}</h1>
                        <p class="mt-1 text-sm" style="color: var(--text-muted);">
                            Organise par {{ tournament.organizer.pseudo }} ({{ tournament.organizer.email }})
                        </p>
                    </div>
                    <div class="flex items-center space-x-4">
                        {% if tournament.status.value == 'ongoing' %}
                            <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-green-100 text-green-800">
                                En cours
                            </span>
                        {% elseif tournament.status.value == 'published' %}
                            <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-blue-100 text-blue-800">
                                Publie
                            </span>
                        {% elseif tournament.status.value == 'completed' %}
                            <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-gray-100 text-gray-800">
                                Termine
                            </span>
                        {% else %}
                            <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-gray-100 text-gray-800">
                                {{ tournament.status.value }}
                            </span>
                        {% endif %}
                        <a href="{{ path('admin_tournament_export', {id: tournament.id}) }}"
                           class="inline-flex items-center px-3 py-1 rounded-md text-sm font-medium" style="border: 1px solid var(--border-default); color: var(--text-secondary); background-color: var(--card-bg);">
                            {{ ux_icon('lucide:download', {class: 'h-4 w-4 mr-1'}) }}
                            Export JSON
                        </a>
                    </div>
                </div>
            </div>

            {# Configuration Details #}
            <div class="px-6 py-5">
                <h3 class="text-lg font-medium mb-4" style="color: var(--text-primary);">Configuration</h3>
                <dl class="grid grid-cols-1 md:grid-cols-4 gap-6">
                    <div>
                        <dt class="text-sm font-medium" style="color: var(--text-muted);">Date</dt>
                        <dd class="mt-1 text-sm" style="color: var(--text-primary);">
                            {{ tournament.date|date('d/m/Y') }}
                            {% if tournament.time %} a {{ tournament.time|date('H:i') }}{% endif %}
                        </dd>
                    </div>
                    <div>
                        <dt class="text-sm font-medium" style="color: var(--text-muted);">Format</dt>
                        <dd class="mt-1 text-sm" style="color: var(--text-primary);">{{ tournament.format.value|capitalize }}</dd>
                    </div>
                    <div>
                        <dt class="text-sm font-medium" style="color: var(--text-muted);">Structure</dt>
                        <dd class="mt-1 text-sm" style="color: var(--text-primary);">{{ tournament.structure.value|replace({'_': ' '})|capitalize }}</dd>
                    </div>
                    <div>
                        <dt class="text-sm font-medium" style="color: var(--text-muted);">Visibilite</dt>
                        <dd class="mt-1 text-sm" style="color: var(--text-primary);">{{ tournament.visibility.value|capitalize }}</dd>
                    </div>
                    <div>
                        <dt class="text-sm font-medium" style="color: var(--text-muted);">Joueurs</dt>
                        <dd class="mt-1 text-sm" style="color: var(--text-primary);">
                            {{ registrations|length }}{% if tournament.maxPlayers %} / {{ tournament.maxPlayers }}{% endif %}
                        </dd>
                    </div>
                    <div>
                        <dt class="text-sm font-medium" style="color: var(--text-muted);">Rondes</dt>
                        <dd class="mt-1 text-sm" style="color: var(--text-primary);">
                            {{ tournament.rounds|length }}{% if tournament.nbRounds %} / {{ tournament.nbRounds }}{% endif %}
                        </dd>
                    </div>
                    <div>
                        <dt class="text-sm font-medium" style="color: var(--text-muted);">Cree le</dt>
                        <dd class="mt-1 text-sm" style="color: var(--text-primary);">{{ tournament.createdAt|date('d/m/Y H:i') }}</dd>
                    </div>
                    <div>
                        <dt class="text-sm font-medium" style="color: var(--text-muted);">Litiges</dt>
                        <dd class="mt-1 text-sm {% if disputes|length > 0 %}text-red-600 font-medium{% endif %}" {% if disputes|length == 0 %}style="color: var(--text-primary);"{% endif %}>
                            {{ disputes|length }} en attente
                        </dd>
                    </div>
                </dl>
            </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-8">
            {# Disputes Section #}
            <div class="rounded-lg shadow" style="background-color: var(--card-bg);">
                <div class="px-6 py-4 flex items-center justify-between" style="border-bottom: 1px solid var(--border-default);">
                    <h2 class="text-lg font-medium" style="color: var(--text-primary);">Litiges en attente</h2>
                    {% if disputes|length > 0 %}
                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800">
                            {{ disputes|length }}
                        </span>
                    {% endif %}
                </div>

                {% if disputes is empty %}
                    <div class="px-6 py-8 text-center" style="color: var(--text-muted);">
                        Aucun litige en attente.
                    </div>
                {% else %}
                    <ul class="max-h-96 overflow-y-auto" style="border-color: var(--border-default);">
                        {% for match in disputes %}
                            <li class="px-6 py-4" style="border-bottom: 1px solid var(--border-default);">
                                <div class="flex items-center justify-between">
                                    <div>
                                        <p class="text-sm font-medium" style="color: var(--text-primary);">
                                            {{ match.player1.player.pseudo }} vs {{ match.player2.player.pseudo }}
                                        </p>
                                        <p class="text-xs" style="color: var(--text-muted);">
                                            Ronde {{ match.round.roundNumber }} - Table {{ match.tableNumber }}
                                        </p>
                                    </div>
                                    <a href="{{ path('admin_tournament_matches', {id: tournament.id}) }}"
                                       class="text-sm hover:underline" style="color: var(--color-primary-600);">
                                        Resoudre
                                    </a>
                                </div>
                            </li>
                        {% endfor %}
                    </ul>
                {% endif %}
            </div>

            {# Registrations Section #}
            <div class="rounded-lg shadow" style="background-color: var(--card-bg);">
                <div class="px-6 py-4" style="border-bottom: 1px solid var(--border-default);">
                    <h2 class="text-lg font-medium" style="color: var(--text-primary);">Joueurs inscrits ({{ registrations|length }})</h2>
                </div>

                {% if registrations is empty %}
                    <div class="px-6 py-8 text-center" style="color: var(--text-muted);">
                        Aucun joueur inscrit.
                    </div>
                {% else %}
                    <div class="max-h-96 overflow-y-auto">
                        <table class="min-w-full" style="border-collapse: separate; border-spacing: 0;">
                            <thead class="sticky top-0" style="background-color: var(--bg-subtle);">
                                <tr>
                                    <th scope="col" class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider" style="color: var(--text-muted);">
                                        Joueur
                                    </th>
                                    <th scope="col" class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider" style="color: var(--text-muted);">
                                        Inscrit le
                                    </th>
                                </tr>
                            </thead>
                            <tbody style="background-color: var(--card-bg);">
                                {% for registration in registrations %}
                                    <tr style="border-bottom: 1px solid var(--border-default);">
                                        <td class="px-6 py-3 whitespace-nowrap">
                                            <div class="text-sm font-medium" style="color: var(--text-primary);">
                                                {{ registration.player.pseudo }}
                                            </div>
                                            <div class="text-xs" style="color: var(--text-muted);">
                                                {{ registration.player.email }}
                                            </div>
                                        </td>
                                        <td class="px-6 py-3 whitespace-nowrap text-sm" style="color: var(--text-muted);">
                                            {{ registration.registeredAt|date('d/m/Y H:i') }}
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                {% endif %}
            </div>
        </div>

        {# Rounds & Matches Section #}
        {% if rounds is defined and rounds|length > 0 %}
            <div class="rounded-lg shadow" style="background-color: var(--card-bg);">
                <div class="px-6 py-4 flex items-center justify-between" style="border-bottom: 1px solid var(--border-default);">
                    <h2 class="text-lg font-medium" style="color: var(--text-primary);">Rondes et Matches</h2>
                    <a href="{{ path('admin_tournament_matches', {id: tournament.id}) }}"
                       class="text-sm hover:underline" style="color: var(--color-primary-600);">
                        Gerer les matches
                    </a>
                </div>

                <div class="p-6">
                    <div class="flex flex-wrap gap-2 mb-4">
                        {% for roundData in rounds %}
                            <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-gray-100 text-gray-800">
                                Ronde {{ roundData.round.roundNumber }}
                                <span class="ml-1 text-xs" style="color: var(--text-muted);">({{ roundData.matches|length }} matches)</span>
                            </span>
                        {% endfor %}
                    </div>
                    <p class="text-sm" style="color: var(--text-muted);">
                        Cliquez sur "Gerer les matches" pour voir les details et modifier les resultats.
                    </p>
                </div>
            </div>
        {% endif %}

        {# Quick Actions #}
        <div class="mt-8 rounded-lg shadow" style="background-color: var(--card-bg);">
            <div class="px-6 py-4" style="border-bottom: 1px solid var(--border-default);">
                <h2 class="text-lg font-medium" style="color: var(--text-primary);">Actions rapides</h2>
            </div>
            <div class="px-6 py-5 flex flex-wrap gap-4">
                <a href="{{ path('tournament_show', {id: tournament.id}) }}"
                   class="inline-flex items-center px-4 py-2 rounded-md shadow-sm text-sm font-medium" style="border: 1px solid var(--border-default); color: var(--text-secondary); background-color: var(--card-bg);"
                   target="_blank">
                    Voir le tournoi (public)
                </a>
                {% if tournament.status.value == 'ongoing' %}
                    <a href="{{ path('organizer_dashboard', {id: tournament.id}) }}"
                       class="inline-flex items-center px-4 py-2 rounded-md shadow-sm text-sm font-medium" style="border: 1px solid var(--border-default); color: var(--text-secondary); background-color: var(--card-bg);"
                       target="_blank">
                        Dashboard organisateur
                    </a>
                {% endif %}
                <a href="{{ path('admin_tournament_matches', {id: tournament.id}) }}"
                   class="inline-flex items-center px-4 py-2 rounded-md shadow-sm text-sm font-medium" style="border: 1px solid var(--border-default); color: var(--text-secondary); background-color: var(--card-bg);">
                    Gerer les matches
                </a>
            </div>
        </div>
    </div>
</div>
{% endblock %}
