{% extends 'admin/base.html.twig' %}

{% block title %}Gestion des utilisateurs - Administration{% endblock %}

{% block admin_content %}
<div class="py-8">
    <div class="container mx-auto px-4">
        <div class="mb-6">
            <h1 class="text-2xl font-bold" style="color: var(--text-primary);">Gestion des utilisateurs</h1>
            <p class="mt-1 text-sm" style="color: var(--text-muted);">{{ total }} utilisateur(s) au total</p>
        </div>

        {# Search and Filters #}
        <div class="rounded-lg shadow mb-6" style="background-color: var(--card-bg);">
            <div class="px-6 py-4">
                <form method="GET" action="{{ path('admin_users') }}" class="flex flex-wrap gap-4 items-end">
                    <div class="flex-1 min-w-64">
                        <label for="search" class="block text-sm font-medium mb-1" style="color: var(--text-secondary);">Recherche</label>
                        <input type="text"
                               id="search"
                               name="q"
                               value="{{ query }}"
                               placeholder="Email ou pseudo..."
                               class="form-input w-full rounded-md shadow-sm">
                    </div>

                    <div class="w-48">
                        <label for="role" class="block text-sm font-medium mb-1" style="color: var(--text-secondary);">Role</label>
                        <select id="role"
                                name="role"
                                class="form-input w-full rounded-md shadow-sm">
                            <option value="">Tous les roles</option>
                            <option value="ROLE_ADMIN" {% if role == 'ROLE_ADMIN' %}selected{% endif %}>Admin</option>
                            <option value="ROLE_ORGANIZER" {% if role == 'ROLE_ORGANIZER' %}selected{% endif %}>Organisateur</option>
                            <option value="ROLE_USER" {% if role == 'ROLE_USER' %}selected{% endif %}>Utilisateur</option>
                        </select>
                    </div>

                    <div>
                        <button type="submit"
                                class="px-4 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700 transition-colors">
                            Rechercher
                        </button>
                    </div>

                    {% if query or role %}
                        <div>
                            <a href="{{ path('admin_users') }}"
                               class="px-4 py-2 border rounded-md hover:opacity-80 inline-block"
                               style="border-color: var(--border-default); color: var(--text-secondary); background-color: var(--card-bg);">
                                Reinitialiser
                            </a>
                        </div>
                    {% endif %}
                </form>
            </div>
        </div>

        {# Users Table #}
        <div class="rounded-lg shadow overflow-hidden" style="background-color: var(--card-bg);">
            {% if users is empty %}
                <div class="px-6 py-8 text-center" style="color: var(--text-muted);">
                    Aucun utilisateur trouve.
                </div>
            {% else %}
                <div class="overflow-x-auto">
                    <table class="min-w-full divide-y" style="--tw-divide-opacity: 1; border-color: var(--border-default);">
                        <thead style="background-color: var(--bg-subtle);">
                            <tr>
                                <th scope="col" class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider" style="color: var(--text-muted);">
                                    ID
                                </th>
                                <th scope="col" class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider" style="color: var(--text-muted);">
                                    Pseudo
                                </th>
                                <th scope="col" class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider" style="color: var(--text-muted);">
                                    Email
                                </th>
                                <th scope="col" class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider" style="color: var(--text-muted);">
                                    Roles
                                </th>
                                <th scope="col" class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider" style="color: var(--text-muted);">
                                    Litiges
                                </th>
                                <th scope="col" class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider" style="color: var(--text-muted);">
                                    Inscrit le
                                </th>
                                <th scope="col" class="px-6 py-3 text-right text-xs font-medium uppercase tracking-wider" style="color: var(--text-muted);">
                                    Actions
                                </th>
                            </tr>
                        </thead>
                        <tbody class="divide-y" style="background-color: var(--card-bg); border-color: var(--border-default);">
                            {% for user in users %}
                                <tr class="hover:opacity-90" style="transition: background-color 0.15s;">
                                    <td class="px-6 py-4 whitespace-nowrap text-sm" style="color: var(--text-muted);">
                                        {{ user.id }}
                                    </td>
                                    <td class="px-6 py-4 whitespace-nowrap">
                                        <div class="flex items-center">
                                            <div class="text-sm font-medium" style="color: var(--text-primary);">
                                                {{ user.pseudo }}
                                            </div>
                                            {% if not user.isVerified %}
                                                <span class="ml-2 inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-yellow-100 text-yellow-800">
                                                    Non verifie
                                                </span>
                                            {% endif %}
                                        </div>
                                    </td>
                                    <td class="px-6 py-4 whitespace-nowrap text-sm" style="color: var(--text-muted);">
                                        {{ user.email }}
                                    </td>
                                    <td class="px-6 py-4 whitespace-nowrap">
                                        <div class="flex flex-wrap gap-1">
                                            {% for role in user.roles %}
                                                {% if role == 'ROLE_ADMIN' %}
                                                    <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-red-100 text-red-800">
                                                        Admin
                                                    </span>
                                                {% elseif role == 'ROLE_ORGANIZER' %}
                                                    <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-blue-100 text-blue-800">
                                                        Organisateur
                                                    </span>
                                                {% elseif role == 'ROLE_USER' %}
                                                    <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium" style="background-color: var(--bg-subtle); color: var(--text-secondary);">
                                                        Utilisateur
                                                    </span>
                                                {% else %}
                                                    <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium" style="background-color: var(--bg-subtle); color: var(--text-secondary);">
                                                        {{ role }}
                                                    </span>
                                                {% endif %}
                                            {% endfor %}
                                        </div>
                                    </td>
                                    <td class="px-6 py-4 whitespace-nowrap">
                                        {% set disputeCount = disputeCounts[user.id] ?? 0 %}
                                        {% if disputeCount > 2 %}
                                            <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-red-100 text-red-800">
                                                {{ disputeCount }}
                                            </span>
                                        {% elseif disputeCount > 0 %}
                                            <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-yellow-100 text-yellow-800">
                                                {{ disputeCount }}
                                            </span>
                                        {% else %}
                                            <span class="text-sm" style="color: var(--text-muted);">0</span>
                                        {% endif %}
                                    </td>
                                    <td class="px-6 py-4 whitespace-nowrap text-sm" style="color: var(--text-muted);">
                                        {{ user.createdAt|date('d/m/Y') }}
                                    </td>
                                    <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                                        <a href="{{ path('admin_user_view', {id: user.id}) }}"
                                           class="hover:underline mr-3" style="color: var(--color-primary-600);">
                                            Voir
                                        </a>
                                        <a href="{{ path('admin_user_edit', {id: user.id}) }}"
                                           class="text-green-600 hover:text-green-900">
                                            Modifier
                                        </a>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>

                {# Pagination #}
                {% if totalPages > 1 %}
                    <div class="px-6 py-4 border-t" style="border-color: var(--border-default);">
                        <div class="flex items-center justify-between">
                            <div class="text-sm" style="color: var(--text-secondary);">
                                Page {{ page }} sur {{ totalPages }}
                            </div>
                            <div class="flex space-x-2">
                                {% if page > 1 %}
                                    <a href="{{ path('admin_users', {q: query, role: role, page: page - 1}) }}"
                                       class="px-3 py-1 border rounded-md text-sm hover:opacity-80"
                                       style="border-color: var(--border-default); color: var(--text-secondary); background-color: var(--card-bg);">
                                        Precedent
                                    </a>
                                {% endif %}

                                {% for p in range(max(1, page - 2), min(totalPages, page + 2)) %}
                                    {% if p == page %}
                                        <span class="px-3 py-1 bg-blue-600 text-white rounded-md text-sm">{{ p }}</span>
                                    {% else %}
                                        <a href="{{ path('admin_users', {q: query, role: role, page: p}) }}"
                                           class="px-3 py-1 border rounded-md text-sm hover:opacity-80"
                                           style="border-color: var(--border-default); color: var(--text-secondary); background-color: var(--card-bg);">
                                            {{ p }}
                                        </a>
                                    {% endif %}
                                {% endfor %}

                                {% if page < totalPages %}
                                    <a href="{{ path('admin_users', {q: query, role: role, page: page + 1}) }}"
                                       class="px-3 py-1 border rounded-md text-sm hover:opacity-80"
                                       style="border-color: var(--border-default); color: var(--text-secondary); background-color: var(--card-bg);">
                                        Suivant
                                    </a>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                {% endif %}
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}
