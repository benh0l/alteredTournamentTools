{% extends 'admin/base.html.twig' %}

{% block title %}Historique des messages - Administration{% endblock %}

{% block admin_content %}
<div class="py-8">
    <div class="container mx-auto px-4">
        <div class="flex items-center justify-between mb-8">
            <h1 class="text-3xl font-bold" style="color: var(--text-primary);">Historique des messages</h1>
            <a href="{{ path('admin_messaging') }}"
               class="inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-blue-600 hover:bg-blue-700">
                {{ ux_icon('lucide:plus', {class: 'h-4 w-4 mr-2'}) }}
                Nouveau message
            </a>
        </div>

        <div class="rounded-lg shadow overflow-hidden" style="background-color: var(--card-bg);">
            {% if messages is empty %}
                <div class="px-6 py-12 text-center" style="color: var(--text-muted);">
                    Aucun message envoye.
                </div>
            {% else %}
                <div class="overflow-x-auto">
                    <table class="min-w-full" style="border-collapse: separate; border-spacing: 0;">
                        <thead style="background-color: var(--bg-subtle);">
                            <tr>
                                <th scope="col" class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider" style="color: var(--text-muted);">
                                    Date
                                </th>
                                <th scope="col" class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider" style="color: var(--text-muted);">
                                    Sujet
                                </th>
                                <th scope="col" class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider" style="color: var(--text-muted);">
                                    Destinataire(s)
                                </th>
                                <th scope="col" class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider" style="color: var(--text-muted);">
                                    Expediteur
                                </th>
                                <th scope="col" class="px-6 py-3 text-right text-xs font-medium uppercase tracking-wider" style="color: var(--text-muted);">
                                    Actions
                                </th>
                            </tr>
                        </thead>
                        <tbody style="background-color: var(--card-bg);">
                            {% for message in messages %}
                                <tr style="border-bottom: 1px solid var(--border-default);">
                                    <td class="px-6 py-4 whitespace-nowrap text-sm" style="color: var(--text-muted);">
                                        {{ message.sentAt|date('d/m/Y H:i') }}
                                    </td>
                                    <td class="px-6 py-4">
                                        <div class="text-sm font-medium" style="color: var(--text-primary);">
                                            {{ message.subject }}
                                        </div>
                                    </td>
                                    <td class="px-6 py-4 whitespace-nowrap">
                                        {% if message.toAllOrganizers %}
                                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-purple-100 text-purple-800">
                                                Tous ({{ message.recipientCount }})
                                            </span>
                                        {% else %}
                                            <span class="text-sm" style="color: var(--text-primary);">
                                                {{ message.recipientUser.pseudo }}
                                            </span>
                                        {% endif %}
                                    </td>
                                    <td class="px-6 py-4 whitespace-nowrap text-sm" style="color: var(--text-muted);">
                                        {{ message.sender.pseudo }}
                                    </td>
                                    <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                                        <a href="{{ path('admin_messaging_view', {id: message.id}) }}"
                                           class="hover:underline" style="color: var(--color-primary-600);">
                                            Voir
                                        </a>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>

                {# Pagination #}
                {% if pagination.totalPages > 1 %}
                    <div class="px-6 py-4 flex justify-center" style="border-top: 1px solid var(--border-default);">
                        <nav class="relative z-0 inline-flex rounded-md shadow-sm -space-x-px">
                            {% if pagination.current > 1 %}
                                <a href="{{ path('admin_messaging_history', {page: pagination.current - 1}) }}"
                                   class="relative inline-flex items-center px-2 py-2 rounded-l-md text-sm font-medium" style="border: 1px solid var(--border-default); background-color: var(--card-bg); color: var(--text-muted);">
                                    Precedent
                                </a>
                            {% endif %}

                            {% for i in max(1, pagination.current - 2)..min(pagination.totalPages, pagination.current + 2) %}
                                <a href="{{ path('admin_messaging_history', {page: i}) }}"
                                   class="relative inline-flex items-center px-4 py-2 text-sm font-medium {% if i == pagination.current %}bg-blue-50 text-blue-600 z-10{% endif %}" style="border: 1px solid var(--border-default); {% if i != pagination.current %}background-color: var(--card-bg); color: var(--text-secondary);{% endif %}">
                                    {{ i }}
                                </a>
                            {% endfor %}

                            {% if pagination.current < pagination.totalPages %}
                                <a href="{{ path('admin_messaging_history', {page: pagination.current + 1}) }}"
                                   class="relative inline-flex items-center px-2 py-2 rounded-r-md text-sm font-medium" style="border: 1px solid var(--border-default); background-color: var(--card-bg); color: var(--text-muted);">
                                    Suivant
                                </a>
                            {% endif %}
                        </nav>
                    </div>
                {% endif %}
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}
