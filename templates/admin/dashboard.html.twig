{% extends 'admin/base.html.twig' %}

{% block title %}Tableau de bord - Administration{% endblock %}

{% macro tournament_table(tournaments, emptyMessage) %}
    {% if tournaments is empty %}
        <div class="px-6 py-12 text-center" style="color: var(--text-muted);">
            {{ emptyMessage }}
        </div>
    {% else %}
        <div class="overflow-x-auto">
            <table class="min-w-full divide-y" style="border-color: var(--border-default);">
                <thead style="background-color: var(--bg-subtle);">
                    <tr>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider" style="color: var(--text-muted);">
                            Tournoi
                        </th>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider" style="color: var(--text-muted);">
                            Organisateur
                        </th>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider" style="color: var(--text-muted);">
                            Joueurs
                        </th>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider" style="color: var(--text-muted);">
                            Ronde
                        </th>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider" style="color: var(--text-muted);">
                            Statut
                        </th>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider" style="color: var(--text-muted);">
                            Date
                        </th>
                        <th scope="col" class="px-6 py-3 text-right text-xs font-medium uppercase tracking-wider" style="color: var(--text-muted);">
                            Actions
                        </th>
                    </tr>
                </thead>
                <tbody class="divide-y" style="background-color: var(--card-bg); border-color: var(--border-default);">
                    {% for data in tournaments %}
                        {% set tournament = data.tournament %}
                        <tr data-tournament-id="{{ tournament.id }}">
                            <td class="px-6 py-4 whitespace-nowrap">
                                <div class="flex items-center gap-2">
                                    <div class="text-sm font-medium" style="color: var(--text-primary);">
                                        {{ tournament.name }}
                                    </div>
                                    {% if tournament.visibility.value == 'private' %}
                                        <span class="inline-flex items-center px-1.5 py-0.5 rounded text-xs font-medium bg-gray-200 text-gray-700" title="Tournoi privé">
                                            🔒
                                        </span>
                                    {% endif %}
                                </div>
                                <div class="text-xs" style="color: var(--text-muted);">
                                    {{ tournament.format.value|capitalize }}
                                </div>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                <div class="text-sm" style="color: var(--text-primary);">
                                    {{ tournament.organizer.pseudo }}
                                </div>
                                <div class="text-xs" style="color: var(--text-muted);">
                                    {{ tournament.organizer.email }}
                                </div>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm" style="color: var(--text-primary);">
                                {{ data.playerCount }}{% if tournament.maxPlayers %} / {{ tournament.maxPlayers }}{% endif %}
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm" style="color: var(--text-primary);">
                                {% if data.currentRound %}
                                    Ronde {{ data.currentRound }}{% if tournament.swissRounds %} / {{ tournament.swissRounds }}{% endif %}
                                {% else %}
                                    -
                                {% endif %}
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                {% if tournament.status.value == 'ongoing' %}
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
                                        En cours
                                    </span>
                                {% elseif tournament.status.value == 'published' %}
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                                        Publié
                                    </span>
                                {% elseif tournament.status.value == 'draft' %}
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-800">
                                        Brouillon
                                    </span>
                                {% elseif tournament.status.value == 'completed' %}
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-purple-100 text-purple-800">
                                        Terminé
                                    </span>
                                {% elseif tournament.status.value == 'cancelled' %}
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800">
                                        Annulé
                                    </span>
                                {% else %}
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium" style="background-color: var(--bg-muted); color: var(--text-secondary);">
                                        {{ tournament.status.value }}
                                    </span>
                                {% endif %}
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm" style="color: var(--text-muted);">
                                {{ tournament.date|date('d/m/Y') }}
                                {% if tournament.time %}
                                    {{ tournament.time|date('H:i') }}
                                {% endif %}
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                                <a href="{{ path('admin_tournament_details', {id: tournament.id}) }}"
                                   class="hover:underline" style="color: var(--color-primary-600);">
                                    Détails
                                </a>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
{% endmacro %}

{% block admin_content %}
<div class="py-8"
     data-controller="admin-dashboard"
     data-admin-dashboard-mercure-url-value="{{ mercure('*')|escape('html_attr') }}">

    <div class="container mx-auto px-4">
        <h1 class="text-3xl font-bold mb-8" style="color: var(--text-primary);">Tableau de bord administrateur</h1>

        {# Stats Cards #}
        <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-8">
            {# Active Tournaments #}
            <div class="rounded-2xl shadow p-6" style="background-color: var(--card-bg);">
                <div class="flex items-center">
                    <div class="flex-shrink-0 bg-blue-500 rounded-xl p-3">
                        {{ ux_icon('lucide:trophy', {class: 'h-6 w-6 text-white'}) }}
                    </div>
                    <div class="ml-5">
                        <p class="text-sm font-medium" style="color: var(--text-muted);">Tournois actifs</p>
                        <p class="text-2xl font-semibold" style="color: var(--text-primary);" data-admin-dashboard-target="activeTournaments">
                            {{ stats.totalActive }}
                        </p>
                        <p class="text-xs" style="color: var(--text-muted);">{{ stats.ongoing }} en cours, {{ stats.published }} ouverts</p>
                    </div>
                </div>
            </div>

            {# Total Players #}
            <div class="rounded-2xl shadow p-6" style="background-color: var(--card-bg);">
                <div class="flex items-center">
                    <div class="flex-shrink-0 bg-green-500 rounded-xl p-3">
                        {{ ux_icon('lucide:users', {class: 'h-6 w-6 text-white'}) }}
                    </div>
                    <div class="ml-5">
                        <p class="text-sm font-medium" style="color: var(--text-muted);">Joueurs inscrits</p>
                        <p class="text-2xl font-semibold" style="color: var(--text-primary);" data-admin-dashboard-target="totalPlayers">
                            {{ stats.totalPlayers }}
                        </p>
                        <p class="text-xs" style="color: var(--text-muted);">dans les tournois actifs</p>
                    </div>
                </div>
            </div>

            {# Total Tournaments #}
            <div class="rounded-2xl shadow p-6" style="background-color: var(--card-bg);">
                <div class="flex items-center">
                    <div class="flex-shrink-0 bg-purple-500 rounded-xl p-3">
                        {{ ux_icon('lucide:database', {class: 'h-6 w-6 text-white'}) }}
                    </div>
                    <div class="ml-5">
                        <p class="text-sm font-medium" style="color: var(--text-muted);">Total tournois</p>
                        <p class="text-2xl font-semibold" style="color: var(--text-primary);">
                            {{ stats.totalAll }}
                        </p>
                        <p class="text-xs" style="color: var(--text-muted);">{{ stats.drafts }} brouillons, {{ stats.finished }} terminés</p>
                    </div>
                </div>
            </div>

            {# Pending Disputes #}
            <div class="rounded-2xl shadow p-6" style="background-color: var(--card-bg);">
                <div class="flex items-center">
                    <div class="flex-shrink-0 {% if stats.pendingDisputes > 0 %}bg-red-500{% else %}bg-gray-400{% endif %} rounded-xl p-3">
                        {{ ux_icon('lucide:alert-triangle', {class: 'h-6 w-6 text-white'}) }}
                    </div>
                    <div class="ml-5">
                        <p class="text-sm font-medium" style="color: var(--text-muted);">Litiges en attente</p>
                        <p class="text-2xl font-semibold {% if stats.pendingDisputes > 0 %}text-red-600{% endif %}"
                           style="{% if stats.pendingDisputes == 0 %}color: var(--text-primary);{% endif %}"
                           data-admin-dashboard-target="pendingDisputes">
                            {{ stats.pendingDisputes }}
                        </p>
                        <p class="text-xs" style="color: var(--text-muted);">à résoudre</p>
                    </div>
                </div>
            </div>
        </div>

        {# Tournament List with Tabs #}
        <div class="rounded-2xl shadow overflow-hidden" style="background-color: var(--card-bg);">
            {# Tab Navigation #}
            <div class="px-6 py-4 border-b flex items-center gap-1" style="border-color: var(--border-default);">
                <button type="button"
                        class="tab-btn px-4 py-2 rounded-lg text-sm font-medium transition-colors"
                        data-tab="active"
                        onclick="switchTab('active')"
                        style="background-color: var(--color-primary-100); color: var(--color-primary-700);">
                    Actifs ({{ stats.totalActive }})
                </button>
                <button type="button"
                        class="tab-btn px-4 py-2 rounded-lg text-sm font-medium transition-colors"
                        data-tab="drafts"
                        onclick="switchTab('drafts')"
                        style="color: var(--text-muted);">
                    Brouillons ({{ stats.drafts }})
                </button>
                <button type="button"
                        class="tab-btn px-4 py-2 rounded-lg text-sm font-medium transition-colors"
                        data-tab="finished"
                        onclick="switchTab('finished')"
                        style="color: var(--text-muted);">
                    Terminés ({{ stats.finished }})
                </button>
                <button type="button"
                        class="tab-btn px-4 py-2 rounded-lg text-sm font-medium transition-colors"
                        data-tab="all"
                        onclick="switchTab('all')"
                        style="color: var(--text-muted);">
                    Tous ({{ stats.totalAll }})
                </button>
            </div>

            {# Tab Panels #}
            <div id="tab-active" class="tab-panel" data-admin-dashboard-target="tournamentList">
                {{ _self.tournament_table(tournaments.active, 'Aucun tournoi actif pour le moment.') }}
            </div>

            <div id="tab-drafts" class="tab-panel hidden">
                {{ _self.tournament_table(tournaments.drafts, 'Aucun brouillon de tournoi.') }}
            </div>

            <div id="tab-finished" class="tab-panel hidden">
                {{ _self.tournament_table(tournaments.finished, 'Aucun tournoi terminé.') }}
            </div>

            <div id="tab-all" class="tab-panel hidden">
                {{ _self.tournament_table(tournaments.all, 'Aucun tournoi dans la base de données.') }}
            </div>
        </div>
    </div>
</div>

<script>
function switchTab(tabName) {
    // Hide all panels
    document.querySelectorAll('.tab-panel').forEach(panel => {
        panel.classList.add('hidden');
    });

    // Show selected panel
    document.getElementById('tab-' + tabName).classList.remove('hidden');

    // Update button styles
    document.querySelectorAll('.tab-btn').forEach(btn => {
        if (btn.dataset.tab === tabName) {
            btn.style.backgroundColor = 'var(--color-primary-100)';
            btn.style.color = 'var(--color-primary-700)';
        } else {
            btn.style.backgroundColor = 'transparent';
            btn.style.color = 'var(--text-muted)';
        }
    });
}
</script>
{% endblock %}
