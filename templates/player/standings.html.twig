{% extends 'base.html.twig' %}

{% block title %}Classement - {{ tournament.name }}{% endblock %}

{% block body %}
<div class="max-w-4xl mx-auto">
    {# Header #}
    <div class="mb-6">
        <div class="flex items-center justify-between">
            <div>
                <h1 class="text-2xl font-bold" style="color: var(--text-primary);">{{ tournament.name }}</h1>
                <p style="color: var(--text-secondary);">Classement en direct</p>
            </div>
            <a href="{{ path('tournament_show', {id: tournament.id}) }}" class="font-medium hover:underline" style="color: var(--color-primary-600);">
                &larr; Retour
            </a>
        </div>
    </div>

    {# Navigation tabs #}
    <div class="mb-6 border-b" style="border-color: var(--border-default);">
        <nav class="flex space-x-4 md:space-x-8 overflow-x-auto pb-2">
            <a href="{{ path('tournament_pairings', {id: tournament.id}) }}"
               class="py-2 px-1 border-b-2 border-transparent hover:border-gray-300" style="color: var(--text-muted);">
                Pairings
            </a>
            <a href="{{ path('tournament_standings', {id: tournament.id}) }}"
               class="py-2 px-1 border-b-2 font-medium" style="color: var(--color-primary-600); border-color: var(--color-primary-600);">
                Classement
            </a>
            <a href="{{ path('tournament_results', {id: tournament.id}) }}"
               class="py-2 px-1 border-b-2 border-transparent hover:border-gray-300" style="color: var(--text-muted);">
                Resultats
            </a>
        </nav>
    </div>

    {# Standings info #}
    <div class="rounded-lg p-4 mb-6 border" style="background-color: var(--bg-subtle); border-color: var(--border-default);">
        <div class="flex justify-between items-center">
            <div>
                <p class="text-sm" style="color: var(--text-secondary);">
                    {{ standings|length }} joueur{% if standings|length > 1 %}s{% endif %}
                </p>
            </div>
            <div class="text-right">
                <p class="text-xs" style="color: var(--text-muted);" id="last-update">
                    Mis a jour: {{ 'now'|date('H:i:s') }}
                </p>
            </div>
        </div>
    </div>

    {# Standings table #}
    <div class="rounded-lg shadow overflow-hidden" style="background-color: var(--card-bg);" id="standings-table">
        <div class="overflow-x-auto">
            <table class="min-w-full divide-y" style="--tw-divide-opacity: 1; border-color: var(--border-default);">
                <thead style="background-color: var(--bg-subtle);">
                <tr>
                    <th class="px-4 py-3 text-left text-xs font-medium uppercase" style="color: var(--text-muted);">Rang</th>
                    <th class="px-4 py-3 text-left text-xs font-medium uppercase" style="color: var(--text-muted);">Joueur</th>
                    <th class="px-4 py-3 text-center text-xs font-medium uppercase" style="color: var(--text-muted);">Heros</th>
                    <th class="px-4 py-3 text-center text-xs font-medium uppercase" style="color: var(--text-muted);">V</th>
                    <th class="px-4 py-3 text-center text-xs font-medium uppercase" style="color: var(--text-muted);">D</th>
                    <th class="px-4 py-3 text-center text-xs font-medium uppercase" style="color: var(--text-muted);">Points</th>
                    <th class="px-4 py-3 text-center text-xs font-medium uppercase" style="color: var(--text-muted);">OMW%</th>
                </tr>
            </thead>
            <tbody class="divide-y" style="background-color: var(--card-bg); border-color: var(--border-default);">
                {% for entry in standings %}
                    {% set isMe = player_registration and entry.registration.id == player_registration.id %}
                    <tr class="{% if isMe %}border-l-4{% endif %} {% if loop.index <= 3 %}font-medium{% endif %}"
                        style="{% if isMe %}background-color: var(--color-primary-50); border-left-color: var(--color-primary-500);{% endif %}">
                        <td class="px-4 py-3 whitespace-nowrap text-sm">
                            {% if loop.index == 1 %}
                                <span class="text-yellow-500 font-bold">1</span>
                            {% elseif loop.index == 2 %}
                                <span class="text-gray-400 font-bold">2</span>
                            {% elseif loop.index == 3 %}
                                <span class="text-amber-600 font-bold">3</span>
                            {% else %}
                                <span style="color: var(--text-secondary);">{{ loop.index }}</span>
                            {% endif %}
                        </td>
                        <td class="px-4 py-3 whitespace-nowrap text-sm" style="color: var(--text-primary);">
                            {{ entry.registration.player.displayName }}
                            {% if isMe %}
                                <span style="color: var(--color-primary-600);">(vous)</span>
                            {% endif %}
                        </td>
                        <td class="px-4 py-3 whitespace-nowrap text-sm text-center">
                            {% if entry.registration.hero %}
                                <div class="flex flex-col items-center">
                                    <div class="w-10 h-10 rounded-full overflow-hidden border-2 mb-1" style="border-color: {{ entry.registration.faction ? entry.registration.faction.color : 'var(--border-muted)' }};">
                                        <img src="{{ entry.registration.heroImage }}" alt="{{ entry.registration.heroLabel }}" class="w-full h-full object-cover" onerror="this.parentElement.innerHTML='<div class=\'w-full h-full flex items-center justify-center bg-gray-200\'><span class=\'text-xs text-gray-500\'>?</span></div>'">
                                    </div>
                                    <span class="text-xs" style="color: var(--text-muted);">{{ entry.registration.heroLabel }}</span>
                                </div>
                            {% else %}
                                <span class="text-xs" style="color: var(--text-muted);">-</span>
                            {% endif %}
                        </td>
                        <td class="px-4 py-3 whitespace-nowrap text-sm text-center text-green-600 font-medium">
                            {{ entry.wins }}
                        </td>
                        <td class="px-4 py-3 whitespace-nowrap text-sm text-center text-red-600">
                            {{ entry.losses }}
                        </td>
                        <td class="px-4 py-3 whitespace-nowrap text-sm text-center font-bold" style="color: var(--text-primary);">
                            {{ entry.matchPoints }}
                        </td>
                        <td class="px-4 py-3 whitespace-nowrap text-sm text-center" style="color: var(--text-muted);">
                            {{ (entry.opponentMatchWinPercentage * 100)|number_format(1) }}%
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="7" class="px-4 py-8 text-center" style="color: var(--text-muted);">
                            Le classement sera disponible apres la premiere ronde.
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    {# Legend #}
    <div class="mt-4 text-xs" style="color: var(--text-muted);">
        <p>V = Victoires | D = Defaites | Points = Points de match (3 par victoire) | OMW% = Pourcentage de victoires des adversaires</p>
    </div>
</div>

{# SSE for live updates (FR53) #}
{% if tournament.ongoing %}
{% block javascripts %}
    {{ parent() }}
    <script>
        (function() {
            let pollingInterval = null;

            function init() {
                const tournamentId = {{ tournament.id }};

                function updateLastUpdate() {
                    const el = document.getElementById('last-update');
                    if (el) {
                        const now = new Date();
                        el.textContent = 'Mis a jour: ' +
                            String(now.getHours()).padStart(2, '0') + ':' +
                            String(now.getMinutes()).padStart(2, '0') + ':' +
                            String(now.getSeconds()).padStart(2, '0');
                    }
                }

                function pollForUpdates() {
                    fetch('/api/dashboard/' + tournamentId + '/state')
                        .then(response => response.json())
                        .then(data => {
                            updateLastUpdate();
                        })
                        .catch(error => console.error('Polling error:', error));
                }

                // Clear any existing interval before starting new one
                if (pollingInterval) {
                    clearInterval(pollingInterval);
                }

                // Start polling every 30 seconds for live standings
                pollingInterval = setInterval(pollForUpdates, 30000);
            }

            function cleanup() {
                if (pollingInterval) {
                    clearInterval(pollingInterval);
                    pollingInterval = null;
                }
            }

            // Cleanup on Turbo navigation
            document.addEventListener('turbo:before-visit', cleanup);
            document.addEventListener('turbo:before-render', cleanup);
            window.addEventListener('beforeunload', cleanup);

            // Initialize
            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', init);
            } else {
                init();
            }
        })();
    </script>
{% endblock %}
{% endif %}
{% endblock %}
