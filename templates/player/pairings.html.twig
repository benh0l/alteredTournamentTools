{% extends 'base.html.twig' %}

{% block title %}Pairings - {{ tournament.name }}{% endblock %}

{% block body %}
<div class="max-w-4xl mx-auto">
    {# Header #}
    <div class="mb-6">
        <div class="flex items-center justify-between">
            <div>
                <h1 class="text-2xl font-bold" style="color: var(--text-primary);">{{ tournament.name }}</h1>
                <p style="color: var(--text-secondary);">Pairings</p>
            </div>
            <a href="{{ path('tournament_show', {id: tournament.id}) }}" class="font-medium hover:underline" style="color: var(--color-primary-600);">
                &larr; Retour
            </a>
        </div>
    </div>

    {# Navigation tabs #}
    <div class="mb-6 border-b" style="border-color: var(--border-default);">
        <nav class="flex space-x-4 md:space-x-8 overflow-x-auto pb-2">
            <a href="{{ path('tournament_pairings', {id: tournament.id}) }}"
               class="py-2 px-1 border-b-2 font-medium" style="color: var(--color-primary-600); border-color: var(--color-primary-600);">
                Pairings
            </a>
            <a href="{{ path('tournament_standings', {id: tournament.id}) }}"
               class="py-2 px-1 border-b-2 border-transparent hover:border-gray-300" style="color: var(--text-muted);">
                Classement
            </a>
            <a href="{{ path('tournament_results', {id: tournament.id}) }}"
               class="py-2 px-1 border-b-2 border-transparent hover:border-gray-300" style="color: var(--text-muted);">
                Resultats
            </a>
        </nav>
    </div>

    {% if current_round %}
        {# Round info #}
        <div class="rounded-lg p-4 mb-6 border" style="background-color: var(--color-primary-50); border-color: var(--color-primary-200);">
            <div class="flex justify-between items-center">
                <div>
                    <h2 class="text-lg font-semibold" style="color: var(--color-primary-900);">Ronde {{ current_round.roundNumber }}</h2>
                    <p class="text-sm" style="color: var(--color-primary-700);">
                        <span class="{{ current_round.status.badgeClasses }} px-2 py-1 rounded text-xs">
                            {{ current_round.status.label|trans }}
                        </span>
                    </p>
                </div>
                {% if current_round.startedAt %}
                    <div class="text-right">
                        <div id="round-timer"
                             class="text-2xl font-mono font-bold"
                             style="color: var(--color-primary-900);"
                             data-started-at="{{ current_round.startedAt.format('c') }}">
                            --:--
                        </div>
                        <p class="text-xs" style="color: var(--color-primary-600);">Temps ecoule</p>
                    </div>
                {% endif %}
            </div>
        </div>

        {# Pairings list #}
        <div class="rounded-lg shadow overflow-hidden" style="background-color: var(--card-bg);">
            <div class="overflow-x-auto">
                <table class="min-w-full divide-y" style="border-color: var(--border-default);">
                    <thead style="background-color: var(--bg-subtle);">
                    <tr>
                        <th class="px-4 py-3 text-left text-xs font-medium uppercase" style="color: var(--text-muted);">Table</th>
                        <th class="px-4 py-3 text-left text-xs font-medium uppercase" style="color: var(--text-muted);">Joueur 1</th>
                        <th class="px-4 py-3 text-center text-xs font-medium uppercase" style="color: var(--text-muted);">Score</th>
                        <th class="px-4 py-3 text-right text-xs font-medium uppercase" style="color: var(--text-muted);">Joueur 2</th>
                        <th class="px-4 py-3 text-center text-xs font-medium uppercase" style="color: var(--text-muted);">Statut</th>
                    </tr>
                </thead>
                <tbody class="divide-y" style="background-color: var(--card-bg); border-color: var(--border-default);">
                    {% for match in matches %}
                        {% set isMyMatch = player_registration and (
                            (match.player1 and match.player1.id == player_registration.id) or
                            (match.player2 and match.player2.id == player_registration.id)
                        ) %}
                        <tr class="{% if isMyMatch %}border-l-4{% endif %}"
                            style="{% if isMyMatch %}background-color: var(--color-primary-50); border-left-color: var(--color-primary-500);{% endif %}">
                            <td class="px-4 py-3 whitespace-nowrap text-sm font-medium" style="color: var(--text-primary);">
                                {{ match.tableNumber }}
                            </td>
                            <td class="px-4 py-3 whitespace-nowrap text-sm {% if match.winner and match.winner == match.player1 %}font-bold text-green-600{% endif %}" style="{% if not (match.winner and match.winner == match.player1) %}color: var(--text-primary);{% endif %}">
                                {{ match.player1.player.displayName }}
                                {% if isMyMatch and match.player1 and match.player1.id == player_registration.id %}
                                    <span style="color: var(--color-primary-600);">(vous)</span>
                                {% endif %}
                            </td>
                            <td class="px-4 py-3 whitespace-nowrap text-sm text-center" style="color: var(--text-primary);">
                                {% if match.completed %}
                                    <span class="font-medium">{{ match.player1Score ?? '-' }} - {{ match.player2Score ?? '-' }}</span>
                                {% elseif match.isByeMatch %}
                                    <span style="color: var(--text-muted);">BYE</span>
                                {% else %}
                                    <span style="color: var(--text-muted);">-</span>
                                {% endif %}
                            </td>
                            <td class="px-4 py-3 whitespace-nowrap text-sm text-right {% if match.winner and match.player2 and match.winner == match.player2 %}font-bold text-green-600{% endif %}" style="{% if not (match.winner and match.player2 and match.winner == match.player2) %}color: var(--text-primary);{% endif %}">
                                {% if match.player2 %}
                                    {{ match.player2.player.displayName }}
                                    {% if isMyMatch and match.player2.id == player_registration.id %}
                                        <span style="color: var(--color-primary-600);">(vous)</span>
                                    {% endif %}
                                {% else %}
                                    <span class="italic" style="color: var(--text-muted);">BYE</span>
                                {% endif %}
                            </td>
                            <td class="px-4 py-3 whitespace-nowrap text-center">
                                <span class="{{ match.status.badgeClasses }} px-2 py-1 rounded text-xs">
                                    {{ match.status.label|trans }}
                                </span>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="5" class="px-4 py-8 text-center" style="color: var(--text-muted);">
                                Aucun match dans cette ronde
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    {% else %}
        <div class="rounded-lg shadow p-8 text-center" style="background-color: var(--card-bg);">
            <p style="color: var(--text-secondary);">Aucune ronde en cours.</p>
            <p class="text-sm mt-2" style="color: var(--text-muted);">
                Les pairings s'afficheront ici lorsque l'organisateur demarrera la prochaine ronde.
            </p>
        </div>
    {% endif %}
</div>

{% endblock %}

{# Timer JavaScript #}
{% block javascripts %}
    {{ parent() }}
    {% if current_round and current_round.startedAt %}
    <script>
        (function() {
            let timerInterval = null;
            const abortController = new AbortController();

            function init() {
                const timerElement = document.getElementById('round-timer');
                if (!timerElement) return;

                const startedAt = timerElement.dataset.startedAt;
                if (!startedAt) return;

                const startTime = new Date(startedAt);
                const maxTimerMinutes = 90; // Timer stops at 90 minutes

                function updateTimer() {
                    const now = new Date();
                    let elapsed = Math.floor((now - startTime) / 1000);

                    // Cap at 90 minutes (5400 seconds)
                    const maxSeconds = maxTimerMinutes * 60;
                    if (elapsed > maxSeconds) {
                        elapsed = maxSeconds;
                    }

                    const minutes = Math.floor(elapsed / 60);
                    const seconds = elapsed % 60;

                    timerElement.textContent =
                        String(minutes).padStart(2, '0') + ':' +
                        String(seconds).padStart(2, '0');
                }

                // Clear any existing interval
                if (timerInterval) {
                    clearInterval(timerInterval);
                }

                updateTimer();
                timerInterval = setInterval(updateTimer, 1000);
            }

            function cleanup() {
                if (timerInterval) {
                    clearInterval(timerInterval);
                    timerInterval = null;
                }
                abortController.abort();
            }

            // Cleanup on Turbo navigation - AbortController removes listeners automatically
            document.addEventListener('turbo:before-visit', cleanup, { signal: abortController.signal });
            document.addEventListener('turbo:before-render', cleanup, { signal: abortController.signal });
            window.addEventListener('beforeunload', cleanup, { signal: abortController.signal });

            // Initialize
            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', init, { signal: abortController.signal });
            } else {
                init();
            }
        })();
    </script>
    {% endif %}
{% endblock %}
