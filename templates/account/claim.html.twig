{% extends 'base.html.twig' %}

{% block title %}{{ 'claim.title'|trans }}{% endblock %}

{% block body %}
<div class="min-h-screen flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8" style="background: linear-gradient(135deg, var(--bg-gradient-from), var(--bg-gradient-via), var(--bg-gradient-to));">
    <div class="max-w-md w-full space-y-8">
        {# Header #}
        <div class="text-center">
            <h1 class="text-3xl font-bold" style="color: var(--text-primary);">
                {{ 'claim.header'|trans }}
            </h1>
            <p class="mt-2" style="color: var(--text-muted);">
                {{ 'claim.description'|trans }}
            </p>
        </div>

        {# User Info Card #}
        <div class="rounded-xl p-6" style="background-color: var(--card-bg); border: 1px solid var(--card-border);">
            <div class="flex items-center space-x-4 mb-4">
                <div class="w-12 h-12 rounded-full flex items-center justify-center" style="background-color: var(--color-primary-100);">
                    {{ ux_icon('lucide:mail', {class: 'w-6 h-6', style: 'color: var(--color-primary-600);'}) }}
                </div>
                <div>
                    <div class="text-sm" style="color: var(--text-muted);">{{ 'claim.email_label'|trans }}</div>
                    <div class="font-medium" style="color: var(--text-primary);">{{ user.email }}</div>
                </div>
            </div>

            {% if registrations|length > 0 %}
                <div class="pt-4 border-t" style="border-color: var(--border-default);">
                    <div class="text-sm font-medium mb-2" style="color: var(--text-muted);">
                        {{ 'claim.tournaments_label'|trans }}
                    </div>
                    <div class="space-y-2">
                        {% for registration in registrations %}
                            <div class="flex items-center space-x-2">
                                {{ ux_icon('lucide:trophy', {class: 'w-4 h-4', style: 'color: var(--color-primary-500);'}) }}
                                <span style="color: var(--text-secondary);">{{ registration.tournament.name }}</span>
                            </div>
                        {% endfor %}
                    </div>
                </div>
            {% endif %}
        </div>

        {# Claim Form #}
        <div class="rounded-xl shadow-lg p-6" style="background-color: var(--card-bg); border: 1px solid var(--card-border);">
            <h2 class="text-lg font-bold mb-4" style="color: var(--text-primary);">
                {{ 'claim.form_title'|trans }}
            </h2>

            {{ form_start(form, {attr: {class: 'space-y-4'}}) }}

            {# Pseudo Field #}
            <div>
                <label for="{{ form.pseudo.vars.id }}" class="block text-sm font-medium mb-1" style="color: var(--text-secondary);">
                    {{ 'claim.pseudo_label'|trans }}
                </label>
                {{ form_widget(form.pseudo, {
                    attr: {
                        class: 'w-full px-4 py-3 rounded-lg border focus:outline-none focus:ring-2',
                        style: 'background-color: var(--bg-base); border-color: var(--border-default); color: var(--text-primary);',
                        placeholder: 'claim.pseudo_placeholder'|trans
                    }
                }) }}
                {{ form_errors(form.pseudo) }}
                <p class="mt-1 text-xs" style="color: var(--text-muted);">
                    {{ 'claim.pseudo_help'|trans }}
                </p>
            </div>

            {# Password Fields #}
            <div>
                <label for="{{ form.password.first.vars.id }}" class="block text-sm font-medium mb-1" style="color: var(--text-secondary);">
                    {{ 'claim.password_label'|trans }}
                </label>
                {{ form_widget(form.password.first, {
                    attr: {
                        class: 'w-full px-4 py-3 rounded-lg border focus:outline-none focus:ring-2',
                        style: 'background-color: var(--bg-base); border-color: var(--border-default); color: var(--text-primary);',
                        placeholder: 'claim.password_placeholder'|trans
                    }
                }) }}
                {{ form_errors(form.password.first) }}
            </div>

            <div>
                <label for="{{ form.password.second.vars.id }}" class="block text-sm font-medium mb-1" style="color: var(--text-secondary);">
                    {{ 'claim.confirm_password_label'|trans }}
                </label>
                {{ form_widget(form.password.second, {
                    attr: {
                        class: 'w-full px-4 py-3 rounded-lg border focus:outline-none focus:ring-2',
                        style: 'background-color: var(--bg-base); border-color: var(--border-default); color: var(--text-primary);',
                        placeholder: 'claim.confirm_password_placeholder'|trans
                    }
                }) }}
                {{ form_errors(form.password.second) }}
            </div>

            {# Submit Button #}
            <button type="submit"
                    class="w-full py-3 px-6 rounded-xl font-medium transition btn-primary">
                {{ ux_icon('lucide:check', {class: 'w-5 h-5 mr-2 inline'}) }}
                {{ 'claim.submit'|trans }}
            </button>

            {{ form_end(form) }}
        </div>

        {# Login Link #}
        <div class="text-center">
            <p class="text-sm" style="color: var(--text-muted);">
                {{ 'claim.already_have_account'|trans }}
                <a href="{{ path('app_login') }}" class="font-medium hover:opacity-80" style="color: var(--color-primary-600);">
                    {{ 'claim.login_link'|trans }}
                </a>
            </p>
        </div>
    </div>
</div>
{% endblock %}
