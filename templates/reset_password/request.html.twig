{% extends 'base.html.twig' %}

{% block title %}{{ 'auth.reset_password.request.page_title'|trans }}{% endblock %}

{% block body %}
<div class="min-h-screen py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-md mx-auto">
        {# Header #}
        <div class="text-center mb-8">
            <div class="inline-flex items-center justify-center w-16 h-16 rounded-2xl shadow-lg mb-4 theme-primary-gradient">
                {{ ux_icon('lucide:key-round', {class: 'w-8 h-8 text-white'}) }}
            </div>
            <h1 class="text-3xl font-bold" style="color: var(--text-primary);">{{ 'auth.reset_password.request.title'|trans }}</h1>
            <p class="mt-2" style="color: var(--text-secondary);">
                {{ 'auth.reset_password.request.subtitle'|trans }}
            </p>
        </div>

        {# Request Card #}
        <div class="rounded-2xl shadow-xl overflow-hidden" style="background-color: var(--card-bg);">
            <div class="p-8">
                <p class="text-center mb-6" style="color: var(--text-secondary);">
                    {{ 'auth.reset_password.request.instructions'|trans }}
                </p>

                {{ form_start(requestForm, {'attr': {'class': 'space-y-6', 'novalidate': 'novalidate'}}) }}
                    <div>
                        {{ form_label(requestForm.email, null, {
                            'label_attr': {'class': 'form-label'}
                        }) }}
                        <div class="relative">
                            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                                {{ ux_icon('lucide:mail', {class: 'w-5 h-5', style: 'color: var(--text-muted);'}) }}
                            </div>
                            {{ form_widget(requestForm.email, {
                                'attr': {'class': 'form-input w-full pl-10'}
                            }) }}
                        </div>
                        {{ form_errors(requestForm.email) }}
                    </div>

                    <div class="pt-2">
                        <button type="submit"
                                class="w-full flex items-center justify-center px-6 py-3 text-white font-semibold rounded-xl shadow-md hover:shadow-lg transition-all"
                                style="background: linear-gradient(135deg, var(--color-primary-500), var(--color-accent-500));">
                            {{ ux_icon('lucide:send', {class: 'w-5 h-5 mr-2'}) }}
                            {{ 'auth.reset_password.request.submit'|trans }}
                        </button>
                    </div>
                {{ form_end(requestForm) }}
            </div>
        </div>

        {# Back to login #}
        <div class="mt-6 text-center">
            <p style="color: var(--text-secondary);">
                {{ 'auth.reset_password.request.remember'|trans }}
                <a href="{{ path('app_login') }}" class="font-semibold" style="color: var(--color-primary-600);">
                    {{ 'auth.reset_password.request.back_to_login'|trans }}
                </a>
            </p>
        </div>
    </div>
</div>
{% endblock %}
