{# Timer JavaScript for current match #}
{% if current_match %}
{% block javascripts %}
    {{ parent() }}
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const timerElement = document.getElementById('match-timer');
            if (!timerElement) return;

            const startedAt = timerElement.dataset.startedAt;
            if (!startedAt) return;

            const startTime = new Date(startedAt);
            const maxTimerMinutes = 90; // Timer stops at 90 minutes

            function updateTimer() {
                const now = new Date();
                let elapsed = Math.floor((now - startTime) / 1000);

                // Cap at 90 minutes (5400 seconds)
                const maxSeconds = maxTimerMinutes * 60;
                if (elapsed > maxSeconds) {
                    elapsed = maxSeconds;
                }

                const minutes = Math.floor(elapsed / 60);
                const seconds = elapsed % 60;

                timerElement.textContent =
                    String(minutes).padStart(2, '0') + ':' +
                    String(seconds).padStart(2, '0');

                // Color coding
                timerElement.classList.remove('text-emerald-200', 'text-yellow-200', 'text-red-200');

                if (minutes < 35) {
                    timerElement.classList.add('text-emerald-200');
                } else if (minutes < 50) {
                    timerElement.classList.add('text-yellow-200');
                } else {
                    timerElement.classList.add('text-red-200');
                }
            }

            updateTimer();
            setInterval(updateTimer, 1000);
        });
    </script>
{% endblock %}
{% endif %}
