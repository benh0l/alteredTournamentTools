{% extends 'tournament/wizard/layout.html.twig' %}

{% block wizard_content %}
    <div class="text-center mb-8">
        <div class="inline-flex items-center justify-center w-12 h-12 rounded-xl mb-4" style="background-color: var(--color-primary-100);">
            {{ ux_icon('lucide:calendar', {class: 'w-6 h-6', style: 'color: var(--color-primary-600);'}) }}
        </div>
        <h2 class="text-2xl font-bold" style="color: var(--text-primary);">{{ 'tournament.wizard.step2.question'|trans }}</h2>
        <p class="mt-2" style="color: var(--text-muted);">{{ 'tournament.wizard.step2.subtitle'|trans }}</p>
    </div>

    {{ form_start(form, {attr: {id: 'wizard-form', class: 'space-y-6'}}) }}
        {# Date and Time #}
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
                <label for="{{ form.date.vars.id }}" class="block text-sm font-medium mb-2" style="color: var(--text-secondary);">
                    {{ ux_icon('lucide:calendar-days', {class: 'w-4 h-4 inline mr-1', style: 'color: var(--text-muted);'}) }}
                    {{ 'tournament.wizard.step2.date_label'|trans }}
                </label>
                {{ form_widget(form.date, {
                    'attr': {
                        'class': 'form-input w-full rounded-xl'
                    }
                }) }}
                {{ form_errors(form.date) }}
            </div>
            <div>
                <label for="{{ form.time.vars.id }}" class="block text-sm font-medium mb-2" style="color: var(--text-secondary);">
                    {{ ux_icon('lucide:clock', {class: 'w-4 h-4 inline mr-1', style: 'color: var(--text-muted);'}) }}
                    {{ 'tournament.wizard.step2.time_label'|trans }}
                </label>
                {{ form_widget(form.time, {
                    'attr': {
                        'class': 'form-input w-full rounded-xl'
                    }
                }) }}
                {{ form_errors(form.time) }}
            </div>
        </div>

        <hr style="border-color: var(--border-default);">

        {# Location with autocomplete #}
        <div data-controller="address-autocomplete">
            <label for="{{ form.location.vars.id }}" class="block text-sm font-medium mb-2" style="color: var(--text-secondary);">
                {{ ux_icon('lucide:map-pin', {class: 'w-4 h-4 inline mr-1', style: 'color: var(--text-muted);'}) }}
                {{ 'tournament.wizard.step2.location_label'|trans }}
            </label>
            <div class="relative">
                <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none z-10">
                    {{ ux_icon('lucide:building-2', {class: 'w-5 h-5', style: 'color: var(--text-muted);'}) }}
                </div>
                {{ form_widget(form.location, {
                    'attr': {
                        'class': 'form-input w-full pl-10 rounded-xl',
                        'placeholder': 'tournament.wizard.step2.location_placeholder'|trans,
                        'data-address-autocomplete-target': 'input',
                        'autocomplete': 'off'
                    }
                }) }}
            </div>
            {{ form_errors(form.location) }}
            {{ form_widget(form.latitude, {'attr': {'data-address-autocomplete-target': 'latitude'}}) }}
            {{ form_widget(form.longitude, {'attr': {'data-address-autocomplete-target': 'longitude'}}) }}
            <p class="text-xs mt-2" style="color: var(--text-muted);">
                {{ ux_icon('lucide:info', {class: 'w-3 h-3 inline mr-1'}) }}
                {{ 'tournament.wizard.step2.location_hint'|trans }}
            </p>
        </div>
    {{ form_end(form) }}
{% endblock %}
