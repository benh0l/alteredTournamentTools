{% extends 'tournament/wizard/layout.html.twig' %}

{% block wizard_content %}
    <div class="text-center mb-8">
        <div class="inline-flex items-center justify-center w-12 h-12 rounded-xl mb-4" style="background-color: var(--color-primary-100);">
            {{ ux_icon('lucide:git-branch', {class: 'w-6 h-6', style: 'color: var(--color-primary-600);'}) }}
        </div>
        <h2 class="text-2xl font-bold" style="color: var(--text-primary);">{{ 'tournament.wizard.step4.question'|trans }}</h2>
        <p class="mt-2" style="color: var(--text-muted);">{{ 'tournament.wizard.step4.subtitle'|trans }}</p>
    </div>

    {{ form_start(form, {attr: {id: 'wizard-form', class: 'space-y-4'}}) }}
        <div class="grid grid-cols-1 gap-4">
            {% for child in form.structure %}
                <label class="cursor-pointer group" data-action="click->wizard#selectCard">
                    {{ form_widget(child, {attr: {class: 'sr-only peer', style: 'accent-color: var(--color-primary-600);'}}) }}
                    <div class="border-2 rounded-2xl p-5 transition-all duration-200
                                peer-checked:border-orange-500 peer-checked:bg-orange-500/10 peer-checked:shadow-lg
                                hover:shadow-md" style="border-color: var(--border-default);" onmouseover="this.style.borderColor='var(--color-primary-300)';" onmouseout="if(!this.previousElementSibling.checked) this.style.borderColor='var(--border-default)';">
                        <div class="flex items-center gap-5">
                            <div class="w-14 h-14 rounded-xl flex items-center justify-center flex-shrink-0
                                        {% if child.vars.value == 'swiss_only' %}
                                            bg-blue-500/20
                                        {% elseif child.vars.value == 'single_elimination' %}
                                            bg-amber-500/20
                                        {% elseif child.vars.value == 'mixed' %}
                                            bg-purple-500/20
                                        {% elseif child.vars.value == 'group_stage_elimination' %}
                                            bg-green-500/20
                                        {% elseif child.vars.value == 'round_robin' %}
                                            bg-rose-500/20
                                        {% endif %}">
                                {% if child.vars.value == 'swiss_only' %}
                                    {{ ux_icon('lucide:refresh-cw', {class: 'w-7 h-7 text-blue-600 dark:text-blue-400'}) }}
                                {% elseif child.vars.value == 'single_elimination' %}
                                    {{ ux_icon('lucide:trophy', {class: 'w-7 h-7 text-amber-600 dark:text-amber-400'}) }}
                                {% elseif child.vars.value == 'mixed' %}
                                    {{ ux_icon('lucide:swords', {class: 'w-7 h-7 text-purple-600 dark:text-purple-400'}) }}
                                {% elseif child.vars.value == 'group_stage_elimination' %}
                                    {{ ux_icon('lucide:layout-grid', {class: 'w-7 h-7 text-green-600 dark:text-green-400'}) }}
                                {% elseif child.vars.value == 'round_robin' %}
                                    {{ ux_icon('lucide:crown', {class: 'w-7 h-7 text-rose-600 dark:text-rose-400'}) }}
                                {% endif %}
                            </div>
                            <div class="flex-1">
                                <div class="font-semibold text-lg flex items-center" style="color: var(--text-primary);">
                                {{ child.vars.label|trans }}
                                {% if child.vars.value in ['swiss_only', 'single_elimination', 'mixed', 'group_stage_elimination', 'round_robin'] %}
                                    {{ include('components/_tooltip.html.twig', {text: ('tooltip.' ~ child.vars.value)|trans, position: 'top'}) }}
                                {% endif %}
                            </div>
                                <div class="text-sm mt-1" style="color: var(--text-muted);">
                                    {{ ('tournament.wizard.step4.structure_desc.' ~ child.vars.value)|trans }}
                                </div>
                            </div>
                            <div class="flex-shrink-0">
                                <div class="w-6 h-6 rounded-full border-2 flex items-center justify-center transition-colors
                                            group-has-[:checked]:border-orange-500 group-has-[:checked]:bg-orange-500" style="border-color: var(--border-default);">
                                    <svg class="w-4 h-4 text-white opacity-0 group-has-[:checked]:opacity-100 transition-opacity" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                                        <polyline points="20 6 9 17 4 12"></polyline>
                                    </svg>
                                </div>
                            </div>
                        </div>
                    </div>
                </label>
            {% endfor %}
        </div>
        {{ form_errors(form.structure) }}
    {{ form_end(form) }}
{% endblock %}
