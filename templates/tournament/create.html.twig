{% extends 'base.html.twig' %}

{% block title %}{{ 'tournament.create.title'|trans }} - Altered Tournament Tools{% endblock %}

{% block body %}
<div class="min-h-screen py-8 px-4">
    <div class="max-w-4xl mx-auto" data-controller="tournament-form">
        {# Header #}
        <div class="text-center mb-8">
            <div class="inline-flex items-center justify-center w-16 h-16 rounded-2xl mb-4 shadow-lg theme-primary-gradient">
                {{ ux_icon('lucide:trophy', {class: 'w-8 h-8 text-white'}) }}
            </div>
            <h1 class="text-3xl font-bold" style="color: var(--text-primary);">{{ 'tournament.create.title'|trans }}</h1>
            <p class="mt-2" style="color: var(--text-muted);">{{ 'tournament.create.subtitle'|trans }}</p>
        </div>

        {{ form_start(form, {'attr': {'class': 'space-y-6', 'novalidate': 'novalidate'}}) }}

        {# ================================================================== #}
        {# Section 1: Informations generales                                  #}
        {# ================================================================== #}
        <div class="rounded-2xl shadow-xl p-6 border" style="background-color: var(--card-bg); border-color: var(--border-muted);">
            <h2 class="text-xl font-bold mb-6 flex items-center" style="color: var(--text-primary);">
                <span class="w-10 h-10 bg-blue-500/20 rounded-xl flex items-center justify-center mr-3">
                    {{ ux_icon('lucide:info', {class: 'w-5 h-5 text-blue-600'}) }}
                </span>
                {{ 'tournament.create.section_general'|trans }}
            </h2>

            <div class="space-y-5">
                {# Nom du tournoi #}
                <div>
                    <label for="{{ form.name.vars.id }}" class="block form-label mb-2">
                        {{ ux_icon('lucide:trophy', {class: 'w-4 h-4 inline mr-1', style: 'color: var(--text-muted);'}) }}
                        {{ 'form.tournament.name'|trans }}
                    </label>
                    <div class="relative">
                        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                            {{ ux_icon('lucide:type', {class: 'w-5 h-5', style: 'color: var(--text-muted);'}) }}
                        </div>
                        {{ form_widget(form.name, {'attr': {
                            'class': 'form-input w-full pl-10',
                            'placeholder': 'form.tournament.name_placeholder'|trans
                        }}) }}
                    </div>
                    {{ form_errors(form.name) }}
                </div>

                {# Date et heure #}
                <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                    <div>
                        <label for="{{ form.date.vars.id }}" class="block form-label mb-2">
                            {{ ux_icon('lucide:calendar', {class: 'w-4 h-4 inline mr-1', style: 'color: var(--text-muted);'}) }}
                            {{ 'form.tournament.date'|trans }}
                        </label>
                        <div class="relative">
                            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                                {{ ux_icon('lucide:calendar-days', {class: 'w-5 h-5', style: 'color: var(--text-muted);'}) }}
                            </div>
                            {{ form_widget(form.date, {'attr': {
                                'class': 'form-input w-full pl-10'
                            }}) }}
                        </div>
                        {{ form_errors(form.date) }}
                    </div>
                    <div>
                        <label for="{{ form.time.vars.id }}" class="block form-label mb-2">
                            {{ ux_icon('lucide:clock', {class: 'w-4 h-4 inline mr-1', style: 'color: var(--text-muted);'}) }}
                            {{ 'form.tournament.time'|trans }}
                        </label>
                        <div class="relative">
                            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                                {{ ux_icon('lucide:clock', {class: 'w-5 h-5', style: 'color: var(--text-muted);'}) }}
                            </div>
                            {{ form_widget(form.time, {'attr': {
                                'class': 'form-input w-full pl-10'
                            }}) }}
                        </div>
                        {{ form_errors(form.time) }}
                    </div>
                </div>

                {# Lieu avec autocompletion #}
                <div data-controller="address-autocomplete">
                    <label for="{{ form.location.vars.id }}" class="block form-label mb-2">
                        {{ ux_icon('lucide:map-pin', {class: 'w-4 h-4 inline mr-1', style: 'color: var(--text-muted);'}) }}
                        {{ 'form.tournament.location'|trans }}
                    </label>
                    <div class="relative">
                        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none z-10">
                            {{ ux_icon('lucide:map-pin', {class: 'w-5 h-5', style: 'color: var(--text-muted);'}) }}
                        </div>
                        {{ form_widget(form.location, {'attr': {
                            'class': 'form-input w-full pl-10',
                            'placeholder': 'form.tournament.location_placeholder'|trans,
                            'data-address-autocomplete-target': 'input',
                            'autocomplete': 'off'
                        }}) }}
                    </div>
                    {{ form_errors(form.location) }}
                    {{ form_widget(form.latitude, {'attr': {'data-address-autocomplete-target': 'latitude'}}) }}
                    {{ form_widget(form.longitude, {'attr': {'data-address-autocomplete-target': 'longitude'}}) }}
                </div>
            </div>
        </div>

        {# ================================================================== #}
        {# Section 2: Format et structure                                     #}
        {# ================================================================== #}
        <div class="rounded-2xl shadow-xl p-6 border" style="background-color: var(--card-bg); border-color: var(--border-muted);">
            <h2 class="text-xl font-bold mb-6 flex items-center" style="color: var(--text-primary);">
                <span class="w-10 h-10 bg-purple-500/20 rounded-xl flex items-center justify-center mr-3">
                    {{ ux_icon('lucide:settings', {class: 'w-5 h-5 text-purple-600'}) }}
                </span>
                {{ 'tournament.create.section_config'|trans }}
            </h2>

            <div class="space-y-5">
                {# Format et Structure en grille #}
                <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                    <div>
                        <label for="{{ form.format.vars.id }}" class="block form-label mb-2">
                            {{ ux_icon('lucide:layers', {class: 'w-4 h-4 inline mr-1', style: 'color: var(--text-muted);'}) }}
                            {{ 'form.tournament.format'|trans }}
                        </label>
                        {{ form_widget(form.format, {'attr': {
                            'class': 'form-input w-full'
                        }}) }}
                        {{ form_errors(form.format) }}
                    </div>
                    <div>
                        <label for="{{ form.structure.vars.id }}" class="block form-label mb-2">
                            {{ ux_icon('lucide:git-branch', {class: 'w-4 h-4 inline mr-1', style: 'color: var(--text-muted);'}) }}
                            {{ 'form.tournament.structure'|trans }}
                        </label>
                        {{ form_widget(form.structure, {'attr': {
                            'class': 'form-input w-full',
                            'data-tournament-form-target': 'structure',
                            'data-action': 'change->tournament-form#structureChanged'
                        }}) }}
                        {{ form_errors(form.structure) }}
                    </div>
                </div>

                {# Formats de match #}
                <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                    <div>
                        <label for="{{ form.swissMatchFormat.vars.id }}" class="block form-label mb-2">
                            {{ ux_icon('lucide:refresh-cw', {class: 'w-4 h-4 inline mr-1 text-blue-500'}) }}
                            {{ 'form.tournament.swiss_match_format'|trans }}
                        </label>
                        {{ form_widget(form.swissMatchFormat, {'attr': {
                            'class': 'form-input w-full',
                            'data-tournament-form-target': 'swissMatchFormat',
                            'data-action': 'change->tournament-form#suggestRounds'
                        }}) }}
                        {{ form_errors(form.swissMatchFormat) }}
                    </div>
                    <div data-tournament-form-target="eliminationFormatContainer">
                        <label for="{{ form.eliminationMatchFormat.vars.id }}" class="block form-label mb-2">
                            {{ ux_icon('lucide:trophy', {class: 'w-4 h-4 inline mr-1 text-amber-500'}) }}
                            {{ 'form.tournament.elimination_match_format'|trans }}
                        </label>
                        {{ form_widget(form.eliminationMatchFormat, {'attr': {
                            'class': 'form-input w-full'
                        }}) }}
                        {{ form_errors(form.eliminationMatchFormat) }}
                    </div>
                </div>

                {# Joueurs, rondes, top cut (hidden when group stage) #}
                <div data-tournament-form-target="standardPlayersSection">
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
                        <div>
                            <label for="{{ form.expectedPlayers.vars.id }}" class="block form-label mb-2">
                                {{ ux_icon('lucide:users', {class: 'w-4 h-4 inline mr-1', style: 'color: var(--text-muted);'}) }}
                                {{ 'form.tournament.expected_players'|trans }}
                            </label>
                            <div class="relative">
                                <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                                    {{ ux_icon('lucide:hash', {class: 'w-5 h-5', style: 'color: var(--text-muted);'}) }}
                                </div>
                                {{ form_widget(form.expectedPlayers, {'attr': {
                                    'class': 'form-input w-full pl-10',
                                    'data-tournament-form-target': 'expectedPlayers',
                                    'data-action': 'input->tournament-form#suggestRounds'
                                }}) }}
                            </div>
                            {{ form_errors(form.expectedPlayers) }}
                        </div>
                        <div data-tournament-form-target="swissRoundsContainer">
                            <label for="{{ form.swissRounds.vars.id }}" class="block form-label mb-2">
                                {{ ux_icon('lucide:repeat', {class: 'w-4 h-4 inline mr-1', style: 'color: var(--text-muted);'}) }}
                                {{ 'form.tournament.swiss_rounds'|trans }}
                            </label>
                            {{ form_widget(form.swissRounds, {'attr': {
                                'class': 'form-input w-full',
                                'data-tournament-form-target': 'swissRounds'
                            }}) }}
                            {{ form_errors(form.swissRounds) }}
                            <p class="text-xs text-orange-600 mt-1" data-tournament-form-target="roundsSuggestion"></p>
                        </div>
                        <div data-tournament-form-target="topCutSizeContainer">
                            <label for="{{ form.topCutSize.vars.id }}" class="block form-label mb-2">
                                {{ ux_icon('lucide:award', {class: 'w-4 h-4 inline mr-1', style: 'color: var(--text-muted);'}) }}
                                {{ 'form.tournament.top_cut_size'|trans }}
                            </label>
                            {{ form_widget(form.topCutSize, {'attr': {
                                'class': 'form-input w-full'
                            }}) }}
                            {{ form_errors(form.topCutSize) }}
                        </div>
                    </div>
                </div>

                {# Group Stage Configuration (shown when group_stage_elimination is selected) #}
                <div data-tournament-form-target="groupStageSection" class="hidden">
                    <div class="rounded-xl p-5 border" style="background-color: var(--color-green-50); border-color: var(--color-green-200);">
                        <h3 class="text-lg font-semibold mb-5 flex items-center" style="color: var(--color-green-800);">
                            {{ ux_icon('lucide:layout-grid', {class: 'w-5 h-5 mr-2'}) }}
                            {{ 'form.tournament.group_stage_config'|trans }}
                        </h3>

                        <div class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-5">
                            <div>
                                <label for="{{ form.groupCount.vars.id }}" class="block form-label mb-2">
                                    {{ 'form.tournament.group_count'|trans }}
                                </label>
                                {{ form_widget(form.groupCount, {'attr': {
                                    'class': 'form-input w-full',
                                    'data-tournament-form-target': 'groupCount',
                                    'data-action': 'input->tournament-form#updateGroupSummary',
                                    'placeholder': 'Ex: 4'
                                }}) }}
                                {{ form_errors(form.groupCount) }}
                            </div>
                            <div>
                                <label for="{{ form.playersPerGroup.vars.id }}" class="block form-label mb-2">
                                    {{ 'form.tournament.players_per_group'|trans }}
                                </label>
                                {{ form_widget(form.playersPerGroup, {'attr': {
                                    'class': 'form-input w-full',
                                    'data-tournament-form-target': 'playersPerGroup',
                                    'data-action': 'input->tournament-form#updateGroupSummary',
                                    'placeholder': 'Ex: 4'
                                }}) }}
                                {{ form_errors(form.playersPerGroup) }}
                            </div>
                        </div>

                        <div class="mb-5">
                            <label for="{{ form.qualifiersPerGroup.vars.id }}" class="block form-label mb-2">
                                {{ 'form.tournament.qualifiers_per_group'|trans }}
                            </label>
                            {{ form_widget(form.qualifiersPerGroup, {'attr': {
                                'class': 'form-input w-full',
                                'data-tournament-form-target': 'qualifiersPerGroup',
                                'data-action': 'change->tournament-form#updateGroupSummary'
                            }}) }}
                            {{ form_errors(form.qualifiersPerGroup) }}
                        </div>

                        {# Summary #}
                        <div data-tournament-form-target="groupSummary" class="rounded-lg p-4 border" style="background-color: var(--card-bg); border-color: var(--color-green-200);">
                            <h4 class="font-medium mb-3 flex items-center" style="color: var(--text-primary);">
                                {{ ux_icon('lucide:calculator', {class: 'w-4 h-4 mr-2', style: 'color: var(--color-green-600);'}) }}
                                {{ 'form.tournament.group_summary'|trans }}
                            </h4>
                            <div class="grid grid-cols-2 md:grid-cols-4 gap-3 text-sm">
                                <div data-tournament-form-target="totalPlayersDisplay" class="text-center p-2 rounded-lg" style="background-color: var(--bg-subtle);">
                                    <div class="text-xs mb-1" style="color: var(--text-muted);">{{ 'form.tournament.total_players'|trans }}</div>
                                    <div class="font-bold text-lg" style="color: var(--text-primary);"><span>-</span></div>
                                </div>
                                <div data-tournament-form-target="roundsPerGroupDisplay" class="text-center p-2 rounded-lg" style="background-color: var(--bg-subtle);">
                                    <div class="text-xs mb-1" style="color: var(--text-muted);">{{ 'form.tournament.rounds_per_group'|trans }}</div>
                                    <div class="font-bold text-lg" style="color: var(--text-primary);"><span>-</span></div>
                                </div>
                                <div data-tournament-form-target="totalQualifiersDisplay" class="text-center p-2 rounded-lg" style="background-color: var(--bg-subtle);">
                                    <div class="text-xs mb-1" style="color: var(--text-muted);">{{ 'form.tournament.total_qualifiers'|trans }}</div>
                                    <div class="font-bold text-lg" style="color: var(--text-primary);"><span>-</span></div>
                                </div>
                                <div data-tournament-form-target="bracketSizeDisplay" class="text-center p-2 rounded-lg" style="background-color: var(--color-green-50);">
                                    <div class="text-xs mb-1" style="color: var(--text-muted);">{{ 'form.tournament.bracket_size'|trans }}</div>
                                    <div class="font-bold text-sm" style="color: var(--color-green-700);"></div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                {# Tournament Type Flags #}
                <div class="flex flex-wrap gap-4 pt-4" style="border-top: 1px solid var(--border-muted);">
                    <label class="flex items-center p-4 rounded-xl border-2 border-transparent cursor-pointer transition-all" style="background-color: var(--bg-subtle);">
                        {{ form_widget(form.isTumult, {'attr': {'class': 'h-4 w-4', 'style': 'accent-color: var(--color-primary-600);'}}) }}
                        <span class="ml-3">
                            <span class="flex items-center text-sm font-medium" style="color: var(--text-primary);">
                                {{ ux_icon('lucide:zap', {class: 'w-4 h-4 inline mr-1 text-amber-500'}) }}
                                {{ 'form.tournament.is_tumult'|trans }}
                            </span>
                            <span class="block text-xs mt-0.5" style="color: var(--text-muted);">{{ 'form.tournament.is_tumult_help'|trans }}</span>
                        </span>
                    </label>
                    <label class="flex items-center p-4 rounded-xl border-2 border-transparent cursor-pointer transition-all" style="background-color: var(--bg-subtle);">
                        {{ form_widget(form.isSeasonFinalsQualifier, {'attr': {'class': 'h-4 w-4', 'style': 'accent-color: var(--color-primary-600);'}}) }}
                        <span class="ml-3">
                            <span class="flex items-center text-sm font-medium" style="color: var(--text-primary);">
                                {{ ux_icon('lucide:star', {class: 'w-4 h-4 inline mr-1 text-purple-500'}) }}
                                {{ 'form.tournament.is_season_finals_qualifier'|trans }}
                            </span>
                            <span class="block text-xs mt-0.5" style="color: var(--text-muted);">{{ 'form.tournament.is_season_finals_qualifier_help'|trans }}</span>
                        </span>
                    </label>
                    <label class="flex items-center p-4 rounded-xl border-2 border-transparent cursor-pointer transition-all" style="background-color: var(--bg-subtle);">
                        {{ form_widget(form.checkInEnabled, {'attr': {'class': 'h-4 w-4', 'style': 'accent-color: var(--color-primary-600);'}}) }}
                        <span class="ml-3">
                            <span class="flex items-center text-sm font-medium" style="color: var(--text-primary);">
                                {{ ux_icon('lucide:user-check', {class: 'w-4 h-4 inline mr-1 text-cyan-500'}) }}
                                {{ 'form.tournament.check_in_enabled'|trans }}
                            </span>
                            <span class="block text-xs mt-0.5" style="color: var(--text-muted);">{{ 'form.tournament.check_in_enabled_help'|trans }}</span>
                        </span>
                    </label>
                </div>
            </div>
        </div>

        {# ================================================================== #}
        {# Section 3: Visibilite                                              #}
        {# ================================================================== #}
        <div class="rounded-2xl shadow-xl p-6 border" style="background-color: var(--card-bg); border-color: var(--border-muted);">
            <h2 class="text-xl font-bold mb-6 flex items-center" style="color: var(--text-primary);">
                <span class="w-10 h-10 bg-green-500/20 rounded-xl flex items-center justify-center mr-3">
                    {{ ux_icon('lucide:eye', {class: 'w-5 h-5 text-green-600'}) }}
                </span>
                {{ 'tournament.create.section_visibility'|trans }}
            </h2>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                {# Visibilite du tournoi #}
                <div>
                    <span class="block form-label mb-3">{{ 'form.tournament.visibility'|trans }}</span>
                    <div class="space-y-3">
                        {% for child in form.visibility %}
                            <label class="flex items-center p-4 rounded-xl border-2 border-transparent" style="background-color: var(--bg-subtle); cursor: pointer; transition: all 0.2s;">
                                {{ form_widget(child, {'attr': {'class': 'form-radio text-green-600 focus:ring-green-500'}}) }}
                                <div class="ml-3 flex items-center">
                                    {% if child.vars.value == 'public' %}
                                        <div class="w-8 h-8 bg-green-500/20 rounded-lg flex items-center justify-center mr-3">
                                            {{ ux_icon('lucide:globe', {class: 'w-4 h-4 text-green-600'}) }}
                                        </div>
                                    {% else %}
                                        <div class="w-8 h-8 bg-amber-500/20 rounded-lg flex items-center justify-center mr-3">
                                            {{ ux_icon('lucide:lock', {class: 'w-4 h-4 text-amber-600'}) }}
                                        </div>
                                    {% endif %}
                                    <span class="form-label">{{ child.vars.label|trans }}</span>
                                </div>
                            </label>
                        {% endfor %}
                    </div>
                    {{ form_errors(form.visibility) }}
                </div>

                {# Transparence des decklists #}
                <div>
                    <span class="block form-label mb-3">{{ 'form.tournament.decklist_transparency'|trans }}</span>
                    <div class="space-y-3">
                        {% for child in form.decklistTransparency %}
                            <label class="flex items-center p-4 rounded-xl border-2 border-transparent" style="background-color: var(--bg-subtle); cursor: pointer; transition: all 0.2s;">
                                {{ form_widget(child, {'attr': {'class': 'form-radio text-blue-600 focus:ring-blue-500'}}) }}
                                <div class="ml-3 flex items-center">
                                    {% if child.vars.value == 'open' %}
                                        <div class="w-8 h-8 bg-blue-500/20 rounded-lg flex items-center justify-center mr-3">
                                            {{ ux_icon('lucide:eye', {class: 'w-4 h-4 text-blue-600'}) }}
                                        </div>
                                    {% else %}
                                        <div class="w-8 h-8 bg-gray-500/20 rounded-lg flex items-center justify-center mr-3">
                                            {{ ux_icon('lucide:eye-off', {class: 'w-4 h-4 text-gray-500'}) }}
                                        </div>
                                    {% endif %}
                                    <span class="form-label">{{ child.vars.label|trans }}</span>
                                </div>
                            </label>
                        {% endfor %}
                    </div>
                    {{ form_errors(form.decklistTransparency) }}
                </div>
            </div>
        </div>

        {# ================================================================== #}
        {# Section 4: Informations supplementaires                            #}
        {# ================================================================== #}
        <div class="rounded-2xl shadow-xl p-6 border" style="background-color: var(--card-bg); border-color: var(--border-muted);">
            <h2 class="text-xl font-bold mb-6 flex items-center" style="color: var(--text-primary);">
                <span class="w-10 h-10 bg-orange-500/20 rounded-xl flex items-center justify-center mr-3">
                    {{ ux_icon('lucide:file-text', {class: 'w-5 h-5 text-orange-600'}) }}
                </span>
                {{ 'tournament.create.section_additional'|trans }}
            </h2>

            <div class="space-y-5">
                {# Description #}
                <div>
                    <label for="{{ form.description.vars.id }}" class="block form-label mb-2">
                        {{ ux_icon('lucide:align-left', {class: 'w-4 h-4 inline mr-1', style: 'color: var(--text-muted);'}) }}
                        {{ 'form.tournament.description'|trans }}
                    </label>
                    {{ form_widget(form.description, {'attr': {
                        'class': 'form-input w-full resize-none',
                        'rows': '4',
                        'placeholder': 'form.tournament.description_placeholder'|trans
                    }}) }}
                    {{ form_errors(form.description) }}
                </div>

                {# Prix d'entree et lien Altered.gg #}
                <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                    <div>
                        <label for="{{ form.entryFee.vars.id }}" class="block form-label mb-2">
                            {{ ux_icon('lucide:ticket', {class: 'w-4 h-4 inline mr-1', style: 'color: var(--text-muted);'}) }}
                            {{ 'form.tournament.entry_fee'|trans }}
                        </label>
                        <div class="relative">
                            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                                {{ ux_icon('lucide:euro', {class: 'w-5 h-5', style: 'color: var(--text-muted);'}) }}
                            </div>
                            {{ form_widget(form.entryFee, {'attr': {
                                'class': 'form-input w-full pl-10',
                                'placeholder': 'form.tournament.entry_fee_placeholder'|trans
                            }}) }}
                        </div>
                        {{ form_errors(form.entryFee) }}
                    </div>
                    <div>
                        <label for="{{ form.alteredGgLink.vars.id }}" class="block form-label mb-2">
                            {{ ux_icon('lucide:link', {class: 'w-4 h-4 inline mr-1', style: 'color: var(--text-muted);'}) }}
                            {{ 'form.tournament.altered_gg_link'|trans }}
                        </label>
                        <div class="relative">
                            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                                {{ ux_icon('lucide:external-link', {class: 'w-5 h-5', style: 'color: var(--text-muted);'}) }}
                            </div>
                            {{ form_widget(form.alteredGgLink, {'attr': {
                                'class': 'form-input w-full pl-10',
                                'placeholder': 'form.tournament.altered_gg_placeholder'|trans
                            }}) }}
                        </div>
                        {{ form_errors(form.alteredGgLink) }}
                    </div>
                </div>

                {# Dotations #}
                <div>
                    <label for="{{ form.prizes.vars.id }}" class="block form-label mb-2">
                        {{ ux_icon('lucide:gift', {class: 'w-4 h-4 inline mr-1', style: 'color: var(--text-muted);'}) }}
                        {{ 'form.tournament.prizes'|trans }}
                    </label>
                    {{ form_widget(form.prizes, {'attr': {
                        'class': 'form-input w-full resize-none',
                        'rows': '3',
                        'placeholder': 'form.tournament.prizes_placeholder'|trans
                    }}) }}
                    {{ form_errors(form.prizes) }}
                </div>
            </div>
        </div>

        {# ================================================================== #}
        {# Récurrence & publication                                           #}
        {# ================================================================== #}
        <div class="rounded-2xl shadow-xl p-6 border" style="background-color: var(--card-bg); border-color: var(--border-muted);"
             data-controller="recurrence">

            {# Publication #}
            <h2 class="text-xl font-bold mb-4 flex items-center" style="color: var(--text-primary);">
                <span class="w-10 h-10 bg-green-500/20 rounded-xl flex items-center justify-center mr-3">
                    {{ ux_icon('lucide:send', {class: 'w-5 h-5 text-green-600'}) }}
                </span>
                {{ 'tournament.wizard.recurrence.publish_label'|trans }}
            </h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-3 mb-6">
                {% for child in recurrenceForm.publishImmediately %}
                    <label class="cursor-pointer flex items-center gap-3 p-4 rounded-xl border-2 transition-all has-[:checked]:border-green-500 has-[:checked]:bg-green-500/10"
                           style="border-color: var(--border-default);">
                        {{ form_widget(child, {attr: {class: 'accent-green-500'}}) }}
                        <div class="font-medium text-sm" style="color: var(--text-primary);">{{ child.vars.label|trans }}</div>
                    </label>
                {% endfor %}
            </div>

            {# Séparateur #}
            <hr class="mb-6" style="border-color: var(--border-default);">

            {# Récurrence toggle #}
            <label class="flex items-center gap-3 cursor-pointer" data-action="change->recurrence#toggle">
                {{ form_widget(recurrenceForm.enabled) }}
                <div>
                    <span class="font-semibold" style="color: var(--text-primary);">
                        {{ ux_icon('lucide:repeat', {class: 'w-4 h-4 inline mr-1 text-purple-500'}) }}
                        {{ 'tournament.wizard.recurrence.enabled'|trans }}
                    </span>
                    <p class="text-xs mt-0.5" style="color: var(--text-muted);">{{ 'tournament.wizard.recurrence.enabled_hint'|trans }}</p>
                </div>
            </label>

            <div class="mt-4 space-y-4 hidden" data-recurrence-target="fields">
                <div class="grid grid-cols-3 gap-4">
                    <div>
                        <label class="block text-xs font-medium mb-1" style="color: var(--text-muted);">{{ 'tournament.wizard.recurrence.interval_label'|trans }}</label>
                        {{ form_widget(recurrenceForm.interval, {attr: {class: 'w-full rounded-xl px-3 py-2 border text-sm', style: 'background-color: var(--bg-subtle); border-color: var(--border-default); color: var(--text-primary);'}}) }}
                    </div>
                    <div>
                        <label class="block text-xs font-medium mb-1" style="color: var(--text-muted);">{{ 'tournament.wizard.recurrence.unit_label'|trans }}</label>
                        {{ form_widget(recurrenceForm.unit, {attr: {class: 'w-full rounded-xl px-3 py-2 border text-sm', style: 'background-color: var(--bg-subtle); border-color: var(--border-default); color: var(--text-primary);'}}) }}
                    </div>
                    <div>
                        <label class="block text-xs font-medium mb-1" style="color: var(--text-muted);">{{ 'tournament.wizard.recurrence.count_label'|trans }}</label>
                        {{ form_widget(recurrenceForm.count, {attr: {class: 'w-full rounded-xl px-3 py-2 border text-sm', style: 'background-color: var(--bg-subtle); border-color: var(--border-default); color: var(--text-primary);'}}) }}
                    </div>
                </div>
                <p class="text-xs" style="color: var(--text-muted);">{{ 'tournament.wizard.recurrence.count_hint'|trans }}</p>
                {{ form_errors(recurrenceForm) }}
            </div>
        </div>

        {# ================================================================== #}
        {# Boutons d'action                                                   #}
        {# ================================================================== #}
        <div class="flex flex-col sm:flex-row justify-between items-center gap-4 pt-4">
            <a href="{{ path('tournament_list') }}"
               class="w-full sm:w-auto inline-flex items-center justify-center px-6 py-3 border-2 text-base font-semibold rounded-xl hover:opacity-80 focus:outline-none focus:ring-2 focus:ring-offset-2 transition-all duration-200"
               style="border-color: var(--border-default); color: var(--text-secondary); background-color: var(--card-bg);">
                {{ ux_icon('lucide:x', {class: 'w-5 h-5 mr-2'}) }}
                {{ 'tournament.create.cancel'|trans }}
            </a>
            <button type="submit"
                    class="w-full sm:w-auto inline-flex items-center justify-center px-8 py-3 text-base font-semibold rounded-xl text-white shadow-lg transition-all duration-200 transform hover:scale-105 hover:shadow-xl"
                    style="background: linear-gradient(135deg, var(--color-primary-500), var(--color-accent-500));">
                {{ ux_icon('lucide:plus', {class: 'w-5 h-5 mr-2'}) }}
                {{ 'tournament.create.submit'|trans }}
            </button>
        </div>

        {{ form_end(form) }}
    </div>
</div>
{% endblock %}
