{% extends 'base.html.twig' %}

{% block title %}{{ 'groups.title'|trans }} - {{ tournament.name }}{% endblock %}

{% block body %}
<div class="max-w-6xl mx-auto">
    {# Header Card #}
    <div class="rounded-2xl shadow-xl overflow-hidden mb-8" style="background-color: var(--card-bg);">
        <div class="theme-header-gradient px-8 py-6">
            <div class="flex flex-col md:flex-row md:items-center md:justify-between">
                <div>
                    <div class="text-white/80 text-sm mb-1">
                        <a href="{{ path('tournament_show', {id: tournament.id}) }}" class="hover:text-white">
                            {{ tournament.name }}
                        </a>
                    </div>
                    <h1 class="text-3xl font-bold text-white drop-shadow-sm flex items-center gap-3">
                        {{ ux_icon('lucide:layout-grid', {class: 'w-8 h-8'}) }}
                        {{ 'groups.header'|trans }}
                    </h1>
                    <div class="mt-3 flex items-center space-x-3">
                        <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-white/20 text-white backdrop-blur-sm">
                            {{ 'groups.badge.groups_count'|trans({'%count%': tournament.groupCount ?? '?'}) }}
                        </span>
                        <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-white/20 text-white backdrop-blur-sm">
                            {{ 'groups.badge.players_per_group'|trans({'%count%': tournament.playersPerGroup ?? '?'}) }}
                        </span>
                        <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-white/20 text-white backdrop-blur-sm">
                            {{ 'groups.badge.qualifiers_per_group'|trans({'%count%': tournament.qualifiersPerGroup ?? '?'}) }}
                        </span>
                    </div>
                </div>

                {# Progress #}
                <div class="mt-4 md:mt-0 text-white/90">
                    <div class="text-center">
                        <div class="text-2xl font-bold">{{ completedMatches }}/{{ totalMatches }}</div>
                        <div class="text-xs uppercase tracking-wide">{{ 'groups.matches_played'|trans }}</div>
                    </div>
                </div>
            </div>
        </div>

        {# Action bar for organizer #}
        {% if is_granted('TOURNAMENT_MANAGE', tournament) %}
            <div class="px-8 py-4 border-t" style="background-color: var(--bg-subtle); border-color: var(--border-muted);">
                <div class="flex flex-wrap gap-3 items-center">
                    {% if not groupsFormed %}
                        {% if tournament.groupCount is null or tournament.playersPerGroup is null or tournament.qualifiersPerGroup is null %}
                            <div class="inline-flex items-center px-4 py-2 bg-amber-100 dark:bg-amber-900/30 text-amber-800 dark:text-amber-300 rounded-xl text-sm">
                                {{ ux_icon('lucide:alert-triangle', {class: 'w-5 h-5 mr-2'}) }}
                                {{ 'groups.config_incomplete'|trans }} -
                                <a href="{{ path('tournament_edit', {id: tournament.id}) }}" class="underline ml-1 font-semibold">{{ 'groups.configure_groups'|trans }}</a>
                            </div>
                        {% else %}
                            {% set expectedPlayers = tournament.groupCount * tournament.playersPerGroup %}
                            {% set registeredPlayers = tournament.registrations|length %}
                            {% if registeredPlayers < expectedPlayers %}
                                <div class="inline-flex items-center px-4 py-2 bg-amber-100 dark:bg-amber-900/30 text-amber-800 dark:text-amber-300 rounded-xl text-sm">
                                    {{ ux_icon('lucide:users', {class: 'w-5 h-5 mr-2'}) }}
                                    {{ 'groups.players_registered'|trans({'%registered%': registeredPlayers, '%expected%': expectedPlayers}) }}
                                </div>
                            {% endif %}
                            <form action="{{ path('tournament_form_groups', {id: tournament.id}) }}" method="POST" class="inline">
                                <input type="hidden" name="_token" value="{{ csrf_token('form-groups-' ~ tournament.id) }}">
                                <button type="submit"
                                        class="inline-flex items-center px-5 py-2 text-white rounded-xl font-semibold transition-all shadow-md {% if registeredPlayers < expectedPlayers %}opacity-50 cursor-not-allowed{% endif %}"
                                        style="background: linear-gradient(135deg, var(--color-primary-500), var(--color-accent-500));"
                                        {% if registeredPlayers < expectedPlayers %}disabled{% endif %}
                                        onclick="return confirm('{{ 'groups.confirm_form_groups'|trans }}')">
                                    {{ ux_icon('lucide:shuffle', {class: 'w-5 h-5 mr-2'}) }}
                                    {{ 'groups.form_groups'|trans }}
                                </button>
                            </form>
                        {% endif %}
                    {% elseif isInEliminationPhase %}
                        {# In elimination phase - no group action buttons needed #}
                    {% elseif groupPhaseComplete %}
                        {# All round-robin rounds completed - can start elimination #}
                        <form action="{{ path('tournament_start_elimination', {id: tournament.id}) }}" method="POST" class="inline">
                            <input type="hidden" name="_token" value="{{ csrf_token('start-elimination-' ~ tournament.id) }}">
                            <button type="submit"
                                    class="inline-flex items-center px-5 py-2 bg-gradient-to-r from-amber-500 to-orange-500 text-white rounded-xl font-semibold hover:from-amber-600 hover:to-orange-600 transition-all shadow-md"
                                    onclick="return confirm('{{ 'groups.confirm_start_elimination'|trans }}')">
                                {{ ux_icon('lucide:trophy', {class: 'w-5 h-5 mr-2'}) }}
                                {{ 'groups.start_elimination'|trans }}
                            </button>
                        </form>
                    {% elseif allMatchesComplete %}
                        {# Group phase not complete but current round finished - show next round button #}
                        <form action="{{ path('tournament_next_group_round', {id: tournament.id}) }}" method="POST" class="inline">
                            <input type="hidden" name="_token" value="{{ csrf_token('next-group-round-' ~ tournament.id) }}">
                            <button type="submit"
                                    class="inline-flex items-center px-5 py-2 text-white rounded-xl font-semibold transition-all shadow-md"
                                    style="background: linear-gradient(135deg, var(--color-primary-500), var(--color-accent-500));">
                                {{ ux_icon('lucide:play', {class: 'w-5 h-5 mr-2'}) }}
                                {{ 'groups.next_round'|trans }}
                            </button>
                        </form>
                    {% endif %}

                    <a href="{{ path('tournament_dashboard', {id: tournament.id}) }}"
                       class="inline-flex items-center px-4 py-2 border-2 rounded-xl font-medium transition-all shadow-sm"
                       style="background-color: var(--card-bg); border-color: var(--color-primary-200); color: var(--color-primary-600);">
                        {{ ux_icon('lucide:bar-chart-3', {class: 'w-4 h-4 mr-2'}) }}
                        {{ 'dashboard.title'|trans }}
                    </a>
                </div>
            </div>
        {% endif %}
    </div>

    {% if not groupsFormed %}
        {# Groups not formed yet #}
        <div class="rounded-xl shadow-lg p-8 text-center" style="background-color: var(--card-bg);">
            <div class="w-16 h-16 rounded-full flex items-center justify-center mx-auto mb-4" style="background-color: var(--color-primary-100);">
                {{ ux_icon('lucide:layout-grid', {class: 'w-8 h-8', style: 'color: var(--color-primary-500);'}) }}
            </div>
            <h2 class="text-xl font-bold mb-2" style="color: var(--text-primary);">{{ 'groups.not_formed'|trans }}</h2>
            {% if tournament.groupCount is null or tournament.playersPerGroup is null or tournament.qualifiersPerGroup is null %}
                <div class="bg-amber-50 dark:bg-amber-900/20 border border-amber-200 dark:border-amber-700 rounded-xl p-4 mb-4">
                    <p class="text-amber-800 dark:text-amber-300 font-medium mb-2">
                        {{ ux_icon('lucide:alert-triangle', {class: 'w-5 h-5 inline mr-2'}) }}
                        {{ 'groups.config_incomplete_title'|trans }}
                    </p>
                    <p class="text-amber-700 dark:text-amber-400 text-sm mb-3">
                        {{ 'groups.config_incomplete_description'|trans }}
                    </p>
                    <a href="{{ path('tournament_edit', {id: tournament.id}) }}"
                       class="inline-flex items-center px-4 py-2 bg-amber-500 text-white rounded-lg font-medium hover:bg-amber-600 transition-colors">
                        {{ ux_icon('lucide:settings', {class: 'w-4 h-4 mr-2'}) }}
                        {{ 'groups.configure_tournament'|trans }}
                    </a>
                </div>
            {% else %}
                {% set expectedPlayers = tournament.groupCount * tournament.playersPerGroup %}
                <p class="mb-4" style="color: var(--text-secondary);">
                    {{ 'groups.not_formed_description'|trans({'%registered%': tournament.registrations|length, '%expected%': expectedPlayers}) }}
                </p>
                {% if tournament.registrations|length < expectedPlayers %}
                    <p class="text-amber-600 dark:text-amber-400 text-sm">
                        {{ ux_icon('lucide:alert-triangle', {class: 'w-4 h-4 inline mr-1'}) }}
                        {{ 'groups.missing_players'|trans({'%count%': expectedPlayers - tournament.registrations|length}) }}
                    </p>
                {% endif %}
            {% endif %}
        </div>
    {% else %}
        {# Tab navigation for groups #}
        <div class="mb-6" id="groups-tabs">
            <div class="border-b" style="border-color: var(--border-muted);">
                <nav class="flex -mb-px space-x-4 overflow-x-auto" aria-label="{{ 'groups.title'|trans }}">
                    {% for group in groups %}
                        <button type="button"
                                class="group-tab py-3 px-4 border-b-2 font-medium text-sm whitespace-nowrap transition-colors"
                                style="{{ loop.first ? 'border-color: var(--color-primary-500); color: var(--color-primary-600);' : 'border-color: transparent; color: var(--text-secondary);' }}"
                                data-tab-index="{{ loop.index0 }}">
                            {{ 'groups.group_name'|trans({'%letter%': group.letter}) }}
                            <span class="tab-badge ml-2 py-0.5 px-2 rounded-full text-xs"
                                  style="{{ loop.first ? 'background-color: var(--color-primary-100); color: var(--color-primary-700);' : 'background-color: var(--bg-muted); color: var(--text-secondary);' }}">
                                {{ group.players|length }}
                            </span>
                        </button>
                    {% endfor %}
                </nav>
            </div>

            {# Group content panels #}
            {% for group in groups %}
                <div class="group-panel mt-6 {{ loop.first ? '' : 'hidden' }}" data-panel-index="{{ loop.index0 }}">
                    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                        {# Standings table #}
                        <div class="lg:col-span-2 rounded-xl shadow-lg overflow-hidden" style="background-color: var(--card-bg);">
                            <div class="px-6 py-4 border-b" style="background-color: var(--bg-subtle); border-color: var(--border-muted);">
                                <h3 class="text-lg font-bold flex items-center" style="color: var(--text-primary);">
                                    {{ ux_icon('lucide:trophy', {class: 'w-5 h-5 mr-2', style: 'color: var(--color-primary-500);'}) }}
                                    {{ 'groups.standings'|trans({'%letter%': group.letter}) }}
                                </h3>
                            </div>
                            <div class="overflow-x-auto">
                                <table class="min-w-full">
                                    <thead style="background-color: var(--bg-muted);">
                                        <tr>
                                            <th class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider" style="color: var(--text-secondary);">#</th>
                                            <th class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider" style="color: var(--text-secondary);">{{ 'common.player'|trans }}</th>
                                            <th class="px-4 py-3 text-center text-xs font-medium uppercase tracking-wider" style="color: var(--text-secondary);">{{ 'standings.wins_short'|trans }}</th>
                                            <th class="px-4 py-3 text-center text-xs font-medium uppercase tracking-wider" style="color: var(--text-secondary);">{{ 'standings.draws_short'|trans }}</th>
                                            <th class="px-4 py-3 text-center text-xs font-medium uppercase tracking-wider" style="color: var(--text-secondary);">{{ 'standings.losses_short'|trans }}</th>
                                            <th class="px-4 py-3 text-center text-xs font-medium uppercase tracking-wider" style="color: var(--text-secondary);">{{ 'standings.points'|trans }}</th>
                                            <th class="px-4 py-3 text-center text-xs font-medium uppercase tracking-wider" style="color: var(--text-secondary);">+/-</th>
                                        </tr>
                                    </thead>
                                    <tbody class="divide-y" style="background-color: var(--card-bg); --tw-divide-opacity: 1; divide-color: var(--border-muted);">
                                        {% for standing in standings[group.letter] %}
                                            {% set isQualified = loop.index <= tournament.qualifiersPerGroup %}
                                            <tr style="{{ isQualified ? 'background-color: var(--color-primary-50);' : '' }}">
                                                <td class="px-4 py-4 whitespace-nowrap">
                                                    <span class="flex items-center justify-center w-7 h-7 rounded-full font-semibold text-sm"
                                                          style="{{ isQualified ? 'background-color: var(--color-primary-500); color: white;' : 'background-color: var(--bg-muted); color: var(--text-secondary);' }}">
                                                        {{ loop.index }}
                                                    </span>
                                                </td>
                                                <td class="px-4 py-4 whitespace-nowrap">
                                                    <div class="flex items-center">
                                                        {% if standing.registration.player.avatar %}
                                                            <img src="/uploads/avatars/{{ standing.registration.player.avatar }}" alt="Avatar"
                                                                 class="w-8 h-8 rounded-full object-cover mr-3">
                                                        {% else %}
                                                            <div class="w-8 h-8 rounded-full flex items-center justify-center mr-3 theme-primary-gradient">
                                                                <span class="text-white font-semibold text-sm">{{ standing.registration.player.pseudo|slice(0,1)|upper }}</span>
                                                            </div>
                                                        {% endif %}
                                                        <div>
                                                            <div class="font-medium" style="color: var(--text-primary);">{{ standing.registration.player.displayName }}</div>
                                                        </div>
                                                    </div>
                                                </td>
                                                <td class="px-4 py-4 text-center whitespace-nowrap font-semibold" style="color: var(--color-primary-600);">{{ standing.wins }}</td>
                                                <td class="px-4 py-4 text-center whitespace-nowrap" style="color: var(--text-secondary);">{{ standing.draws }}</td>
                                                <td class="px-4 py-4 text-center whitespace-nowrap font-semibold text-red-600 dark:text-red-400">{{ standing.losses }}</td>
                                                <td class="px-4 py-4 text-center whitespace-nowrap">
                                                    <span class="font-bold text-lg" style="{{ isQualified ? 'color: var(--color-primary-700);' : 'color: var(--text-primary);' }}">
                                                        {{ standing.matchPoints }}
                                                    </span>
                                                </td>
                                                <td class="px-4 py-4 text-center whitespace-nowrap">
                                                    {% set diff = standing.pointDifferential %}
                                                    <span class="{{ diff > 0 ? 'text-green-600 dark:text-green-400' : (diff < 0 ? 'text-red-600 dark:text-red-400' : '') }}" style="{{ diff == 0 ? 'color: var(--text-secondary);' : '' }}">
                                                        {{ diff > 0 ? '+' : '' }}{{ diff }}
                                                    </span>
                                                </td>
                                            </tr>
                                        {% else %}
                                            <tr>
                                                <td colspan="7" class="px-4 py-8 text-center" style="color: var(--text-secondary);">
                                                    {{ 'groups.no_matches_in_group'|trans }}
                                                </td>
                                            </tr>
                                        {% endfor %}
                                    </tbody>
                                </table>
                            </div>
                            {% if tournament.qualifiersPerGroup %}
                                <div class="px-6 py-3 border-t text-sm" style="background-color: var(--color-primary-50); border-color: var(--color-primary-200); color: var(--color-primary-700);">
                                    {{ ux_icon('lucide:info', {class: 'w-4 h-4 inline mr-1'}) }}
                                    {{ 'groups.qualifiers_info'|trans({'%count%': tournament.qualifiersPerGroup}) }}
                                </div>
                            {% endif %}
                        </div>

                        {# Matches list for this group #}
                        <div class="rounded-xl shadow-lg overflow-hidden" style="background-color: var(--card-bg);">
                            <div class="px-6 py-4 border-b" style="background-color: var(--bg-subtle); border-color: var(--border-muted);">
                                <h3 class="text-lg font-bold flex items-center" style="color: var(--text-primary);">
                                    {{ ux_icon('lucide:swords', {class: 'w-5 h-5 mr-2 text-blue-500'}) }}
                                    {{ 'common.matches'|trans }}
                                </h3>
                            </div>
                            <div class="divide-y max-h-96 overflow-y-auto" style="divide-color: var(--border-muted);">
                                {% for match in groupMatches[group.letter]|default([]) %}
                                    <div class="px-4 py-3 hover:bg-black/5 dark:hover:bg-white/5 transition-colors">
                                        <div class="flex items-center justify-between text-sm">
                                            <span class="font-medium" style="color: {{ match.isCompleted and match.winner == match.player1 ? 'var(--color-primary-600)' : 'var(--text-primary)' }};">
                                                {{ match.player1.player.displayName }}
                                            </span>
                                            {% if match.isCompleted %}
                                                <span class="px-2 py-1 rounded text-xs font-mono" style="background-color: var(--bg-muted); color: var(--text-primary);">
                                                    {{ match.player1Score }} - {{ match.player2Score }}
                                                </span>
                                            {% else %}
                                                <span class="text-xs" style="color: var(--text-muted);">vs</span>
                                            {% endif %}
                                            <span class="font-medium" style="color: {{ match.isCompleted and match.winner == match.player2 ? 'var(--color-primary-600)' : 'var(--text-primary)' }};">
                                                {{ match.player2 ? match.player2.player.displayName : 'BYE' }}
                                            </span>
                                        </div>
                                        <div class="mt-1 text-xs" style="color: var(--text-muted);">
                                            {{ 'groups.round_table'|trans({'%round%': match.round.roundNumber, '%table%': match.tableNumber}) }}
                                        </div>
                                    </div>
                                {% else %}
                                    <div class="px-4 py-8 text-center" style="color: var(--text-secondary);">
                                        {{ 'groups.no_matches_generated'|trans }}
                                    </div>
                                {% endfor %}
                            </div>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    {% endif %}

    {# Back link #}
    <div class="mt-8">
        <a href="{{ path('tournament_show', {id: tournament.id}) }}" class="inline-flex items-center font-medium" style="color: var(--color-primary-600);">
            {{ ux_icon('lucide:arrow-left', {class: 'w-4 h-4 mr-2'}) }}
            {{ 'groups.back_to_tournament'|trans }}
        </a>
    </div>
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
(function() {
    function initGroupTabs() {
        const container = document.getElementById('groups-tabs');
        if (!container) return;

        // Use event delegation on the container
        container.addEventListener('click', function(e) {
            const tab = e.target.closest('.group-tab');
            if (!tab) return;

            e.preventDefault();
            e.stopPropagation();

            const index = tab.getAttribute('data-tab-index');
            if (index === null) return;

            const tabs = container.querySelectorAll('.group-tab');
            const panels = container.querySelectorAll('.group-panel');

            // Deactivate all tabs
            tabs.forEach(function(t) {
                t.style.borderColor = 'transparent';
                t.style.color = 'var(--text-secondary)';
                const badge = t.querySelector('.tab-badge');
                if (badge) {
                    badge.style.backgroundColor = 'var(--bg-muted)';
                    badge.style.color = 'var(--text-secondary)';
                }
            });

            // Activate clicked tab
            tab.style.borderColor = 'var(--color-primary-500)';
            tab.style.color = 'var(--color-primary-600)';
            const badge = tab.querySelector('.tab-badge');
            if (badge) {
                badge.style.backgroundColor = 'var(--color-primary-100)';
                badge.style.color = 'var(--color-primary-700)';
            }

            // Show/hide panels
            panels.forEach(function(p) {
                const panelIndex = p.getAttribute('data-panel-index');
                if (panelIndex === index) {
                    p.classList.remove('hidden');
                } else {
                    p.classList.add('hidden');
                }
            });
        });
    }

    // Initialize on DOMContentLoaded
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initGroupTabs);
    } else {
        initGroupTabs();
    }

    // Re-initialize on Turbo navigation (if Turbo is used)
    document.addEventListener('turbo:load', initGroupTabs);
})();
</script>
{% endblock %}
