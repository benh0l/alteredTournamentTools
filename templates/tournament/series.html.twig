{% extends 'base.html.twig' %}

{% block title %}{{ 'tournament.series.title'|trans }} - Altered Tournament Tools{% endblock %}

{% block body %}
<div class="max-w-4xl mx-auto py-8 px-4">
    <div class="flex items-center gap-3 mb-8">
        <div class="w-10 h-10 rounded-xl bg-purple-500/20 flex items-center justify-center">
            {{ ux_icon('lucide:repeat', {class: 'w-5 h-5 text-purple-600 dark:text-purple-400'}) }}
        </div>
        <div>
            <h1 class="text-2xl font-bold" style="color: var(--text-primary);">{{ 'tournament.series.title'|trans }}</h1>
            <p class="text-sm" style="color: var(--text-muted);">{{ 'tournament.series.subtitle'|trans({'%count%': tournaments|length}) }}</p>
        </div>
    </div>

    <div class="space-y-3">
        {% for tournament in tournaments %}
            <div class="border rounded-2xl p-5 flex items-center justify-between gap-4"
                 style="background-color: var(--card-bg); border-color: var(--border-default);">
                <div class="flex items-center gap-4 min-w-0">
                    <div class="w-10 h-10 rounded-xl flex items-center justify-center flex-shrink-0 text-sm font-bold"
                         style="background-color: var(--color-primary-100); color: var(--color-primary-600);">
                        {{ loop.index }}
                    </div>
                    <div class="min-w-0">
                        <div class="font-semibold truncate" style="color: var(--text-primary);">{{ tournament.name }}</div>
                        <div class="text-sm" style="color: var(--text-muted);">
                            {{ tournament.date|date('d/m/Y') }}
                            {% if tournament.time %}
                                {{ 'common.at'|trans }}
                                <time class="local-time" data-datetime="{{ tournament.date|date('Y-m-d') ~ 'T' ~ tournament.time|date('H:i:s') ~ tournament.date|date('P', 'Europe/Paris') }}">{{ tournament.time|date('H:i') }}</time>
                            {% endif %}
                            {% if tournament.location %}
                                · {{ tournament.location }}
                            {% endif %}
                        </div>
                    </div>
                </div>
                <div class="flex items-center gap-3 flex-shrink-0">
                    {% set statusColors = {
                        'draft':     'bg-gray-500/15 text-gray-600 dark:text-gray-300',
                        'published': 'bg-blue-500/15 text-blue-700 dark:text-blue-300',
                        'ongoing':   'bg-green-500/15 text-green-700 dark:text-green-300',
                        'completed': 'bg-purple-500/15 text-purple-700 dark:text-purple-300',
                        'cancelled': 'bg-red-500/15 text-red-700 dark:text-red-300',
                    } %}
                    <span class="px-2.5 py-1 rounded-full text-xs font-medium {{ statusColors[tournament.status.value]|default('bg-gray-500/15 text-gray-600') }}">
                        {{ ('enum.tournament_status.' ~ tournament.status.value)|trans }}
                    </span>
                    <a href="{{ path('tournament_show', {id: tournament.id}) }}"
                       class="px-3 py-1.5 rounded-lg text-sm font-medium transition-colors hover:opacity-80"
                       style="background-color: var(--color-primary-100); color: var(--color-primary-600);">
                        {{ 'action.view'|trans }}
                    </a>
                </div>
            </div>
        {% endfor %}
    </div>
</div>
{% endblock %}
