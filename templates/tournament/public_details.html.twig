{% extends 'base.html.twig' %}

{% block title %}{{ tournament.name }} - Tournoi Altered{% endblock %}

{% block og_title %}{{ tournament.name }}{% endblock %}
{% block og_description %}Tournoi {{ tournament.format.label|trans }} le {{ tournament.date|date('d/m/Y') }}{% if tournament.location %} a {{ tournament.location }}{% endif %}{% endblock %}

{% block meta %}
    {{ parent() }}
    <meta property="og:type" content="event">
    <meta property="og:url" content="{{ url('tournament_public_details', {id: tournament.id}) }}">
    <meta name="twitter:title" content="{{ tournament.name }}">
    <meta name="twitter:description" content="Tournoi {{ tournament.format.label|trans }} - {{ tournament.date|date('d/m/Y') }}">
{% endblock %}

{% block body %}
<div class="max-w-4xl mx-auto">
    {# Back navigation #}
    <div class="mb-6">
        <a href="{{ path('tournament_search') }}" class="hover:underline flex items-center" style="color: var(--color-primary-600);">
            {{ ux_icon('lucide:chevron-left', {class: 'w-5 h-5 mr-1'}) }}
            Retour a la recherche
        </a>
    </div>

    {# Main card #}
    <div class="border rounded-lg overflow-hidden shadow-sm" style="background-color: var(--card-bg); border-color: var(--border-default);">
        {# Header #}
        <div class="p-6 border-b bg-gradient-to-r from-blue-600 to-blue-700 text-white">
            <div class="flex items-start justify-between">
                <div>
                    <h1 class="text-2xl md:text-3xl font-bold mb-2">{{ tournament.name }}</h1>
                    <div class="flex flex-wrap items-center gap-3">
                        <span class="px-3 py-1 rounded-full text-sm font-medium
                            {% if tournament.format.value starts with 'constructed' %}
                                bg-blue-500 text-white
                            {% else %}
                                bg-purple-500 text-white
                            {% endif %}">
                            {{ tournament.format.label|trans }}
                        </span>
                        <span class="px-3 py-1 rounded-full text-sm font-medium bg-white/20">
                            {{ tournament.structure.label|trans }}
                        </span>
                    </div>
                </div>
                <div class="text-right">
                    <p class="text-2xl font-bold">{{ tournament.date|date('d/m/Y') }}</p>
                    {% if tournament.time %}
                    <p class="text-blue-100">{{ tournament.time|date('H:i') }}</p>
                    {% endif %}
                </div>
            </div>
        </div>

        {# Body #}
        <div class="p-6 space-y-6">
            {# Location #}
            {% if tournament.location %}
            <div class="flex items-start">
                <div class="w-10 h-10 rounded-full bg-blue-500/20 flex items-center justify-center mr-4 flex-shrink-0">
                    {{ ux_icon('lucide:map-pin', {class: 'w-5 h-5 text-blue-500'}) }}
                </div>
                <div>
                    <h3 class="font-medium" style="color: var(--text-primary);">Lieu</h3>
                    <p style="color: var(--text-secondary);">{{ tournament.location }}</p>
                    {% if tournament.hasCoordinates %}
                    <a href="https://www.google.com/maps/search/?api=1&query={{ tournament.latitude }},{{ tournament.longitude }}"
                       target="_blank"
                       rel="noopener noreferrer"
                       class="hover:underline text-sm mt-1 inline-flex items-center" style="color: var(--color-primary-600);">
                        Ouvrir dans Google Maps
                        {{ ux_icon('lucide:external-link', {class: 'w-4 h-4 ml-1'}) }}
                    </a>
                    {% endif %}
                </div>
            </div>
            {% endif %}

            {# Registration info #}
            <div class="flex items-start">
                <div class="w-10 h-10 rounded-full bg-green-500/20 flex items-center justify-center mr-4 flex-shrink-0">
                    {{ ux_icon('lucide:users', {class: 'w-5 h-5 text-green-500'}) }}
                </div>
                <div>
                    <h3 class="font-medium" style="color: var(--text-primary);">Inscriptions</h3>
                    <p style="color: var(--text-secondary);">
                        {{ tournament.registrationCount }} joueur{% if tournament.registrationCount > 1 %}s{% endif %} inscrit{% if tournament.registrationCount > 1 %}s{% endif %}
                        {% if tournament.maxPlayers %}
                            / {{ tournament.maxPlayers }} places
                        {% endif %}
                    </p>
                    {% if tournament.registrationsClosed %}
                        <span class="inline-block mt-1 px-2 py-1 text-xs font-medium bg-red-500/20 text-red-600 dark:text-red-400 rounded">
                            Inscriptions fermees
                        </span>
                    {% elseif tournament.acceptsRegistrations %}
                        <span class="inline-block mt-1 px-2 py-1 text-xs font-medium bg-green-500/20 text-green-600 dark:text-green-400 rounded">
                            Inscriptions ouvertes
                        </span>
                    {% endif %}
                </div>
            </div>

            {# Entry fee #}
            {% if tournament.entryFee %}
            <div class="flex items-start">
                <div class="w-10 h-10 rounded-full bg-yellow-500/20 flex items-center justify-center mr-4 flex-shrink-0">
                    {{ ux_icon('lucide:circle-dollar-sign', {class: 'w-5 h-5 text-yellow-500'}) }}
                </div>
                <div>
                    <h3 class="font-medium" style="color: var(--text-primary);">Participation (PAF)</h3>
                    <p style="color: var(--text-secondary);">{{ tournament.entryFee }}</p>
                </div>
            </div>
            {% endif %}

            {# Prizes #}
            {% if tournament.prizes %}
            <div class="flex items-start">
                <div class="w-10 h-10 rounded-full bg-purple-500/20 flex items-center justify-center mr-4 flex-shrink-0">
                    {{ ux_icon('lucide:gift', {class: 'w-5 h-5 text-purple-500'}) }}
                </div>
                <div>
                    <h3 class="font-medium" style="color: var(--text-primary);">Lots</h3>
                    <p class="whitespace-pre-line" style="color: var(--text-secondary);">{{ tournament.prizes }}</p>
                </div>
            </div>
            {% endif %}

            {# Description #}
            {% if tournament.description %}
            <div class="flex items-start">
                <div class="w-10 h-10 rounded-full flex items-center justify-center mr-4 flex-shrink-0" style="background-color: var(--bg-subtle);">
                    {{ ux_icon('lucide:align-left', {class: 'w-5 h-5', style: 'color: var(--text-secondary);'}) }}
                </div>
                <div>
                    <h3 class="font-medium" style="color: var(--text-primary);">Description</h3>
                    <p class="whitespace-pre-line" style="color: var(--text-secondary);">{{ tournament.description }}</p>
                </div>
            </div>
            {% endif %}

            {# Tournament format details #}
            <div class="flex items-start">
                <div class="w-10 h-10 rounded-full bg-indigo-500/20 flex items-center justify-center mr-4 flex-shrink-0">
                    {{ ux_icon('lucide:clipboard-list', {class: 'w-5 h-5 text-indigo-500'}) }}
                </div>
                <div>
                    <h3 class="font-medium" style="color: var(--text-primary);">Format du tournoi</h3>
                    <ul class="space-y-1" style="color: var(--text-secondary);">
                        <li>Structure: {{ tournament.structure.label|trans }}</li>
                        <li>Format Swiss: {{ tournament.swissMatchFormat.label|trans }}</li>
                        {% if tournament.eliminationMatchFormat %}
                        <li>Format Elimination: {{ tournament.eliminationMatchFormat.label|trans }}</li>
                        {% endif %}
                        {% if tournament.swissRounds %}
                        <li>Rondes Swiss prevues: {{ tournament.swissRounds }}</li>
                        {% endif %}
                        {% if tournament.topCutSize %}
                        <li>Top Cut: {{ tournament.topCutSize }}</li>
                        {% endif %}
                    </ul>
                </div>
            </div>

            {# Organizer #}
            <div class="flex items-start">
                <div class="w-10 h-10 rounded-full bg-orange-500/20 flex items-center justify-center mr-4 flex-shrink-0">
                    {{ ux_icon('lucide:user', {class: 'w-5 h-5 text-orange-500'}) }}
                </div>
                <div>
                    <h3 class="font-medium" style="color: var(--text-primary);">Organisateur</h3>
                    <p style="color: var(--text-secondary);">{{ tournament.organizer.pseudo }}</p>
                </div>
            </div>

            {# Altered.gg link #}
            {% if tournament.alteredGgLink %}
            <div class="flex items-start">
                <div class="w-10 h-10 rounded-full bg-red-500/20 flex items-center justify-center mr-4 flex-shrink-0">
                    {{ ux_icon('lucide:link', {class: 'w-5 h-5 text-red-500'}) }}
                </div>
                <div>
                    <h3 class="font-medium" style="color: var(--text-primary);">Lien Altered.gg</h3>
                    <a href="{{ tournament.alteredGgLink }}"
                       target="_blank"
                       rel="noopener noreferrer"
                       class="hover:underline" style="color: var(--color-primary-600);">
                        {{ tournament.alteredGgLink }}
                    </a>
                </div>
            </div>
            {% endif %}
        </div>

        {# Map #}
        {% if tournament.hasCoordinates %}
        <div class="border-t">
            <div id="tournament-map"
                 class="h-64"
                 data-controller="map"
                 data-map-center-lat-value="{{ tournament.latitude }}"
                 data-map-center-lng-value="{{ tournament.longitude }}"
                 data-map-tournaments-value="{{ [{
                     id: tournament.id,
                     name: tournament.name,
                     date: tournament.date|date('d/m/Y'),
                     format: tournament.format.label|trans,
                     location: tournament.location,
                     lat: tournament.latitude,
                     lng: tournament.longitude
                 }]|json_encode|e('html_attr') }}">
            </div>
        </div>
        {% endif %}

        {# Actions footer #}
        <div class="p-6 border-t" style="background-color: var(--bg-subtle); border-color: var(--border-default);">
            <div class="flex flex-col sm:flex-row items-center justify-between gap-4">
                {# Share button #}
                <div class="flex items-center gap-3" data-controller="share">
                    <span class="text-sm" style="color: var(--text-secondary);">Partager:</span>
                    <button type="button"
                            class="p-2 rounded-full hover:opacity-80 transition-colors" style="background-color: var(--border-default);"
                            title="Copier le lien"
                            data-action="click->share#copyLink"
                            data-share-url-value="{{ url('tournament_public_details', {id: tournament.id}) }}">
                        {{ ux_icon('lucide:copy', {class: 'w-5 h-5'}) }}
                    </button>
                    <a href="https://twitter.com/intent/tweet?text={{ ('Rejoignez le tournoi ' ~ tournament.name ~ ' le ' ~ tournament.date|date('d/m/Y'))|url_encode }}&url={{ url('tournament_public_details', {id: tournament.id})|url_encode }}"
                       target="_blank"
                       rel="noopener noreferrer"
                       class="p-2 rounded-full bg-blue-500/20 hover:bg-blue-500/30 transition-colors"
                       title="Partager sur Twitter">
                        <svg class="w-5 h-5 text-blue-500" fill="currentColor" viewBox="0 0 24 24">
                            <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"></path>
                        </svg>
                    </a>
                    <a href="https://www.facebook.com/sharer/sharer.php?u={{ url('tournament_public_details', {id: tournament.id})|url_encode }}"
                       target="_blank"
                       rel="noopener noreferrer"
                       class="p-2 rounded-full bg-blue-500/20 hover:bg-blue-500/30 transition-colors"
                       title="Partager sur Facebook">
                        <svg class="w-5 h-5 text-blue-600" fill="currentColor" viewBox="0 0 24 24">
                            <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"></path>
                        </svg>
                    </a>
                    <a href="https://api.whatsapp.com/send?text={{ ('Rejoignez le tournoi ' ~ tournament.name ~ ' le ' ~ tournament.date|date('d/m/Y') ~ ' ' ~ url('tournament_public_details', {id: tournament.id}))|url_encode }}"
                       target="_blank"
                       rel="noopener noreferrer"
                       class="p-2 rounded-full bg-green-500/20 hover:bg-green-500/30 transition-colors"
                       title="Partager sur WhatsApp">
                        <svg class="w-5 h-5 text-green-600" fill="currentColor" viewBox="0 0 24 24">
                            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"></path>
                        </svg>
                    </a>
                </div>

                {# Registration button #}
                <div>
                    {% if is_registered %}
                        <div class="flex items-center space-x-4">
                            <span class="inline-flex items-center px-4 py-2 bg-green-500/20 text-green-600 dark:text-green-400 rounded-lg font-medium">
                                {{ ux_icon('lucide:check', {class: 'w-5 h-5 mr-2'}) }}
                                Vous etes inscrit
                            </span>
                            <a href="{{ path('tournament_registration_edit', {'id': tournament.id}) }}"
                               class="inline-flex items-center text-sm font-medium hover:opacity-80"
                               style="color: var(--color-primary-600);">
                                {{ ux_icon('lucide:edit', {class: 'w-4 h-4 mr-1'}) }}
                                Modifier
                            </a>
                        </div>
                    {% elseif can_register %}
                        {% if user %}
                            <a href="{{ path('tournament_register', {id: tournament.id}) }}"
                               class="inline-flex items-center min-h-touch px-6 py-3 text-white font-semibold rounded-xl shadow-md hover:shadow-lg transition-all"
                               style="background: linear-gradient(135deg, var(--color-primary-500), var(--color-accent-500));">
                                {{ ux_icon('lucide:user-plus', {class: 'w-5 h-5 mr-2'}) }}
                                S'inscrire au tournoi
                            </a>
                        {% else %}
                            <a href="{{ path('app_login') }}?redirect={{ path('tournament_public_details', {id: tournament.id})|url_encode }}"
                               class="inline-flex items-center min-h-touch px-6 py-3 text-white font-semibold rounded-xl shadow-md hover:shadow-lg transition-all"
                               style="background: linear-gradient(135deg, var(--color-primary-500), var(--color-accent-500));">
                                {{ ux_icon('lucide:log-in', {class: 'w-5 h-5 mr-2'}) }}
                                Se connecter pour s'inscrire
                            </a>
                        {% endif %}
                    {% else %}
                        <span class="inline-flex items-center px-4 py-2 rounded-lg font-medium" style="background-color: var(--bg-subtle); color: var(--text-secondary);">
                            {% if tournament.registrationsClosed %}
                                Inscriptions fermees
                            {% elseif not tournament.hasAvailableSpots %}
                                Complet
                            {% else %}
                                Inscriptions non disponibles
                            {% endif %}
                        </span>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>

{% block javascripts %}
{{ parent() }}
<script>
// Share controller - copy link functionality
document.addEventListener('DOMContentLoaded', function() {
    document.querySelectorAll('[data-action="click->share#copyLink"]').forEach(button => {
        button.addEventListener('click', async function() {
            const url = this.dataset.shareUrlValue;
            try {
                await navigator.clipboard.writeText(url);
                // Show feedback
                const originalContent = this.innerHTML;
                this.innerHTML = '<svg class="w-5 h-5 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>';
                setTimeout(() => {
                    this.innerHTML = originalContent;
                }, 2000);
            } catch (err) {
                console.error('Failed to copy:', err);
            }
        });
    });
});
</script>
{% endblock %}
{% endblock %}
