{% extends 'base.html.twig' %}

{% block title %}{{ tournament.name }} - Altered Tournament Tools{% endblock %}

{% block body %}
<div class="max-w-5xl mx-auto">
    {# Header Card with gradient #}
    <div class="rounded-2xl shadow-xl overflow-hidden mb-8" style="background-color: var(--card-bg);">
        <div class="theme-header-gradient px-8 py-6">
            <div class="flex flex-col md:flex-row md:items-center md:justify-between">
                <div>
                    <h1 class="text-3xl font-bold text-white drop-shadow-sm">{{ tournament.name }}</h1>
                    <div class="mt-3 flex items-center space-x-3">
                        {# Status Badge #}
                        <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-white/20 text-white backdrop-blur-sm">
                            {{ ('enum.tournament_status.' ~ tournament.status.value)|trans }}
                        </span>

                        {# Visibility Badge #}
                        {% if tournament.visibility.value == 'private' %}
                            <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-yellow-400/30 text-white">
                                {{ ux_icon('lucide:lock', {class: 'w-3 h-3 mr-1'}) }}
                                {{ 'enum.tournament_visibility.private'|trans }}
                            </span>
                        {% endif %}
                    </div>
                </div>

                {# Quick info on header #}
                <div class="mt-4 md:mt-0 flex items-center space-x-6 text-white/90">
                    <div class="text-center">
                        <div class="text-2xl font-bold">{{ tournament.registrations|length }}</div>
                        <div class="text-xs uppercase tracking-wide">{{ 'common.players'|trans }}</div>
                    </div>
                    <div class="text-center">
                        <div class="text-2xl font-bold">{{ tournament.date|date('d/m') }}</div>
                        <div class="text-xs uppercase tracking-wide">{{ 'common.date'|trans }}</div>
                    </div>
                </div>
            </div>
        </div>

        {# Action buttons for organizer #}
        {% if is_granted('TOURNAMENT_MANAGE', tournament) %}
            <div class="px-8 py-4 border-t" style="background-color: var(--bg-subtle); border-color: var(--border-muted);">
                <div class="flex flex-wrap gap-3 items-center">
                    {% if is_granted('TOURNAMENT_EDIT', tournament) %}
                        <a href="{{ path('tournament_edit', {id: tournament.id}) }}"
                           class="inline-flex items-center px-4 py-2 border-2 rounded-xl font-medium transition-all shadow-sm" style="background-color: var(--card-bg); border-color: var(--color-primary-200); color: var(--color-primary-600);">
                            {{ ux_icon('lucide:pencil', {class: 'w-4 h-4 mr-2'}) }}
                            {{ 'action.edit'|trans }}
                        </a>
                        <form action="{{ path('tournament_publish', {id: tournament.id}) }}" method="POST" class="inline">
                            <input type="hidden" name="_token" value="{{ csrf_token('publish-tournament-' ~ tournament.id) }}">
                            <button type="submit"
                                    class="inline-flex items-center px-4 py-2 rounded-xl font-medium transition-all shadow-md text-white"
                                    style="background: linear-gradient(135deg, var(--color-primary-500), var(--color-accent-500));"
                                    onclick="return confirm('{{ 'tournament.manage.publish_confirm'|trans }}')">
                                {{ ux_icon('lucide:eye', {class: 'w-4 h-4 mr-2'}) }}
                                {{ 'tournament.manage.publish'|trans }}
                            </button>
                        </form>
                    {% endif %}

                    {% if is_granted('TOURNAMENT_DELETE', tournament) %}
                        <form action="{{ path('tournament_delete', {id: tournament.id}) }}" method="POST" class="inline">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete-tournament-' ~ tournament.id) }}">
                            <button type="submit"
                                    class="inline-flex items-center px-4 py-2 bg-gradient-to-r from-red-500 to-rose-500 text-white rounded-xl font-medium hover:from-red-600 hover:to-rose-600 transition-all shadow-md"
                                    onclick="return confirm('{{ 'tournament.manage.delete_confirm'|trans }}')">
                                {{ ux_icon('lucide:trash-2', {class: 'w-4 h-4 mr-2'}) }}
                                {{ 'action.delete'|trans }}
                            </button>
                        </form>
                    {% endif %}

                    {% if not tournament.draft and is_granted('TOURNAMENT_MANAGE_REGISTRATIONS', tournament) %}
                        <a href="{{ path('tournament_registrations', {id: tournament.id}) }}"
                           class="inline-flex items-center px-4 py-2 border-2 border-amber-500/30 text-amber-600 dark:text-amber-400 rounded-xl font-medium hover:bg-amber-500/10 hover:border-amber-500/50 transition-all shadow-sm" style="background-color: var(--card-bg);">
                            {{ ux_icon('lucide:users', {class: 'w-4 h-4 mr-2'}) }}
                            {{ 'tournament.manage.manage_registrations'|trans }}
                        </a>
                    {% endif %}

                    {# Start tournament button #}
                    {% if tournament.status.value == 'published' and not tournament.hasRounds %}
                        {% if tournament.registrations|length >= 2 %}
                            {% if tournament.hasGroupStage %}
                                {# GROUP_STAGE_ELIMINATION: go to groups page #}
                                <a href="{{ path('tournament_groups', {id: tournament.id}) }}"
                                   class="inline-flex items-center px-5 py-2 bg-gradient-to-r from-green-500 to-emerald-500 text-white rounded-xl font-semibold hover:from-green-600 hover:to-emerald-600 transition-all shadow-md">
                                    {{ ux_icon('lucide:layout-grid', {class: 'w-5 h-5 mr-2'}) }}
                                    {{ 'tournament.manage.manage_groups'|trans }}
                                </a>
                            {% else %}
                                <form action="{{ path('round_start_first', {id: tournament.id}) }}" method="POST" class="inline">
                                    <input type="hidden" name="_token" value="{{ csrf_token('start-first-round-' ~ tournament.id) }}">
                                    <input type="hidden" name="pairing_mode" value="random">
                                    <button type="submit"
                                            class="inline-flex items-center px-5 py-2 bg-gradient-to-r from-emerald-500 to-teal-500 text-white rounded-xl font-semibold hover:from-emerald-600 hover:to-teal-600 transition-all shadow-md"
                                            onclick="return confirm('{{ 'tournament.manage.start_confirm'|trans }}')">
                                        {{ ux_icon('lucide:play-circle', {class: 'w-5 h-5 mr-2'}) }}
                                        {{ 'tournament.manage.start_tournament'|trans }}
                                    </button>
                                </form>
                            {% endif %}
                        {% else %}
                            <span class="inline-flex items-center px-4 py-2 bg-amber-500/20 text-amber-600 dark:text-amber-400 rounded-xl text-sm">
                                {{ ux_icon('lucide:alert-triangle', {class: 'w-4 h-4 mr-2'}) }}
                                {{ 'tournament.manage.min_players'|trans({'%count%': 2}) }}
                            </span>
                        {% endif %}
                    {% endif %}

                    {# Dashboard link for ongoing tournaments #}
                    {% if tournament.status.value == 'ongoing' %}
                        <a href="{{ path('tournament_dashboard', {id: tournament.id}) }}"
                           class="inline-flex items-center px-5 py-2 bg-gradient-to-r from-blue-500 to-cyan-500 text-white rounded-xl font-semibold hover:from-blue-600 hover:to-cyan-600 transition-all shadow-md">
                            {{ ux_icon('lucide:bar-chart-3', {class: 'w-5 h-5 mr-2'}) }}
                            {{ 'dashboard.title'|trans }}
                        </a>
                    {% endif %}

                    {% if tournament.hasRounds %}
                        <span class="inline-flex items-center px-3 py-2 rounded-xl text-sm" style="background-color: var(--bg-subtle); color: var(--text-muted);">
                            {{ ux_icon('lucide:lock', {class: 'w-4 h-4 mr-1'}) }}
                            {{ 'tournament.manage.config_locked'|trans }}
                        </span>
                    {% endif %}
                </div>
            </div>
        {% endif %}
    </div>

    {# Completed Tournament Results Banner #}
    {% if tournament.status.value == 'completed' %}
        <div class="rounded-xl shadow-lg overflow-hidden mb-8 border-2 border-emerald-500/30" style="background-color: var(--card-bg);">
            <div class="px-6 py-4" style="background: linear-gradient(to right, rgb(16 185 129 / 0.15), rgb(20 184 166 / 0.1));">
                <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
                    <div class="flex items-center space-x-3">
                        {{ ux_icon('lucide:trophy', {class: 'w-8 h-8 text-emerald-500'}) }}
                        <div>
                            <h2 class="text-lg font-bold text-emerald-700 dark:text-emerald-400">{{ 'tournament.completed.title'|trans }}</h2>
                            {% if tournament.completedAt %}
                                <p class="text-sm text-emerald-600 dark:text-emerald-500">
                                    {{ tournament.completedAt|date('d/m/Y') }} - {{ tournament.completedRoundsCount }} {{ tournament.completedRoundsCount > 1 ? 'common.rounds'|trans : 'common.round'|trans }}
                                </p>
                            {% endif %}
                        </div>
                    </div>
                    <div class="flex flex-wrap gap-3">
                        <a href="{{ path('tournament_final_standings', {id: tournament.id}) }}"
                           class="inline-flex items-center px-5 py-2 bg-gradient-to-r from-emerald-500 to-teal-500 text-white rounded-xl font-semibold hover:from-emerald-600 hover:to-teal-600 transition-all shadow-md">
                            {{ ux_icon('lucide:list-ordered', {class: 'w-5 h-5 mr-2'}) }}
                            {{ 'tournament.completed.final_standings'|trans }}
                        </a>
                        <a href="{{ path('tournament_podium', {id: tournament.id}) }}"
                           class="inline-flex items-center px-5 py-2 bg-gradient-to-r from-amber-500 to-yellow-500 text-white rounded-xl font-semibold hover:from-amber-600 hover:to-yellow-600 transition-all shadow-md">
                            {{ ux_icon('lucide:medal', {class: 'w-5 h-5 mr-2'}) }}
                            {{ 'tournament.completed.podium'|trans }}
                        </a>
                        <a href="{{ path('tournament_stats', {id: tournament.id}) }}"
                           class="inline-flex items-center px-4 py-2 border-2 rounded-xl font-medium transition-all" style="background-color: var(--card-bg); border-color: var(--border-default); color: var(--text-secondary);">
                            {{ ux_icon('lucide:bar-chart-3', {class: 'w-4 h-4 mr-2'}) }}
                            {{ 'tournament.completed.statistics'|trans }}
                        </a>
                        <a href="{{ path('tournament_dashboard', {id: tournament.id}) }}"
                           class="inline-flex items-center px-4 py-2 border-2 rounded-xl font-medium transition-all" style="background-color: var(--card-bg); border-color: var(--border-default); color: var(--text-secondary);">
                            {{ ux_icon('lucide:layout-dashboard', {class: 'w-4 h-4 mr-2'}) }}
                            {{ 'dashboard.title'|trans }}
                        </a>
                    </div>
                </div>
            </div>
        </div>
    {% endif %}

    {# Ongoing Tournament Banner for non-organizers #}
    {% if tournament.status.value == 'ongoing' and not is_granted('TOURNAMENT_MANAGE', tournament) and is_granted('TOURNAMENT_VIEW_DASHBOARD', tournament) %}
        <div class="rounded-xl shadow-lg overflow-hidden mb-8 border-2 border-blue-500/30" style="background-color: var(--card-bg);">
            <div class="px-6 py-4" style="background: linear-gradient(to right, rgb(59 130 246 / 0.15), rgb(6 182 212 / 0.1));">
                <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
                    <div class="flex items-center space-x-3">
                        {{ ux_icon('lucide:play-circle', {class: 'w-8 h-8 text-blue-500'}) }}
                        <div>
                            <h2 class="text-lg font-bold text-blue-700 dark:text-blue-400">{{ 'tournament.ongoing.title'|trans }}</h2>
                            <p class="text-sm text-blue-600 dark:text-blue-500">
                                {{ 'tournament.ongoing.follow_realtime'|trans }}
                            </p>
                        </div>
                    </div>
                    <div class="flex flex-wrap gap-3">
                        <a href="{{ path('tournament_dashboard', {id: tournament.id}) }}"
                           class="inline-flex items-center px-5 py-2 bg-gradient-to-r from-blue-500 to-cyan-500 text-white rounded-xl font-semibold hover:from-blue-600 hover:to-cyan-600 transition-all shadow-md">
                            {{ ux_icon('lucide:layout-dashboard', {class: 'w-5 h-5 mr-2'}) }}
                            {{ 'tournament.ongoing.view_dashboard'|trans }}
                        </a>
                    </div>
                </div>
            </div>
        </div>
    {% endif %}

    <div class="space-y-6">
        {# Main content #}
        <div class="space-y-6">
            {# Basic Info Card #}
            <div class="rounded-xl shadow-lg border-l-4 overflow-hidden" style="background-color: var(--card-bg); border-color: var(--color-primary-400);">
                <div class="px-6 py-4 border-b" style="background: linear-gradient(to right, var(--color-primary-500) / 0.1, transparent); border-color: var(--border-muted);">
                    <h2 class="text-lg font-bold flex items-center" style="color: var(--text-primary);">
                        {{ ux_icon('lucide:info', {class: 'w-5 h-5 mr-2', style: 'color: var(--color-primary-500);'}) }}
                        {{ 'tournament.show.information'|trans }}
                    </h2>
                </div>
                <div class="p-6">
                    <dl class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                        <div class="flex items-start space-x-3">
                            <div class="w-10 h-10 rounded-lg flex items-center justify-center flex-shrink-0 bg-[var(--color-primary-500)]/20">
                                {{ ux_icon('lucide:calendar', {class: 'w-5 h-5', style: 'color: var(--color-primary-500);'}) }}
                            </div>
                            <div>
                                <dt class="text-sm font-medium" style="color: var(--text-muted);">{{ 'common.date'|trans }}</dt>
                                <dd class="text-base font-semibold" style="color: var(--text-primary);">
                                    {{ tournament.date|date('d/m/Y') }}
                                    {% if tournament.time %} {{ 'common.at'|trans }} {{ tournament.time|date('H:i') }}{% endif %}
                                </dd>
                            </div>
                        </div>
                        {% if tournament.location %}
                            <div class="flex items-start space-x-3">
                                <div class="w-10 h-10 bg-amber-500/20 rounded-lg flex items-center justify-center flex-shrink-0">
                                    {{ ux_icon('lucide:map-pin', {class: 'w-5 h-5 text-amber-500'}) }}
                                </div>
                                <div>
                                    <dt class="text-sm font-medium" style="color: var(--text-muted);">{{ 'common.location'|trans }}</dt>
                                    <dd class="text-base font-semibold" style="color: var(--text-primary);">{{ tournament.location }}</dd>
                                </div>
                            </div>
                        {% endif %}
                        <div class="flex items-start space-x-3">
                            <div class="w-10 h-10 bg-rose-500/20 rounded-lg flex items-center justify-center flex-shrink-0">
                                {{ ux_icon('lucide:user', {class: 'w-5 h-5 text-rose-500'}) }}
                            </div>
                            <div>
                                <dt class="text-sm font-medium" style="color: var(--text-muted);">{{ 'common.organizer'|trans }}</dt>
                                <dd class="text-base font-semibold" style="color: var(--text-primary);">{{ tournament.organizer.displayName }}</dd>
                            </div>
                        </div>
                        {% if tournament.entryFee %}
                            <div class="flex items-start space-x-3">
                                <div class="w-10 h-10 bg-emerald-500/20 rounded-lg flex items-center justify-center flex-shrink-0">
                                    {{ ux_icon('lucide:circle-dollar-sign', {class: 'w-5 h-5 text-emerald-500'}) }}
                                </div>
                                <div>
                                    <dt class="text-sm font-medium" style="color: var(--text-muted);">{{ 'tournament.show.entry_fee'|trans }}</dt>
                                    <dd class="text-base font-semibold" style="color: var(--text-primary);">{{ tournament.entryFee }}</dd>
                                </div>
                            </div>
                        {% endif %}
                    </dl>

                    {% if tournament.description %}
                        <div class="mt-6 pt-6 border-t" style="border-color: var(--border-muted);">
                            <h3 class="text-sm font-semibold mb-3" style="color: var(--text-secondary);">{{ 'common.description'|trans }}</h3>
                            <p class="whitespace-pre-wrap leading-relaxed" style="color: var(--text-secondary);">{{ tournament.description }}</p>
                        </div>
                    {% endif %}

                    {% if tournament.prizes %}
                        <div class="mt-6 pt-6 border-t" style="border-color: var(--border-muted);">
                            <h3 class="text-sm font-semibold mb-3 flex items-center" style="color: var(--text-secondary);">
                                {{ ux_icon('lucide:trophy', {class: 'w-4 h-4 mr-2 text-amber-500'}) }}
                                {{ 'tournament.show.prizes'|trans }}
                            </h3>
                            <p class="whitespace-pre-wrap" style="color: var(--text-secondary);">{{ tournament.prizes }}</p>
                        </div>
                    {% endif %}

                    {% if tournament.alteredGgLink %}
                        <div class="mt-6 pt-6 border-t" style="border-color: var(--border-muted);">
                            <a href="{{ tournament.alteredGgLink }}" target="_blank" rel="noopener noreferrer"
                               class="inline-flex items-center font-medium hover:opacity-80" style="color: var(--color-primary-600);">
                                {{ ux_icon('lucide:external-link', {class: 'w-4 h-4 mr-2'}) }}
                                {{ 'tournament.show.view_on_altered'|trans }}
                            </a>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>

        {# Tournament Configuration Card #}
        <div class="rounded-xl shadow-lg border-l-4 border-amber-400 overflow-hidden" style="background-color: var(--card-bg);">
            <div class="px-6 py-4 border-b" style="background: linear-gradient(to right, rgb(245 158 11 / 0.1), transparent); border-color: var(--border-muted);">
                <h2 class="text-lg font-bold flex items-center" style="color: var(--text-primary);">
                    {{ ux_icon('lucide:settings', {class: 'w-5 h-5 mr-2 text-amber-500'}) }}
                    {{ 'tournament.show.configuration'|trans }}
                </h2>
            </div>
                <div class="p-6">
                    <dl class="space-y-4">
                        <div class="flex justify-between items-center py-2 border-b" style="border-color: var(--border-muted);">
                            <dt class="text-sm" style="color: var(--text-muted);">{{ 'form.tournament.format'|trans }}</dt>
                            <dd class="text-sm font-semibold px-3 py-1 rounded-full" style="color: var(--color-primary-600); background: var(--color-primary-500) / 0.2;">{{ ('enum.tournament_format.' ~ tournament.format.value)|trans }}</dd>
                        </div>
                        <div class="flex justify-between items-center py-2 border-b" style="border-color: var(--border-muted);">
                            <dt class="text-sm" style="color: var(--text-muted);">{{ 'form.tournament.structure'|trans }}</dt>
                            <dd class="text-sm font-semibold" style="color: var(--text-primary);">{{ ('enum.tournament_structure.' ~ tournament.structure.value)|trans }}</dd>
                        </div>
                        {% if tournament.hasSwiss %}
                            <div class="flex justify-between items-center py-2 border-b" style="border-color: var(--border-muted);">
                                <dt class="text-sm" style="color: var(--text-muted);">{{ 'form.tournament.swiss_match_format'|trans }}</dt>
                                <dd class="text-sm font-semibold" style="color: var(--text-primary);">{{ ('enum.match_format.' ~ tournament.swissMatchFormat.value)|trans }}</dd>
                            </div>
                            {% if tournament.swissRounds %}
                                <div class="flex justify-between items-center py-2 border-b" style="border-color: var(--border-muted);">
                                    <dt class="text-sm" style="color: var(--text-muted);">{{ 'common.rounds'|trans }}</dt>
                                    <dd class="text-sm font-semibold" style="color: var(--text-primary);">{{ tournament.swissRounds }}</dd>
                                </div>
                            {% endif %}
                        {% endif %}
                        {% if tournament.hasElimination and tournament.topCutSize %}
                            <div class="flex justify-between items-center py-2 border-b" style="border-color: var(--border-muted);">
                                <dt class="text-sm" style="color: var(--text-muted);">{{ 'form.tournament.top_cut_size'|trans }}</dt>
                                <dd class="text-sm font-semibold" style="color: var(--text-primary);">Top {{ tournament.topCutSize }}</dd>
                            </div>
                        {% endif %}
                        {% if tournament.hasGroupStage %}
                            <div class="flex justify-between items-center py-2 border-b" style="border-color: var(--border-muted);">
                                <dt class="text-sm" style="color: var(--text-muted);">{{ 'tournament.wizard.step4.group_count'|trans }}</dt>
                                <dd class="text-sm font-semibold" style="color: var(--text-primary);">{{ tournament.groupCount }} x {{ tournament.playersPerGroup }} {{ 'common.players'|trans|lower }}</dd>
                            </div>
                            <div class="flex justify-between items-center py-2 border-b" style="border-color: var(--border-muted);">
                                <dt class="text-sm" style="color: var(--text-muted);">{{ 'tournament.wizard.step4.qualifiers_per_group'|trans }}</dt>
                                <dd class="text-sm font-semibold" style="color: var(--text-primary);">{{ tournament.qualifiersPerGroup }}/{{ 'tournament.group'|trans|default('poule') }} ({{ tournament.totalQualifiers }} total)</dd>
                            </div>
                        {% endif %}
                        <div class="flex justify-between items-center py-2">
                            <dt class="text-sm" style="color: var(--text-muted);">{{ 'form.tournament.decklist_transparency'|trans }}</dt>
                            <dd class="text-sm font-semibold" style="color: var(--text-primary);">{{ ('enum.decklist_transparency.' ~ tournament.decklistTransparency.value)|trans }}</dd>
                        </div>
                    </dl>
                </div>
            </div>

            {# Registration Card #}
            {% if not is_granted('TOURNAMENT_MANAGE', tournament) and tournament.status.value == 'published' %}
                <div class="rounded-xl shadow-lg border-l-4 border-emerald-400 overflow-hidden" style="background-color: var(--card-bg);">
                    <div class="px-6 py-4 border-b" style="background: linear-gradient(to right, rgb(16 185 129 / 0.1), transparent); border-color: var(--border-muted);">
                        <h2 class="text-lg font-bold" style="color: var(--text-primary);">{{ 'tournament.show.registration'|trans }}</h2>
                    </div>
                    <div class="p-6">
                        {% if app.user %}
                            {% if is_registered %}
                                <div class="flex items-center space-x-3 text-emerald-600 dark:text-emerald-400 mb-4 p-3 bg-emerald-500/20 rounded-lg">
                                    {{ ux_icon('lucide:check-circle', {class: 'w-6 h-6'}) }}
                                    <span class="font-semibold">{{ 'tournament.show.registered'|trans }}</span>
                                </div>

                                {# Check-in Section #}
                                {% if tournament.checkInEnabled %}
                                    <div class="mb-4 p-4 rounded-lg border" style="border-color: var(--border-default); background-color: var(--bg-subtle);">
                                        <h3 class="text-sm font-semibold mb-3 flex items-center" style="color: var(--text-secondary);">
                                            {{ ux_icon('lucide:user-check', {class: 'w-4 h-4 mr-2'}) }}
                                            {{ 'tournament.checkin.title'|trans }}
                                        </h3>

                                        {% if registration.isCheckedIn %}
                                            {# Already checked in #}
                                            <div class="flex items-center space-x-3 text-emerald-600 dark:text-emerald-400 p-3 bg-emerald-500/20 rounded-lg">
                                                {{ ux_icon('lucide:check-circle', {class: 'w-5 h-5'}) }}
                                                <div>
                                                    <span class="font-semibold">{{ 'tournament.checkin.confirmed'|trans }}</span>
                                                    {% if registration.checkedInAt %}
                                                        <span class="text-sm ml-1" style="color: var(--text-muted);">
                                                            ({{ registration.checkedInAt|date('H:i') }})
                                                        </span>
                                                    {% endif %}
                                                </div>
                                            </div>
                                        {% elseif tournament.checkInOpen %}
                                            {# Check-in is open, show button #}
                                            <div class="flex items-center space-x-3 text-amber-600 dark:text-amber-400 p-3 bg-amber-500/20 rounded-lg mb-3">
                                                {{ ux_icon('lucide:clock', {class: 'w-5 h-5'}) }}
                                                <span>{{ 'tournament.checkin.open_message'|trans }}</span>
                                            </div>
                                            <form action="{{ path('tournament_checkin', {id: tournament.id}) }}" method="POST">
                                                <input type="hidden" name="_token" value="{{ csrf_token('checkin-' ~ tournament.id) }}">
                                                <button type="submit"
                                                        class="w-full inline-flex items-center justify-center px-4 py-3 text-white rounded-xl font-semibold transition-all shadow-md"
                                                        style="background: linear-gradient(135deg, var(--color-primary-500), var(--color-accent-500));">
                                                    {{ ux_icon('lucide:user-check', {class: 'w-5 h-5 mr-2'}) }}
                                                    {{ 'tournament.checkin.button'|trans }}
                                                </button>
                                            </form>
                                        {% else %}
                                            {# Check-in enabled but not open yet #}
                                            <div class="flex items-center space-x-3 p-3 rounded-lg" style="color: var(--text-muted); background-color: var(--bg-subtle);">
                                                {{ ux_icon('lucide:clock', {class: 'w-5 h-5'}) }}
                                                <span>{{ 'tournament.checkin.not_open_yet'|trans }}</span>
                                            </div>
                                        {% endif %}
                                    </div>
                                {% endif %}

                                <div class="flex items-center justify-between">
                                    <a href="{{ path('tournament_registration_edit', {'id': tournament.id}) }}"
                                       class="inline-flex items-center text-sm font-medium hover:opacity-80"
                                       style="color: var(--color-primary-600);">
                                        {{ ux_icon('lucide:edit', {class: 'w-4 h-4 mr-1'}) }}
                                        {{ 'tournament.show.edit_registration'|trans }}
                                    </a>
                                    <form action="{{ path('tournament_unregister', {'id': tournament.id}) }}" method="POST" class="inline">
                                        <input type="hidden" name="_token" value="{{ csrf_token('unregister-' ~ tournament.id) }}">
                                        <button type="submit" class="text-sm text-red-600 hover:text-red-800 font-medium" onclick="return confirm('{{ 'tournament.show.unregister_confirm'|trans|default('Voulez-vous vraiment vous desinscrire?') }}')">
                                            {{ 'tournament.show.unregister'|trans }}
                                        </button>
                                    </form>
                                </div>
                            {% elseif tournament.registrationsClosed %}
                                <p style="color: var(--text-muted);">{{ 'tournament.show.registrations_closed'|trans }}</p>
                            {% else %}
                                <p class="mb-4" style="color: var(--text-secondary);">{{ 'tournament.show.registrations_open'|trans }}</p>
                                <a href="{{ path('tournament_register', {'id': tournament.id}) }}"
                                   class="block w-full text-center px-4 py-3 text-white rounded-xl font-semibold transition-all shadow-md"
                                   style="background: linear-gradient(135deg, var(--color-primary-500), var(--color-accent-500));">
                                    {{ 'tournament.show.register_btn'|trans }}
                                </a>
                            {% endif %}
                        {% else %}
                            {% if not tournament.registrationsClosed %}
                                <p class="mb-4" style="color: var(--text-secondary);">{{ 'tournament.show.registrations_open'|trans }}</p>
                                <a href="{{ path('app_login') }}"
                                   class="block w-full text-center px-4 py-3 text-white rounded-xl font-semibold transition-all shadow-md"
                                   style="background: linear-gradient(135deg, var(--color-primary-500), var(--color-accent-500));">
                                    {{ 'tournament.show.login_to_register'|trans }}
                                </a>
                            {% else %}
                                <p style="color: var(--text-muted);">{{ 'tournament.show.registrations_closed'|trans }}</p>
                            {% endif %}
                        {% endif %}
                    </div>
                </div>
            {% endif %}

            {# Registered Players Card #}
            <div class="rounded-xl shadow-lg border-l-4 border-rose-400 overflow-hidden" style="background-color: var(--card-bg);">
                <div class="px-6 py-4 border-b" style="background: linear-gradient(to right, rgb(244 63 94 / 0.1), transparent); border-color: var(--border-muted);">
                    <div class="flex justify-between items-center">
                        <h2 class="text-lg font-bold flex items-center" style="color: var(--text-primary);">
                            {{ ux_icon('lucide:users', {class: 'w-5 h-5 mr-2 text-rose-500'}) }}
                            {{ 'tournament.show.players_card.title'|trans }}
                        </h2>
                        <span class="bg-rose-500/20 text-rose-600 dark:text-rose-400 px-3 py-1 rounded-full text-sm font-bold">
                            {{ tournament.registrations|length }}{% if tournament.maxPlayers %}/{{ tournament.maxPlayers }}{% endif %}
                        </span>
                    </div>
                </div>
                <div class="p-6">
                    {% if tournament.registrations|length > 0 %}
                        <ul class="space-y-2 max-h-64 overflow-y-auto">
                            {% for registration in tournament.registrations %}
                                <li class="flex justify-between items-center py-2 px-3 rounded-lg transition-colors" style="background-color: var(--bg-subtle);">
                                    <div class="flex items-center space-x-3">
                                        {% if registration.player.avatar %}
                                            <img src="/uploads/avatars/{{ registration.player.avatar }}" alt="Avatar"
                                                 class="w-8 h-8 rounded-full object-cover">
                                        {% else %}
                                            <div class="w-8 h-8 bg-gradient-to-br from-orange-400 to-amber-400 rounded-full flex items-center justify-center">
                                                <span class="text-white font-semibold text-sm">{{ registration.player.pseudo|slice(0,1)|upper }}</span>
                                            </div>
                                        {% endif %}
                                        <span class="font-medium" style="color: var(--text-primary);">{{ registration.player.displayName }}</span>
                                    </div>
                                    <span class="text-xs" style="color: var(--text-muted);">{{ registration.registeredAt|date('d/m') }}</span>
                                </li>
                            {% endfor %}
                        </ul>
                    {% else %}
                        <p class="text-center py-4" style="color: var(--text-muted);">{{ 'tournament.show.players_card.no_players'|trans }}</p>
                    {% endif %}
                </div>
            </div>
    </div>

    {# Back link #}
    <div class="mt-8">
        <a href="{{ path('tournament_list') }}" class="inline-flex items-center font-medium hover:opacity-80" style="color: var(--color-primary-600);">
            {{ ux_icon('lucide:arrow-left', {class: 'w-4 h-4 mr-2'}) }}
            {{ 'tournament.show.back_to_list'|trans }}
        </a>
    </div>
</div>
{% endblock %}
