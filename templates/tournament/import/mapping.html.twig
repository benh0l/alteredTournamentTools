{% extends 'base.html.twig' %}

{% block title %}{{ 'import.mapping.title'|trans }} - {{ tournament.name }}{% endblock %}

{% block body %}
<div class="container mx-auto px-4 py-8 max-w-5xl">
    {# Header #}
    <div class="mb-8">
        <nav class="text-sm mb-2" style="color: var(--text-muted);">
            <a href="{{ path('tournament_show', {'id': tournament.id}) }}" class="hover:opacity-80" style="color: var(--text-secondary);">
                {{ tournament.name }}
            </a>
            <span class="mx-2">/</span>
            <a href="{{ path('tournament_registrations', {'id': tournament.id}) }}" class="hover:opacity-80" style="color: var(--text-secondary);">
                {{ 'tournament.registrations.breadcrumb'|trans }}
            </a>
            <span class="mx-2">/</span>
            <span>{{ 'import.mapping.breadcrumb'|trans }}</span>
        </nav>
        <h1 class="text-3xl font-bold" style="color: var(--text-primary);">{{ 'import.mapping.header'|trans }}</h1>
        <p class="mt-2" style="color: var(--text-muted);">{{ 'import.mapping.description'|trans({'%count%': totalRows}) }}</p>
    </div>

    <form action="{{ path('tournament_import_execute', {'id': tournament.id}) }}" method="POST">
        <input type="hidden" name="_token" value="{{ csrf_token('import_' ~ tournament.id) }}">

        {# Preview Table #}
        <div class="rounded-xl shadow-lg overflow-hidden mb-6" style="background-color: var(--card-bg); border: 1px solid var(--card-border);">
            <div class="px-6 py-4 border-b" style="border-color: var(--border-default);">
                <h2 class="text-lg font-bold" style="color: var(--text-primary);">
                    {{ ux_icon('lucide:table', {class: 'w-5 h-5 inline mr-2'}) }}
                    {{ 'import.mapping.preview_title'|trans }}
                </h2>
            </div>
            <div class="overflow-x-auto">
                <table class="w-full">
                    <thead>
                        <tr style="background-color: var(--bg-muted);">
                            {% for index, column in suggestions %}
                                <th class="px-4 py-3 text-left">
                                    <div class="mb-2 text-xs font-medium uppercase tracking-wide" style="color: var(--text-muted);">
                                        {{ column.original }}
                                    </div>
                                    <select name="mapping[{{ index }}]"
                                            class="w-full px-3 py-2 rounded-lg text-sm border focus:outline-none focus:ring-2"
                                            style="background-color: var(--bg-base); border-color: var(--border-default); color: var(--text-primary);"
                                            data-column="{{ index }}">
                                        {% for value, label in fieldOptions %}
                                            <option value="{{ value }}"
                                                    {% if column.suggested == value %}selected{% endif %}
                                                    {% if value == 'email' %}class="font-bold"{% endif %}>
                                                {{ label }}
                                            </option>
                                        {% endfor %}
                                    </select>
                                </th>
                            {% endfor %}
                        </tr>
                    </thead>
                    <tbody>
                        {% for row in preview|slice(1) %}
                            <tr class="border-t" style="border-color: var(--border-default);">
                                {% for cell in row %}
                                    <td class="px-4 py-3 text-sm" style="color: var(--text-secondary);">
                                        {{ cell|length > 50 ? cell|slice(0, 50) ~ '...' : cell }}
                                    </td>
                                {% endfor %}
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
            {% if totalRows > 5 %}
                <div class="px-6 py-3 text-sm" style="background-color: var(--bg-subtle); color: var(--text-muted);">
                    {{ 'import.mapping.rows_remaining'|trans({'%count%': totalRows - 5}) }}
                </div>
            {% endif %}
        </div>

        {# Options Card #}
        <div class="rounded-xl shadow-lg p-6 mb-6" style="background-color: var(--card-bg); border: 1px solid var(--card-border);">
            <h2 class="text-lg font-bold mb-4" style="color: var(--text-primary);">
                {{ ux_icon('lucide:settings', {class: 'w-5 h-5 inline mr-2'}) }}
                {{ 'import.mapping.options_title'|trans }}
            </h2>

            <div class="flex items-start space-x-3">
                <input type="checkbox"
                       name="send_emails"
                       id="send_emails"
                       value="1"
                       class="mt-1 w-5 h-5 rounded border-gray-300 focus:ring-2"
                       style="accent-color: var(--color-primary-500);">
                <div>
                    <label for="send_emails" class="font-medium cursor-pointer" style="color: var(--text-primary);">
                        {{ 'import.mapping.send_emails_label'|trans }}
                    </label>
                    <p class="text-sm" style="color: var(--text-muted);">
                        {{ 'import.mapping.send_emails_description'|trans }}
                    </p>
                </div>
            </div>
        </div>

        {# Validation Warning #}
        <div id="validation-warning" class="rounded-xl p-4 mb-6 hidden" style="background-color: rgb(239 68 68 / 0.1); border: 1px solid rgb(239 68 68 / 0.3);">
            <div class="flex items-center space-x-3">
                {{ ux_icon('lucide:alert-triangle', {class: 'w-5 h-5 text-red-500 flex-shrink-0'}) }}
                <p class="text-sm font-medium text-red-600">{{ 'import.mapping.email_required_warning'|trans }}</p>
            </div>
        </div>

        {# Action Buttons #}
        <div class="flex items-center justify-between">
            <a href="{{ path('tournament_import', {'id': tournament.id}) }}"
               class="inline-flex items-center px-4 py-2 rounded-lg font-medium transition"
               style="background-color: var(--bg-muted); color: var(--text-secondary);">
                {{ ux_icon('lucide:arrow-left', {class: 'w-4 h-4 mr-2'}) }}
                {{ 'import.mapping.back'|trans }}
            </a>

            <button type="submit"
                    id="submit-btn"
                    class="inline-flex items-center px-6 py-3 rounded-xl font-medium transition btn-primary">
                {{ ux_icon('lucide:play', {class: 'w-5 h-5 mr-2'}) }}
                {{ 'import.mapping.execute'|trans({'%count%': totalRows}) }}
            </button>
        </div>
    </form>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const selects = document.querySelectorAll('select[data-column]');
    const warning = document.getElementById('validation-warning');
    const submitBtn = document.getElementById('submit-btn');

    function validateMapping() {
        let hasEmail = false;
        selects.forEach(function(select) {
            if (select.value === 'email') {
                hasEmail = true;
            }
        });

        if (!hasEmail) {
            warning.classList.remove('hidden');
            submitBtn.disabled = true;
            submitBtn.classList.add('opacity-50', 'cursor-not-allowed');
        } else {
            warning.classList.add('hidden');
            submitBtn.disabled = false;
            submitBtn.classList.remove('opacity-50', 'cursor-not-allowed');
        }
    }

    selects.forEach(function(select) {
        select.addEventListener('change', validateMapping);
    });

    // Initial validation
    validateMapping();
});
</script>
{% endblock %}
