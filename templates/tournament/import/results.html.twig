{% extends 'base.html.twig' %}

{% block title %}{{ 'import.results.title'|trans }} - {{ tournament.name }}{% endblock %}

{% block body %}
<div class="container mx-auto px-4 py-8 max-w-4xl">
    {# Header #}
    <div class="mb-8">
        <nav class="text-sm mb-2" style="color: var(--text-muted);">
            <a href="{{ path('tournament_show', {'id': tournament.id}) }}" class="hover:opacity-80" style="color: var(--text-secondary);">
                {{ tournament.name }}
            </a>
            <span class="mx-2">/</span>
            <a href="{{ path('tournament_registrations', {'id': tournament.id}) }}" class="hover:opacity-80" style="color: var(--text-secondary);">
                {{ 'tournament.registrations.breadcrumb'|trans }}
            </a>
            <span class="mx-2">/</span>
            <span>{{ 'import.results.breadcrumb'|trans }}</span>
        </nav>
        <h1 class="text-3xl font-bold" style="color: var(--text-primary);">{{ 'import.results.header'|trans }}</h1>
    </div>

    {# Success Summary #}
    {% if result.successCount > 0 %}
        <div class="rounded-xl p-6 mb-6" style="background-color: rgb(34 197 94 / 0.1); border: 1px solid rgb(34 197 94 / 0.3);">
            <div class="flex items-center space-x-4">
                {{ ux_icon('lucide:check-circle', {class: 'w-12 h-12 text-green-500 flex-shrink-0'}) }}
                <div>
                    <h2 class="text-2xl font-bold text-green-700">
                        {{ 'import.results.success_message'|trans({'%count%': result.successCount}) }}
                    </h2>
                    <p class="text-green-600">{{ 'import.results.success_description'|trans }}</p>
                </div>
            </div>
        </div>
    {% endif %}

    {# Statistics Cards #}
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
        {# Total Processed #}
        <div class="rounded-xl p-4 text-center" style="background-color: var(--card-bg); border: 1px solid var(--card-border);">
            <div class="text-3xl font-bold" style="color: var(--text-primary);">{{ result.totalProcessed }}</div>
            <div class="text-sm" style="color: var(--text-muted);">{{ 'import.results.stat_total'|trans }}</div>
        </div>

        {# Linked Users #}
        <div class="rounded-xl p-4 text-center" style="background-color: rgb(59 130 246 / 0.1); border: 1px solid rgb(59 130 246 / 0.3);">
            <div class="text-3xl font-bold text-blue-600">{{ result.linkedCount }}</div>
            <div class="text-sm text-blue-600">{{ 'import.results.stat_linked'|trans }}</div>
        </div>

        {# Created Guests #}
        <div class="rounded-xl p-4 text-center" style="background-color: rgb(168 85 247 / 0.1); border: 1px solid rgb(168 85 247 / 0.3);">
            <div class="text-3xl font-bold text-purple-600">{{ result.createdCount }}</div>
            <div class="text-sm text-purple-600">{{ 'import.results.stat_created'|trans }}</div>
        </div>

        {# Skipped #}
        <div class="rounded-xl p-4 text-center" style="background-color: rgb(234 179 8 / 0.1); border: 1px solid rgb(234 179 8 / 0.3);">
            <div class="text-3xl font-bold text-yellow-600">{{ result.skippedCount }}</div>
            <div class="text-sm text-yellow-600">{{ 'import.results.stat_skipped'|trans }}</div>
        </div>
    </div>

    {# Errors Section #}
    {% if result.errorCount > 0 %}
        <div class="rounded-xl shadow-lg overflow-hidden mb-6" style="background-color: var(--card-bg); border: 1px solid var(--card-border);">
            <div class="px-6 py-4 border-b" style="border-color: var(--border-default); background-color: rgb(239 68 68 / 0.1);">
                <h2 class="text-lg font-bold text-red-600">
                    {{ ux_icon('lucide:alert-circle', {class: 'w-5 h-5 inline mr-2'}) }}
                    {{ 'import.results.errors_title'|trans({'%count%': result.errorCount}) }}
                </h2>
            </div>
            <div class="divide-y" style="border-color: var(--border-default);">
                {% for error in result.errors %}
                    <div class="px-6 py-3 flex items-center space-x-4">
                        <span class="inline-flex items-center justify-center w-8 h-8 rounded-full text-sm font-bold" style="background-color: var(--bg-muted); color: var(--text-muted);">
                            {{ error.line }}
                        </span>
                        <span class="text-red-600">{{ error.message }}</span>
                    </div>
                {% endfor %}
            </div>
        </div>
    {% endif %}

    {# Skipped Section #}
    {% if result.skippedCount > 0 %}
        <div class="rounded-xl shadow-lg overflow-hidden mb-6" style="background-color: var(--card-bg); border: 1px solid var(--card-border);">
            <details>
                <summary class="px-6 py-4 cursor-pointer hover:bg-gray-50 dark:hover:bg-gray-800 transition">
                    <span class="text-lg font-bold" style="color: var(--text-primary);">
                        {{ ux_icon('lucide:skip-forward', {class: 'w-5 h-5 inline mr-2'}) }}
                        {{ 'import.results.skipped_title'|trans({'%count%': result.skippedCount}) }}
                    </span>
                </summary>
                <div class="divide-y border-t" style="border-color: var(--border-default);">
                    {% for skip in result.skipped %}
                        <div class="px-6 py-3 flex items-center space-x-4">
                            <span class="inline-flex items-center justify-center w-8 h-8 rounded-full text-sm font-bold" style="background-color: var(--bg-muted); color: var(--text-muted);">
                                {{ skip.line }}
                            </span>
                            <span style="color: var(--text-secondary);">{{ skip.reason }}</span>
                        </div>
                    {% endfor %}
                </div>
            </details>
        </div>
    {% endif %}

    {# Details Section #}
    {% if result.details|length > 0 %}
        <div class="rounded-xl shadow-lg overflow-hidden mb-6" style="background-color: var(--card-bg); border: 1px solid var(--card-border);">
            <details>
                <summary class="px-6 py-4 cursor-pointer hover:bg-gray-50 dark:hover:bg-gray-800 transition">
                    <span class="text-lg font-bold" style="color: var(--text-primary);">
                        {{ ux_icon('lucide:list', {class: 'w-5 h-5 inline mr-2'}) }}
                        {{ 'import.results.details_title'|trans }}
                    </span>
                </summary>
                <div class="divide-y border-t" style="border-color: var(--border-default);">
                    {% for detail in result.details %}
                        <div class="px-6 py-3 flex items-center space-x-4">
                            <span class="inline-flex items-center justify-center w-8 h-8 rounded-full text-sm font-bold" style="background-color: var(--bg-muted); color: var(--text-muted);">
                                {{ detail.line }}
                            </span>
                            {% if detail.type == 'linked' %}
                                <span class="inline-flex items-center px-2 py-1 rounded text-xs font-medium bg-blue-100 text-blue-700">
                                    {{ 'import.results.type_linked'|trans }}
                                </span>
                            {% else %}
                                <span class="inline-flex items-center px-2 py-1 rounded text-xs font-medium bg-purple-100 text-purple-700">
                                    {{ 'import.results.type_created'|trans }}
                                </span>
                            {% endif %}
                            <span style="color: var(--text-secondary);">{{ detail.email }}</span>
                        </div>
                    {% endfor %}
                </div>
            </details>
        </div>
    {% endif %}

    {# Guest Accounts Info #}
    {% if result.createdCount > 0 %}
        <div class="rounded-xl p-6 mb-6" style="background-color: rgb(168 85 247 / 0.1); border: 1px solid rgb(168 85 247 / 0.3);">
            <h3 class="text-lg font-bold text-purple-700 mb-2">
                {{ ux_icon('lucide:user-plus', {class: 'w-5 h-5 inline mr-2'}) }}
                {{ 'import.results.guest_info_title'|trans }}
            </h3>
            <p class="text-purple-600 text-sm">
                {{ 'import.results.guest_info_description'|trans({'%count%': result.createdCount}) }}
            </p>
        </div>
    {% endif %}

    {# Action Buttons #}
    <div class="flex items-center justify-between">
        <a href="{{ path('tournament_import', {'id': tournament.id}) }}"
           class="inline-flex items-center px-4 py-2 rounded-lg font-medium transition"
           style="background-color: var(--bg-muted); color: var(--text-secondary);">
            {{ ux_icon('lucide:upload', {class: 'w-4 h-4 mr-2'}) }}
            {{ 'import.results.import_more'|trans }}
        </a>

        <a href="{{ path('tournament_registrations', {'id': tournament.id}) }}"
           class="inline-flex items-center px-6 py-3 rounded-xl font-medium transition btn-primary">
            {{ ux_icon('lucide:users', {class: 'w-5 h-5 mr-2'}) }}
            {{ 'import.results.view_registrations'|trans }}
        </a>
    </div>
</div>
{% endblock %}
