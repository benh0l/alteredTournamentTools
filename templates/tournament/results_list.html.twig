{% extends 'base.html.twig' %}

{% block title %}{{ 'tournament.results_list.page_title'|trans }} - Altered Tournament Tools{% endblock %}

{% block body %}
<div class="max-w-6xl mx-auto">
    {# Header with gradient banner #}
    <div class="theme-header-gradient rounded-2xl shadow-xl p-6 mb-8">
        <div class="flex flex-col md:flex-row md:items-center md:justify-between">
            <div class="text-white">
                <div class="flex items-center space-x-3">
                    {{ ux_icon('lucide:trophy', {class: 'w-8 h-8 text-white'}) }}
                    <div>
                        <h1 class="text-2xl font-bold">{{ 'tournament.results_list.title'|trans }}</h1>
                        <p class="text-white/80">{{ 'tournament.results_list.subtitle'|trans }}</p>
                    </div>
                </div>
            </div>
            <a href="{{ path('tournament_list') }}"
               class="mt-4 md:mt-0 inline-flex items-center bg-white/20 hover:bg-white/30 px-5 py-2.5 rounded-xl font-semibold text-white transition-all">
                {{ ux_icon('lucide:search', {class: 'w-5 h-5 mr-2'}) }}
                {{ 'tournament.results_list.find_tournament'|trans }}
            </a>
        </div>
    </div>

    {% if tournaments is empty %}
        <div class="card-gradient p-12 text-center">
            <div class="w-24 h-24 mx-auto rounded-full flex items-center justify-center mb-6" style="background: linear-gradient(to bottom right, var(--color-primary-100), var(--color-accent-400) / 0.3);">
                {{ ux_icon('lucide:inbox', {class: 'w-12 h-12', style: 'color: var(--color-primary-500);'}) }}
            </div>
            <p class="text-lg mb-4" style="color: var(--text-secondary);">{{ 'tournament.results_list.no_results'|trans }}</p>
            <a href="{{ path('tournament_list') }}"
               class="inline-flex items-center px-6 py-3 text-white font-semibold rounded-xl shadow-md hover:shadow-lg transition-all"
               style="background: linear-gradient(135deg, var(--color-primary-500), var(--color-accent-500));">
                {{ ux_icon('lucide:search', {class: 'w-5 h-5 mr-2'}) }}
                {{ 'tournament.results_list.find_tournament'|trans }}
            </a>
        </div>
    {% else %}
        {# Results count #}
        <div class="mb-4 text-sm" style="color: var(--text-muted);">
            {{ ux_icon('lucide:trophy', {class: 'w-4 h-4 inline mr-1'}) }}
            {{ tournaments|length }} {{ 'tournament.results_list.count'|trans }}
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {% for tournament in tournaments %}
                <div class="rounded-2xl shadow-lg overflow-hidden hover:shadow-xl hover:-translate-y-1 transition-all duration-300 border" style="background-color: var(--card-bg); border-color: var(--border-muted);">
                    {# Green header for completed #}
                    <div class="h-2 bg-gradient-to-r from-emerald-500 to-teal-500"></div>

                    <div class="p-6">
                        {# Header with status #}
                        <div class="flex items-start justify-between mb-4">
                            <h2 class="text-lg font-bold transition-colors" style="color: var(--text-primary);">
                                {{ tournament.name }}
                            </h2>
                            <span class="px-3 py-1 bg-emerald-500/20 text-emerald-600 dark:text-emerald-400 text-xs font-semibold rounded-full border border-emerald-500/30">
                                {{ 'enum.tournament_status.completed'|trans }}
                            </span>
                        </div>

                        {# Tournament info #}
                        <div class="space-y-3">
                            <div class="flex items-center text-sm">
                                <div class="w-8 h-8 rounded-lg flex items-center justify-center mr-3" style="background: linear-gradient(to bottom right, var(--color-primary-100), var(--color-accent-400) / 0.3);">
                                    {{ ux_icon('lucide:calendar', {class: 'w-4 h-4', style: 'color: var(--color-primary-600);'}) }}
                                </div>
                                <span class="font-medium" style="color: var(--text-primary);">
                                    {{ tournament.date|date('d/m/Y') }}
                                </span>
                            </div>

                            {% if tournament.location %}
                            <div class="flex items-start text-sm">
                                <div class="w-8 h-8 bg-rose-500/20 rounded-lg flex items-center justify-center mr-3 flex-shrink-0">
                                    {{ ux_icon('lucide:map-pin', {class: 'w-4 h-4 text-rose-500'}) }}
                                </div>
                                <span style="color: var(--text-secondary);">
                                    {{ tournament.location }}
                                </span>
                            </div>
                            {% endif %}

                            <div class="flex items-center text-sm">
                                <div class="w-8 h-8 bg-blue-500/20 rounded-lg flex items-center justify-center mr-3">
                                    {{ ux_icon('lucide:users', {class: 'w-4 h-4 text-blue-500'}) }}
                                </div>
                                <span style="color: var(--text-secondary);">
                                    {{ tournament.registrationCount }} {{ 'tournament.results_list.players'|trans }}
                                </span>
                            </div>
                        </div>

                        {# Tags #}
                        <div class="mt-4 flex flex-wrap gap-2">
                            <span class="inline-flex items-center px-2.5 py-1 rounded-lg text-xs font-semibold bg-blue-500/20 text-blue-600 dark:text-blue-400 border border-blue-500/30">
                                {{ ('enum.tournament_format.' ~ tournament.format.value)|trans }}
                            </span>
                            <span class="inline-flex items-center px-2.5 py-1 rounded-lg text-xs font-semibold bg-purple-500/20 text-purple-600 dark:text-purple-400 border border-purple-500/30">
                                {{ ('enum.tournament_structure.' ~ tournament.structure.value)|trans }}
                            </span>
                        </div>

                        {# Action buttons #}
                        <div class="mt-5 pt-4 border-t flex flex-col sm:flex-row gap-2" style="border-color: var(--border-muted);">
                            <a href="{{ path('tournament_final_standings', {id: tournament.id}) }}"
                               class="flex-1 inline-flex items-center justify-center px-4 py-2 text-white font-semibold rounded-xl shadow-md hover:shadow-lg transition-all text-sm"
                               style="background: linear-gradient(135deg, var(--color-primary-500), var(--color-accent-500));">
                                {{ ux_icon('lucide:list-ordered', {class: 'w-4 h-4 mr-2'}) }}
                                {{ 'tournament.results_list.view_standings'|trans }}
                            </a>
                            <a href="{{ path('tournament_stats', {id: tournament.id}) }}"
                               class="inline-flex items-center justify-center px-4 py-2 font-medium rounded-xl transition-all text-sm border"
                               style="color: var(--text-secondary); background-color: var(--bg-subtle); border-color: var(--border-default);">
                                {{ ux_icon('lucide:bar-chart-3', {class: 'w-4 h-4 mr-2'}) }}
                                {{ 'tournament.results_list.view_stats'|trans }}
                            </a>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    {% endif %}
</div>
{% endblock %}
