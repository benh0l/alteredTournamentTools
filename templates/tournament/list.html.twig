{% extends 'base.html.twig' %}

{% block title %}{{ 'tournament.title'|trans }} - Altered Tournament Tools{% endblock %}

{% block body %}
<div class="max-w-6xl mx-auto">
    {# Header with gradient banner #}
    <div class="theme-header-gradient rounded-2xl shadow-xl p-6 mb-8">
        <div class="flex flex-col md:flex-row md:items-center md:justify-between">
            <div class="text-white">
                <div class="flex items-center space-x-3">
                    {{ ux_icon('lucide:trophy', {class: 'w-8 h-8 text-white'}) }}
                    <div>
                        <h1 class="text-2xl font-bold">{{ 'tournament.title'|trans }}</h1>
                        <p class="text-white/80">{{ 'home.discover_tournaments'|trans }}</p>
                    </div>
                </div>
            </div>
            {% if is_granted('ROLE_USER') %}
                <a href="{{ path('tournament_create') }}"
                   class="mt-4 md:mt-0 inline-flex items-center bg-white px-5 py-2.5 rounded-xl font-semibold shadow-lg hover:shadow-xl transition-all"
                   style="color: var(--color-primary-600);">
                    {{ ux_icon('lucide:plus', {class: 'w-5 h-5 mr-2'}) }}
                    {{ 'tournament.create.title'|trans }}
                </a>
            {% endif %}
        </div>
    </div>

    {# Search Filter #}
    <div class="card-gradient rounded-2xl shadow-lg p-6 mb-8 border" style="border-color: var(--border-muted);">
        <div class="flex items-center gap-2 mb-5">
            <div class="w-10 h-10 rounded-xl flex items-center justify-center" style="background: linear-gradient(135deg, var(--color-primary-500), var(--color-accent-500));">
                {{ ux_icon('lucide:search', {class: 'w-5 h-5 text-white'}) }}
            </div>
            <div>
                <h2 class="text-lg font-bold" style="color: var(--text-primary);">{{ 'action.search'|trans }}</h2>
                <p class="text-sm" style="color: var(--text-muted);">{{ 'home.discover_tournaments'|trans }}</p>
            </div>
        </div>

        {{ form_start(form, {attr: {class: 'space-y-5'}}) }}
            {# First row: Location, Radius, Format #}
            <div class="grid grid-cols-1 md:grid-cols-12 gap-4">
                {# Location with autocomplete #}
                <div data-controller="address-autocomplete" class="md:col-span-5">
                    <label class="block text-sm font-semibold mb-2" style="color: var(--text-secondary);">
                        {{ ux_icon('lucide:map-pin', {class: 'w-4 h-4 inline mr-1', style: 'color: var(--color-primary-500);'}) }}
                        {{ 'tournament.search.location'|trans }}
                    </label>
                    <div class="relative">
                        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none z-10">
                            {{ ux_icon('lucide:globe', {class: 'w-5 h-5', style: 'color: var(--text-muted);'}) }}
                        </div>
                        {{ form_widget(form.location, {attr: {
                            class: 'form-input w-full pl-10 rounded-xl border-2 transition-all focus:border-primary-500',
                            style: 'border-color: var(--border-default); background-color: var(--input-bg);',
                            placeholder: 'tournament.search.location_placeholder'|trans
                        }}) }}
                    </div>
                    {{ form_widget(form.lat) }}
                    {{ form_widget(form.lng) }}
                </div>

                {# Radius #}
                <div class="md:col-span-3">
                    <label class="block text-sm font-semibold mb-2" style="color: var(--text-secondary);">
                        {{ ux_icon('lucide:target', {class: 'w-4 h-4 inline mr-1', style: 'color: var(--color-accent-500);'}) }}
                        {{ 'tournament.search.radius'|trans }}
                        <span class="font-normal text-xs" style="color: var(--text-muted);">(1-1000 km)</span>
                    </label>
                    <div class="relative">
                        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                            {{ ux_icon('lucide:ruler', {class: 'w-5 h-5', style: 'color: var(--text-muted);'}) }}
                        </div>
                        {{ form_widget(form.radius, {attr: {
                            class: 'form-input w-full pl-10 rounded-xl border-2 transition-all focus:border-primary-500',
                            style: 'border-color: var(--border-default); background-color: var(--input-bg);',
                            type: 'number',
                            min: '1',
                            max: '1000'
                        }}) }}
                    </div>
                </div>

                {# Format #}
                <div class="md:col-span-4">
                    <label class="block text-sm font-semibold mb-2" style="color: var(--text-secondary);">
                        {{ ux_icon('lucide:layers', {class: 'w-4 h-4 inline mr-1', style: 'color: var(--color-primary-500);'}) }}
                        {{ 'tournament.search.format'|trans }}
                    </label>
                    <div class="relative">
                        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                            {{ ux_icon('lucide:gamepad-2', {class: 'w-5 h-5', style: 'color: var(--text-muted);'}) }}
                        </div>
                        {{ form_widget(form.format, {attr: {
                            class: 'form-select w-full pl-10 rounded-xl border-2 transition-all focus:border-primary-500',
                            style: 'border-color: var(--border-default); background-color: var(--input-bg);'
                        }}) }}
                    </div>
                </div>
            </div>

            {# Second row: Date From, Date To #}
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                {# Date From #}
                <div>
                    <label class="block text-sm font-semibold mb-2" style="color: var(--text-secondary);">
                        {{ ux_icon('lucide:calendar-arrow-up', {class: 'w-4 h-4 inline mr-1', style: 'color: var(--color-accent-500);'}) }}
                        {{ 'tournament.search.date_from'|trans }}
                    </label>
                    <div class="relative">
                        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                            {{ ux_icon('lucide:calendar-plus', {class: 'w-5 h-5', style: 'color: var(--text-muted);'}) }}
                        </div>
                        {{ form_widget(form.dateFrom, {attr: {
                            class: 'form-input w-full pl-10 rounded-xl border-2 transition-all focus:border-primary-500',
                            style: 'border-color: var(--border-default); background-color: var(--input-bg);'
                        }}) }}
                    </div>
                </div>

                {# Date To #}
                <div>
                    <label class="block text-sm font-semibold mb-2" style="color: var(--text-secondary);">
                        {{ ux_icon('lucide:calendar-arrow-down', {class: 'w-4 h-4 inline mr-1', style: 'color: var(--color-accent-500);'}) }}
                        {{ 'tournament.search.date_to'|trans }}
                    </label>
                    <div class="relative">
                        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                            {{ ux_icon('lucide:calendar-check', {class: 'w-5 h-5', style: 'color: var(--text-muted);'}) }}
                        </div>
                        {{ form_widget(form.dateTo, {attr: {
                            class: 'form-input w-full pl-10 rounded-xl border-2 transition-all focus:border-primary-500',
                            style: 'border-color: var(--border-default); background-color: var(--input-bg);'
                        }}) }}
                    </div>
                </div>
            </div>

            {# Tournament type filters #}
            <div class="flex flex-wrap gap-4 pt-4 border-t" style="border-color: var(--border-muted);">
                <label class="flex items-center px-4 py-3 rounded-xl cursor-pointer border-2 transition-all hover:border-orange-400" style="background-color: var(--input-bg); border-color: var(--border-default);">
                    {{ form_widget(form.isTumult, {'attr': {'class': 'h-5 w-5 rounded', 'style': 'accent-color: var(--color-primary-600);'}}) }}
                    <span class="ml-3 text-sm font-semibold" style="color: var(--text-primary);">
                        {{ ux_icon('lucide:flame', {class: 'w-4 h-4 inline mr-1 text-orange-500'}) }}
                        {{ 'tournament.search.is_tumult'|trans }}
                    </span>
                </label>

                <label class="flex items-center px-4 py-3 rounded-xl cursor-pointer border-2 transition-all hover:border-yellow-400" style="background-color: var(--input-bg); border-color: var(--border-default);">
                    {{ form_widget(form.isSeasonFinalsQualifier, {'attr': {'class': 'h-5 w-5 rounded', 'style': 'accent-color: var(--color-primary-600);'}}) }}
                    <span class="ml-3 text-sm font-semibold" style="color: var(--text-primary);">
                        {{ ux_icon('lucide:award', {class: 'w-4 h-4 inline mr-1 text-yellow-500'}) }}
                        {{ 'tournament.search.is_season_finals_qualifier'|trans }}
                    </span>
                </label>
            </div>

            {# Buttons #}
            <div class="flex flex-col sm:flex-row justify-end gap-3 pt-4 border-t" style="border-color: var(--border-muted);">
                <a href="{{ path('tournament_list') }}"
                   class="inline-flex items-center justify-center px-5 py-2.5 rounded-xl font-medium transition-all hover:opacity-80 border"
                   style="color: var(--text-secondary); background-color: var(--bg-subtle); border-color: var(--border-default);">
                    {{ ux_icon('lucide:rotate-ccw', {class: 'w-4 h-4 mr-2'}) }}
                    {{ 'common.reset'|trans }}
                </a>
                <button type="submit"
                        class="inline-flex items-center justify-center px-6 py-2.5 text-white font-semibold rounded-xl shadow-lg hover:shadow-xl transition-all hover:-translate-y-0.5"
                        style="background: linear-gradient(135deg, var(--color-primary-500), var(--color-accent-500));">
                    {{ ux_icon('lucide:search', {class: 'w-4 h-4 mr-2'}) }}
                    {{ 'common.search'|trans }}
                </button>
            </div>
        {{ form_end(form) }}
    </div>

    {# Determine which data to display #}
    {% set displayData = searchResults is not null ? searchResults : tournaments %}

    {% if displayData is empty %}
        <div class="card-gradient p-12 text-center">
            <div class="w-24 h-24 mx-auto rounded-full flex items-center justify-center mb-6" style="background: linear-gradient(to bottom right, var(--color-primary-100), var(--color-accent-400) / 0.3);">
                {{ ux_icon('lucide:inbox', {class: 'w-12 h-12', style: 'color: var(--color-primary-500);'}) }}
            </div>
            {% if searchResults is not null %}
                <p class="text-lg mb-4" style="color: var(--text-secondary);">{{ 'tournament.list.no_results'|trans|default('Aucun tournoi trouvé dans cette zone') }}</p>
            {% else %}
                <p class="text-lg mb-4" style="color: var(--text-secondary);">{{ 'tournament.list.no_tournaments'|trans }}</p>
            {% endif %}
            {% if is_granted('ROLE_USER') %}
                <a href="{{ path('tournament_create') }}"
                   class="inline-flex items-center px-6 py-3 text-white font-semibold rounded-xl shadow-md hover:shadow-lg transition-all"
                   style="background: linear-gradient(135deg, var(--color-primary-500), var(--color-accent-500));">
                    {{ ux_icon('lucide:plus', {class: 'w-5 h-5 mr-2'}) }}
                    {{ 'tournament.create.title'|trans }}
                </a>
            {% endif %}
        </div>
    {% else %}
        {# Results count #}
        {% if searchResults is not null %}
            <div class="mb-4 text-sm" style="color: var(--text-muted);">
                {{ ux_icon('lucide:map-pin', {class: 'w-4 h-4 inline mr-1'}) }}
                {{ searchResults|length }} {{ 'tournament.list.results_found'|trans|default('tournoi(s) trouvé(s)') }}
            </div>
        {% endif %}

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {% for item in displayData %}
                {# Handle both regular tournaments and search results with distance #}
                {% set tournament = searchResults is not null ? item.tournament : item %}
                {% set distance = searchResults is not null ? item.distance : null %}
                <div class="rounded-2xl shadow-lg overflow-hidden hover:shadow-xl hover:-translate-y-1 transition-all duration-300 border" style="background-color: var(--card-bg); border-color: var(--border-muted);">
                    {# Color header based on status #}
                    {% if tournament.ongoing %}
                        <div class="h-2 bg-gradient-to-r from-blue-500 to-cyan-500"></div>
                    {% elseif tournament.completed %}
                        <div class="h-2 bg-gradient-to-r from-emerald-500 to-teal-500"></div>
                    {% elseif tournament.published %}
                        <div class="h-2 theme-header-gradient"></div>
                    {% else %}
                        <div class="h-2" style="background: linear-gradient(to right, var(--border-default), var(--border-muted));"></div>
                    {% endif %}

                    <div class="p-6">
                        {# Header with status #}
                        <div class="flex items-start justify-between mb-4">
                            <h2 class="text-lg font-bold transition-colors" style="color: var(--text-primary);">
                                <a href="{{ path('tournament_show', {id: tournament.id}) }}" class="hover:opacity-80">
                                    {{ tournament.name }}
                                </a>
                            </h2>
                            {% if tournament.ongoing %}
                                <span class="px-3 py-1 text-xs font-semibold rounded-full border border-blue-500/30" style="background-color: rgba(59, 130, 246, 0.2); color: var(--badge-blue-text);">
                                    {{ 'enum.tournament_status.ongoing'|trans }}
                                </span>
                            {% elseif tournament.completed %}
                                <span class="px-3 py-1 text-xs font-semibold rounded-full border border-emerald-500/30" style="background-color: rgba(16, 185, 129, 0.2); color: var(--badge-emerald-text);">
                                    {{ 'enum.tournament_status.completed'|trans }}
                                </span>
                            {% elseif tournament.published %}
                                <span class="px-3 py-1 rounded-full text-xs font-semibold border" style="background: linear-gradient(to right, var(--color-primary-100), var(--color-accent-400) / 0.3); color: var(--color-primary-700); border-color: var(--color-primary-200);">
                                    {{ 'nav.register'|trans }}
                                </span>
                            {% else %}
                                <span class="px-3 py-1 rounded-full text-xs font-semibold" style="background-color: var(--bg-muted); color: var(--text-muted);">
                                    {{ 'enum.tournament_status.draft'|trans }}
                                </span>
                            {% endif %}
                        </div>

                        {# Tournament info #}
                        <div class="space-y-3">
                            <div class="flex items-center text-sm">
                                <div class="w-8 h-8 rounded-lg flex items-center justify-center mr-3" style="background: linear-gradient(to bottom right, var(--color-primary-100), var(--color-accent-400) / 0.3);">
                                    {{ ux_icon('lucide:calendar', {class: 'w-4 h-4', style: 'color: var(--color-primary-600);'}) }}
                                </div>
                                <span class="font-medium" style="color: var(--text-primary);">
                                    {{ tournament.date|date('d/m/Y') }}
                                    {% if tournament.time %}
                                        {{ 'common.at'|trans|default('a') }} {{ tournament.time|date('H:i') }}
                                    {% endif %}
                                </span>
                            </div>
                            {% if tournament.location or distance is not null %}
                                <div class="flex items-start text-sm">
                                    <div class="w-8 h-8 bg-rose-500/20 rounded-lg flex items-center justify-center mr-3 flex-shrink-0">
                                        {{ ux_icon('lucide:map-pin', {class: 'w-4 h-4 text-rose-500'}) }}
                                    </div>
                                    <div class="flex-1 min-w-0">
                                        {% if tournament.location %}
                                            <span style="color: var(--text-secondary);">
                                                {{ tournament.location }}
                                            </span>
                                        {% endif %}
                                        {% if distance is not null %}
                                            <span class="ml-2 px-2 py-0.5 text-xs font-semibold rounded-full whitespace-nowrap" style="background-color: rgba(16, 185, 129, 0.2); color: var(--badge-emerald-text);">
                                                {{ distance }} km
                                            </span>
                                        {% endif %}
                                    </div>
                                </div>
                            {% endif %}
                        </div>

                        {# Tags #}
                        <div class="mt-4 flex flex-wrap gap-2">
                            {% if tournament.isTumult %}
                                <span class="inline-flex items-center px-2.5 py-1 rounded-lg text-xs font-semibold border border-orange-500/30" style="background-color: rgba(249, 115, 22, 0.2); color: var(--badge-orange-text, #c2410c);">
                                    {{ ux_icon('lucide:flame', {class: 'w-3 h-3 mr-1'}) }}
                                    Tumult
                                </span>
                            {% endif %}
                            {% if tournament.isSeasonFinalsQualifier %}
                                <span class="inline-flex items-center px-2.5 py-1 rounded-lg text-xs font-semibold border border-yellow-500/30" style="background-color: rgba(234, 179, 8, 0.2); color: var(--badge-yellow-text, #a16207);">
                                    {{ ux_icon('lucide:award', {class: 'w-3 h-3 mr-1'}) }}
                                    Qualifier
                                </span>
                            {% endif %}
                            <span class="inline-flex items-center px-2.5 py-1 rounded-lg text-xs font-semibold border border-green-500/30" style="background-color: rgba(34, 197, 94, 0.15); color: var(--badge-green-text, #15803d);">
                                {{ 'tournament.list.players_badge'|trans({'%count%': tournament.expectedPlayers}) }}
                            </span>
                            <span class="inline-flex items-center px-2.5 py-1 rounded-lg text-xs font-semibold border border-blue-500/30" style="background-color: rgba(59, 130, 246, 0.15); color: var(--badge-blue-text, #1d4ed8);">
                                {{ ('enum.tournament_format.' ~ tournament.format.value)|trans }}
                            </span>
                            <span class="inline-flex items-center px-2.5 py-1 rounded-lg text-xs font-semibold border border-purple-500/30" style="background-color: rgba(168, 85, 247, 0.15); color: var(--badge-purple-text, #7e22ce);">
                                {{ ('enum.tournament_structure.' ~ tournament.structure.value)|trans }}
                            </span>
                            <span class="inline-flex items-center px-2.5 py-1 rounded-lg text-xs font-semibold border" style="background-color: var(--bg-subtle); color: var(--text-secondary); border-color: var(--border-muted);">
                                {{ ('enum.match_format.' ~ tournament.swissMatchFormat.value)|trans }}
                            </span>
                        </div>

                        {# Organizer #}
                        <div class="mt-5 pt-4 border-t flex items-center" style="border-color: var(--border-muted);">
                            {% if tournament.organizer.avatar %}
                                <img src="/uploads/avatars/{{ tournament.organizer.avatar }}" alt="Avatar"
                                     class="w-7 h-7 rounded-full object-cover mr-2">
                            {% else %}
                                <div class="w-7 h-7 rounded-full flex items-center justify-center mr-2 theme-primary-gradient">
                                    <span class="text-white text-xs font-bold">{{ tournament.organizer.pseudo|slice(0,1)|upper }}</span>
                                </div>
                            {% endif %}
                            <span class="text-sm" style="color: var(--text-muted);">
                                {{ 'tournament.organized_by'|trans|default('Organise par') }} <span class="font-semibold" style="color: var(--text-secondary);">{{ tournament.organizer.displayName }}</span>
                            </span>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    {% endif %}
</div>
{% endblock %}
