{% extends 'base.html.twig' %}

{% block title %}{{ 'tournament.title'|trans }} - Altered Tournament Tools{% endblock %}

{% block body %}
<div class="max-w-6xl mx-auto">
    {# Header with gradient banner #}
    <div class="theme-header-gradient rounded-2xl shadow-xl p-6 mb-8">
        <div class="flex flex-col md:flex-row md:items-center md:justify-between">
            <div class="text-white">
                <div class="flex items-center space-x-3">
                    {{ ux_icon('lucide:trophy', {class: 'w-8 h-8 text-white'}) }}
                    <div>
                        <h1 class="text-2xl font-bold">{{ 'tournament.title'|trans }}</h1>
                        <p class="text-white/80">{{ 'home.discover_tournaments'|trans }}</p>
                    </div>
                </div>
            </div>
            {% if is_granted('ROLE_USER') %}
                <a href="{{ path('tournament_create') }}"
                   class="mt-4 md:mt-0 inline-flex items-center bg-white px-5 py-2.5 rounded-xl font-semibold shadow-lg hover:shadow-xl transition-all"
                   style="color: var(--color-primary-600);">
                    {{ ux_icon('lucide:plus', {class: 'w-5 h-5 mr-2'}) }}
                    {{ 'tournament.create.title'|trans }}
                </a>
            {% endif %}
        </div>
    </div>

    {% if tournaments is empty %}
        <div class="card-gradient p-12 text-center">
            <div class="w-24 h-24 mx-auto rounded-full flex items-center justify-center mb-6" style="background: linear-gradient(to bottom right, var(--color-primary-100), var(--color-accent-400) / 0.3);">
                {{ ux_icon('lucide:inbox', {class: 'w-12 h-12', style: 'color: var(--color-primary-500);'}) }}
            </div>
            <p class="text-lg mb-4" style="color: var(--text-secondary);">{{ 'tournament.list.no_tournaments'|trans }}</p>
            {% if is_granted('ROLE_USER') %}
                <a href="{{ path('tournament_create') }}"
                   class="inline-flex items-center px-6 py-3 text-white font-semibold rounded-xl shadow-md hover:shadow-lg transition-all"
                   style="background: linear-gradient(135deg, var(--color-primary-500), var(--color-accent-500));">
                    {{ ux_icon('lucide:plus', {class: 'w-5 h-5 mr-2'}) }}
                    {{ 'tournament.create.title'|trans }}
                </a>
            {% endif %}
        </div>
    {% else %}
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {% for tournament in tournaments %}
                <div class="rounded-2xl shadow-lg overflow-hidden hover:shadow-xl hover:-translate-y-1 transition-all duration-300 border" style="background-color: var(--card-bg); border-color: var(--border-muted);">
                    {# Color header based on status #}
                    {% if tournament.ongoing %}
                        <div class="h-2 bg-gradient-to-r from-blue-500 to-cyan-500"></div>
                    {% elseif tournament.completed %}
                        <div class="h-2 bg-gradient-to-r from-emerald-500 to-teal-500"></div>
                    {% elseif tournament.published %}
                        <div class="h-2 theme-header-gradient"></div>
                    {% else %}
                        <div class="h-2" style="background: linear-gradient(to right, var(--border-default), var(--border-muted));"></div>
                    {% endif %}

                    <div class="p-6">
                        {# Header with status #}
                        <div class="flex items-start justify-between mb-4">
                            <h2 class="text-lg font-bold transition-colors" style="color: var(--text-primary);">
                                <a href="{{ path('tournament_show', {id: tournament.id}) }}" class="hover:opacity-80">
                                    {{ tournament.name }}
                                </a>
                            </h2>
                            {% if tournament.ongoing %}
                                <span class="px-3 py-1 bg-blue-500/20 text-blue-600 dark:text-blue-400 text-xs font-semibold rounded-full border border-blue-500/30">
                                    {{ 'enum.tournament_status.ongoing'|trans }}
                                </span>
                            {% elseif tournament.completed %}
                                <span class="px-3 py-1 bg-emerald-500/20 text-emerald-600 dark:text-emerald-400 text-xs font-semibold rounded-full border border-emerald-500/30">
                                    {{ 'enum.tournament_status.completed'|trans }}
                                </span>
                            {% elseif tournament.published %}
                                <span class="px-3 py-1 rounded-full text-xs font-semibold border" style="background: linear-gradient(to right, var(--color-primary-100), var(--color-accent-400) / 0.3); color: var(--color-primary-700); border-color: var(--color-primary-200);">
                                    {{ 'nav.register'|trans }}
                                </span>
                            {% else %}
                                <span class="px-3 py-1 rounded-full text-xs font-semibold" style="background-color: var(--bg-muted); color: var(--text-muted);">
                                    {{ 'enum.tournament_status.draft'|trans }}
                                </span>
                            {% endif %}
                        </div>

                        {# Tournament info #}
                        <div class="space-y-3">
                            <div class="flex items-center text-sm">
                                <div class="w-8 h-8 rounded-lg flex items-center justify-center mr-3" style="background: linear-gradient(to bottom right, var(--color-primary-100), var(--color-accent-400) / 0.3);">
                                    {{ ux_icon('lucide:calendar', {class: 'w-4 h-4', style: 'color: var(--color-primary-600);'}) }}
                                </div>
                                <span class="font-medium" style="color: var(--text-primary);">
                                    {{ tournament.date|date('d/m/Y') }}
                                    {% if tournament.time %}
                                        {{ 'common.at'|trans|default('a') }} {{ tournament.time|date('H:i') }}
                                    {% endif %}
                                </span>
                            </div>
                            {% if tournament.location %}
                                <div class="flex items-center text-sm">
                                    <div class="w-8 h-8 bg-rose-500/20 rounded-lg flex items-center justify-center mr-3">
                                        {{ ux_icon('lucide:map-pin', {class: 'w-4 h-4 text-rose-500'}) }}
                                    </div>
                                    <span style="color: var(--text-secondary);">
                                        {{ tournament.location|length > 25 ? tournament.location|slice(0, 25) ~ '...' : tournament.location }}
                                    </span>
                                </div>
                            {% endif %}
                        </div>

                        {# Tags #}
                        <div class="mt-4 flex flex-wrap gap-2">
                            <span class="inline-flex items-center px-2.5 py-1 rounded-lg text-xs font-semibold bg-blue-500/20 text-blue-600 dark:text-blue-400 border border-blue-500/30">
                                {{ ('enum.tournament_format.' ~ tournament.format.value)|trans }}
                            </span>
                            <span class="inline-flex items-center px-2.5 py-1 rounded-lg text-xs font-semibold bg-purple-500/20 text-purple-600 dark:text-purple-400 border border-purple-500/30">
                                {{ ('enum.tournament_structure.' ~ tournament.structure.value)|trans }}
                            </span>
                            <span class="inline-flex items-center px-2.5 py-1 rounded-lg text-xs font-semibold border" style="background-color: var(--bg-subtle); color: var(--text-secondary); border-color: var(--border-muted);">
                                {{ ('enum.match_format.' ~ tournament.swissMatchFormat.value)|trans }}
                            </span>
                        </div>

                        {# Organizer #}
                        <div class="mt-5 pt-4 border-t flex items-center" style="border-color: var(--border-muted);">
                            {% if tournament.organizer.avatar %}
                                <img src="/uploads/avatars/{{ tournament.organizer.avatar }}" alt="Avatar"
                                     class="w-7 h-7 rounded-full object-cover mr-2">
                            {% else %}
                                <div class="w-7 h-7 rounded-full flex items-center justify-center mr-2 theme-primary-gradient">
                                    <span class="text-white text-xs font-bold">{{ tournament.organizer.pseudo|slice(0,1)|upper }}</span>
                                </div>
                            {% endif %}
                            <span class="text-sm" style="color: var(--text-muted);">
                                {{ 'tournament.organized_by'|trans|default('Organise par') }} <span class="font-semibold" style="color: var(--text-secondary);">{{ tournament.organizer.displayName }}</span>
                            </span>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    {% endif %}
</div>
{% endblock %}
