{% extends 'base.html.twig' %}

{% block title %}Classement Final - {{ tournament.name }}{% endblock %}

{% block body %}
<div class="max-w-4xl mx-auto"
     data-controller="share-image"
     data-share-image-tournament-name-value="{{ tournament.name }}"
     data-share-image-type-value="standings">
    {# Header #}
    <div class="mb-6">
        <div class="flex items-center justify-between gap-4">
            <div class="min-w-0 flex-1">
                <h1 class="text-2xl font-bold truncate" style="color: var(--text-primary);">{{ tournament.name }}</h1>
                <p style="color: var(--text-secondary);">{{ 'results.final_standings'|trans }}</p>
            </div>
            <div class="flex items-center gap-2 flex-shrink-0">
                <button data-action="click->share-image#openModal"
                        class="inline-flex items-center gap-2 px-4 py-2 font-medium rounded-xl border-2 shadow-md hover:shadow-lg transition-all duration-200"
                        style="background-color: var(--card-bg); color: var(--color-primary-600); border-color: var(--color-primary-200);">
                    {{ ux_icon('lucide:share-2', {class: 'w-4 h-4'}) }}
                    <span class="hidden sm:inline">{{ 'share.button'|trans }}</span>
                </button>
                <a href="{{ path('tournament_show', {id: tournament.id}) }}"
                   class="inline-flex items-center px-4 py-2 font-medium rounded-xl border-2 shadow-md hover:shadow-lg transition-all duration-200"
                   style="background-color: var(--card-bg); color: var(--color-primary-600); border-color: var(--color-primary-200);">
                    {{ ux_icon('lucide:arrow-left', {class: 'w-4 h-4 sm:mr-2'}) }}
                    <span class="hidden sm:inline">{{ 'common.back'|trans }}</span>
                </a>
            </div>
        </div>
    </div>

    {# Navigation tabs #}
    <div class="mb-6" style="border-bottom: 1px solid var(--border-default);">
        <nav class="flex space-x-4 md:space-x-8 overflow-x-auto pb-2">
            <a href="{{ path('tournament_final_standings', {id: tournament.id}) }}"
               class="py-2 px-1 border-b-2 font-medium" style="border-color: var(--color-primary-600); color: var(--color-primary-600);">
                Classement
            </a>
            <a href="{{ path('tournament_podium', {id: tournament.id}) }}"
               class="py-2 px-1 border-b-2 border-transparent hover:border-gray-300" style="color: var(--text-muted);">
                Podium
            </a>
            <a href="{{ path('tournament_stats', {id: tournament.id}) }}"
               class="py-2 px-1 border-b-2 border-transparent hover:border-gray-300" style="color: var(--text-muted);">
                Statistiques
            </a>
        </nav>
    </div>

    {# Tournament completion banner #}
    <div class="bg-green-500/10 border border-green-500/30 rounded-lg p-4 mb-6">
        <div class="flex items-center">
            {{ ux_icon('lucide:check-circle', {class: 'w-6 h-6 text-green-600 dark:text-green-400 mr-3'}) }}
            <div>
                <p class="text-green-800 dark:text-green-400 font-medium">Tournoi termine</p>
                <p class="text-green-600 dark:text-green-500 text-sm">
                    {{ tournament.completedAt|date('d/m/Y H:i') }}
                    - {{ tournament.completedRoundsCount }} ronde{% if tournament.completedRoundsCount > 1 %}s{% endif %} jouee{% if tournament.completedRoundsCount > 1 %}s{% endif %}
                </p>
            </div>
        </div>
    </div>

    {# Stats summary #}
    <div class="grid grid-cols-2 md:grid-cols-3 gap-3 md:gap-4 mb-6">
        <div class="border rounded-lg p-3 md:p-4 text-center" style="background-color: var(--card-bg); border-color: var(--border-default);">
            <p class="text-2xl md:text-3xl font-bold" style="color: var(--text-primary);">{{ standings|length }}</p>
            <p class="text-xs md:text-sm" style="color: var(--text-muted);">Joueurs</p>
        </div>
        <div class="border rounded-lg p-3 md:p-4 text-center" style="background-color: var(--card-bg); border-color: var(--border-default);">
            <p class="text-2xl md:text-3xl font-bold" style="color: var(--text-primary);">{{ tournament.completedRoundsCount }}</p>
            <p class="text-xs md:text-sm" style="color: var(--text-muted);">Rondes</p>
        </div>
        <div class="border rounded-lg p-3 md:p-4 text-center col-span-2 md:col-span-1" style="background-color: var(--card-bg); border-color: var(--border-default);">
            <p class="text-lg md:text-xl font-bold truncate" style="color: var(--text-primary);">{{ tournament.format.label|trans }}</p>
            <p class="text-xs md:text-sm" style="color: var(--text-muted);">Format</p>
        </div>
    </div>

    {# Elimination bracket (if applicable) #}
    {% if elimination_rounds is defined and elimination_rounds|length > 0 %}
        {{ include('components/_elimination_bracket.html.twig', {elimination_rounds: elimination_rounds}) }}
    {% endif %}

    {# Standings table #}
    {% if has_elimination_phase is defined and has_elimination_phase %}
        <h2 class="text-xl font-bold mb-4 flex items-center" style="color: var(--text-primary);">
            {{ ux_icon('lucide:list-ordered', {class: 'w-6 h-6 mr-2', style: 'color: var(--color-primary-500);'}) }}
            Classement des rondes suisses
        </h2>
    {% endif %}

    <div class="rounded-lg shadow overflow-hidden" style="background-color: var(--card-bg);">
        <div class="overflow-x-auto">
            <table class="min-w-full" style="border-collapse: separate; border-spacing: 0;">
            <thead style="background-color: var(--bg-subtle);">
                <tr>
                    <th class="px-4 py-3 text-left text-xs font-medium uppercase" style="color: var(--text-muted); border-bottom: 1px solid var(--border-default);">Rang</th>
                    <th class="px-4 py-3 text-left text-xs font-medium uppercase" style="color: var(--text-muted); border-bottom: 1px solid var(--border-default);">Joueur</th>
                    <th class="px-4 py-3 text-center text-xs font-medium uppercase" style="color: var(--text-muted); border-bottom: 1px solid var(--border-default);">Heros</th>
                    <th class="px-4 py-3 text-center text-xs font-medium uppercase" style="color: var(--text-muted); border-bottom: 1px solid var(--border-default);">V</th>
                    <th class="px-4 py-3 text-center text-xs font-medium uppercase" style="color: var(--text-muted); border-bottom: 1px solid var(--border-default);">N</th>
                    <th class="px-4 py-3 text-center text-xs font-medium uppercase" style="color: var(--text-muted); border-bottom: 1px solid var(--border-default);">D</th>
                    <th class="px-4 py-3 text-center text-xs font-medium uppercase" style="color: var(--text-muted); border-bottom: 1px solid var(--border-default);">Points</th>
                    <th class="px-4 py-3 text-center text-xs font-medium uppercase" style="color: var(--text-muted); border-bottom: 1px solid var(--border-default);">OMW%</th>
                    <th class="px-4 py-3 text-center text-xs font-medium uppercase" style="color: var(--text-muted); border-bottom: 1px solid var(--border-default);">GW%</th>
                    <th class="px-4 py-3 text-center text-xs font-medium uppercase" style="color: var(--text-muted); border-bottom: 1px solid var(--border-default);">Deck</th>
                </tr>
            </thead>
            <tbody style="background-color: var(--card-bg);">
                {% for entry in standings %}
                    <tr class="{% if loop.index <= 3 %}bg-amber-500/10{% endif %}">
                        <td class="px-4 py-3 whitespace-nowrap text-sm" style="border-bottom: 1px solid var(--border-default);">
                            {% if loop.index == 1 %}
                                <span class="inline-flex items-center justify-center w-8 h-8 rounded-full bg-yellow-400 text-yellow-900 font-bold">1</span>
                            {% elseif loop.index == 2 %}
                                <span class="inline-flex items-center justify-center w-8 h-8 rounded-full bg-gray-300 text-gray-700 font-bold">2</span>
                            {% elseif loop.index == 3 %}
                                <span class="inline-flex items-center justify-center w-8 h-8 rounded-full bg-amber-600 text-white font-bold">3</span>
                            {% else %}
                                <span class="ml-2" style="color: var(--text-secondary);">{{ loop.index }}</span>
                            {% endif %}
                        </td>
                        <td class="px-4 py-3 whitespace-nowrap text-sm font-medium" style="color: var(--text-primary); border-bottom: 1px solid var(--border-default);">
                            {{ entry.registration.player.displayName }}
                        </td>
                        <td class="px-4 py-3 whitespace-nowrap text-sm text-center" style="border-bottom: 1px solid var(--border-default);">
                            {% if entry.registration.hero %}
                                <div class="flex flex-col items-center">
                                    <div class="w-10 h-10 rounded-full overflow-hidden border-2 mb-1" style="border-color: {{ entry.registration.faction ? entry.registration.faction.color : 'var(--border-muted)' }};">
                                        <img src="{{ entry.registration.heroImage }}" alt="{{ entry.registration.heroLabel }}" class="w-full h-full object-cover" onerror="this.parentElement.innerHTML='<div class=\'w-full h-full flex items-center justify-center\' style=\'background-color: var(--bg-subtle);\'><span style=\'color: var(--text-muted);\'>?</span></div>'">
                                    </div>
                                    <span class="text-xs" style="color: var(--text-muted);">{{ entry.registration.heroLabel }}</span>
                                </div>
                            {% else %}
                                <span class="text-xs" style="color: var(--text-muted);">-</span>
                            {% endif %}
                        </td>
                        <td class="px-4 py-3 whitespace-nowrap text-sm text-center font-medium text-green-600 dark:text-green-400" style="border-bottom: 1px solid var(--border-default);">
                            {{ entry.wins }}
                        </td>
                        <td class="px-4 py-3 whitespace-nowrap text-sm text-center text-amber-600 dark:text-amber-400" style="border-bottom: 1px solid var(--border-default);">
                            {{ entry.draws }}
                        </td>
                        <td class="px-4 py-3 whitespace-nowrap text-sm text-center text-red-600 dark:text-red-400" style="border-bottom: 1px solid var(--border-default);">
                            {{ entry.losses }}
                        </td>
                        <td class="px-4 py-3 whitespace-nowrap text-sm text-center font-bold" style="color: var(--text-primary); border-bottom: 1px solid var(--border-default);">
                            {{ entry.matchPoints }}
                        </td>
                        <td class="px-4 py-3 whitespace-nowrap text-sm text-center" style="color: var(--text-muted); border-bottom: 1px solid var(--border-default);">
                            {{ (entry.opponentMatchWinPercentage * 100)|number_format(1) }}%
                        </td>
                        <td class="px-4 py-3 whitespace-nowrap text-sm text-center" style="color: var(--text-muted); border-bottom: 1px solid var(--border-default);">
                            {{ (entry.gameWinPercentage * 100)|number_format(1) }}%
                        </td>
                        <td class="px-4 py-3 whitespace-nowrap text-sm text-center" style="border-bottom: 1px solid var(--border-default);">
                            {% if entry.registration.decklistUrl %}
                                <a href="{{ entry.registration.decklistUrl }}" target="_blank" rel="noopener"
                                   class="inline-flex items-center justify-center w-8 h-8 rounded-full hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors"
                                   title="Voir la decklist">
                                    {{ ux_icon('lucide:external-link', {class: 'w-4 h-4', style: 'color: var(--color-primary-600);'}) }}
                                </a>
                            {% else %}
                                <span style="color: var(--text-muted);">-</span>
                            {% endif %}
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="10" class="px-4 py-8 text-center" style="color: var(--text-muted);">
                            Aucun classement disponible.
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    {# Landscape hint for mobile #}
    {{ include('components/_landscape_hint.html.twig') }}

    {# Legend #}
    <div class="mt-4 text-xs" style="color: var(--text-muted);">
        <p>{{ 'results.legend'|trans }}</p>
    </div>

    {# Hidden share content (for image generation) #}
    <div style="position: fixed; left: -9999px; top: 0; opacity: 0; pointer-events: none;" aria-hidden="true">
        {{ include('tournament_results/_share_standings.html.twig') }}
    </div>

    {# Share modal #}
    {{ include('components/_share_modal.html.twig') }}
</div>
{% endblock %}
