{% extends 'base.html.twig' %}

{% block title %}Classement Final - {{ tournament.name }}{% endblock %}

{% block body %}
<div class="max-w-4xl mx-auto">
    {# Header #}
    <div class="mb-6">
        <div class="flex items-center justify-between">
            <div>
                <h1 class="text-2xl font-bold" style="color: var(--text-primary);">{{ tournament.name }}</h1>
                <p style="color: var(--text-secondary);">Classement Final</p>
            </div>
            <a href="{{ path('tournament_show', {id: tournament.id}) }}" class="hover:underline" style="color: var(--color-primary-600);">
                &larr; Retour
            </a>
        </div>
    </div>

    {# Navigation tabs #}
    <div class="mb-6" style="border-bottom: 1px solid var(--border-default);">
        <nav class="flex space-x-8">
            <a href="{{ path('tournament_final_standings', {id: tournament.id}) }}"
               class="py-2 px-1 border-b-2 font-medium" style="border-color: var(--color-primary-600); color: var(--color-primary-600);">
                Classement
            </a>
            <a href="{{ path('tournament_podium', {id: tournament.id}) }}"
               class="py-2 px-1 border-b-2 border-transparent hover:border-gray-300" style="color: var(--text-muted);">
                Podium
            </a>
            <a href="{{ path('tournament_stats', {id: tournament.id}) }}"
               class="py-2 px-1 border-b-2 border-transparent hover:border-gray-300" style="color: var(--text-muted);">
                Statistiques
            </a>
        </nav>
    </div>

    {# Tournament completion banner #}
    <div class="bg-green-500/10 border border-green-500/30 rounded-lg p-4 mb-6">
        <div class="flex items-center">
            {{ ux_icon('lucide:check-circle', {class: 'w-6 h-6 text-green-600 dark:text-green-400 mr-3'}) }}
            <div>
                <p class="text-green-800 dark:text-green-400 font-medium">Tournoi termine</p>
                <p class="text-green-600 dark:text-green-500 text-sm">
                    {{ tournament.completedAt|date('d/m/Y H:i') }}
                    - {{ tournament.completedRoundsCount }} ronde{% if tournament.completedRoundsCount > 1 %}s{% endif %} jouee{% if tournament.completedRoundsCount > 1 %}s{% endif %}
                </p>
            </div>
        </div>
    </div>

    {# Stats summary #}
    <div class="grid grid-cols-3 gap-4 mb-6">
        <div class="border rounded-lg p-4 text-center" style="background-color: var(--card-bg); border-color: var(--border-default);">
            <p class="text-3xl font-bold" style="color: var(--text-primary);">{{ standings|length }}</p>
            <p class="text-sm" style="color: var(--text-muted);">Joueurs</p>
        </div>
        <div class="border rounded-lg p-4 text-center" style="background-color: var(--card-bg); border-color: var(--border-default);">
            <p class="text-3xl font-bold" style="color: var(--text-primary);">{{ tournament.completedRoundsCount }}</p>
            <p class="text-sm" style="color: var(--text-muted);">Rondes</p>
        </div>
        <div class="border rounded-lg p-4 text-center" style="background-color: var(--card-bg); border-color: var(--border-default);">
            <p class="text-3xl font-bold" style="color: var(--text-primary);">{{ tournament.format.label|trans }}</p>
            <p class="text-sm" style="color: var(--text-muted);">Format</p>
        </div>
    </div>

    {# Final standings table #}
    <div class="rounded-lg shadow overflow-hidden" style="background-color: var(--card-bg);">
        <table class="min-w-full" style="border-collapse: separate; border-spacing: 0;">
            <thead style="background-color: var(--bg-subtle);">
                <tr>
                    <th class="px-4 py-3 text-left text-xs font-medium uppercase" style="color: var(--text-muted); border-bottom: 1px solid var(--border-default);">Rang</th>
                    <th class="px-4 py-3 text-left text-xs font-medium uppercase" style="color: var(--text-muted); border-bottom: 1px solid var(--border-default);">Joueur</th>
                    <th class="px-4 py-3 text-center text-xs font-medium uppercase" style="color: var(--text-muted); border-bottom: 1px solid var(--border-default);">Heros</th>
                    <th class="px-4 py-3 text-center text-xs font-medium uppercase" style="color: var(--text-muted); border-bottom: 1px solid var(--border-default);">V</th>
                    <th class="px-4 py-3 text-center text-xs font-medium uppercase" style="color: var(--text-muted); border-bottom: 1px solid var(--border-default);">N</th>
                    <th class="px-4 py-3 text-center text-xs font-medium uppercase" style="color: var(--text-muted); border-bottom: 1px solid var(--border-default);">D</th>
                    <th class="px-4 py-3 text-center text-xs font-medium uppercase" style="color: var(--text-muted); border-bottom: 1px solid var(--border-default);">Points</th>
                    <th class="px-4 py-3 text-center text-xs font-medium uppercase" style="color: var(--text-muted); border-bottom: 1px solid var(--border-default);">OMW%</th>
                    <th class="px-4 py-3 text-center text-xs font-medium uppercase" style="color: var(--text-muted); border-bottom: 1px solid var(--border-default);">GW%</th>
                </tr>
            </thead>
            <tbody style="background-color: var(--card-bg);">
                {% for entry in standings %}
                    <tr style="{% if loop.index <= 3 %}background-color: var(--bg-yellow-50, #fefce8);{% endif %}">
                        <td class="px-4 py-3 whitespace-nowrap text-sm" style="border-bottom: 1px solid var(--border-default);">
                            {% if loop.index == 1 %}
                                <span class="inline-flex items-center justify-center w-8 h-8 rounded-full bg-yellow-400 text-white font-bold">1</span>
                            {% elseif loop.index == 2 %}
                                <span class="inline-flex items-center justify-center w-8 h-8 rounded-full bg-gray-300 text-white font-bold">2</span>
                            {% elseif loop.index == 3 %}
                                <span class="inline-flex items-center justify-center w-8 h-8 rounded-full bg-amber-600 text-white font-bold">3</span>
                            {% else %}
                                <span class="ml-2" style="color: var(--text-secondary);">{{ loop.index }}</span>
                            {% endif %}
                        </td>
                        <td class="px-4 py-3 whitespace-nowrap text-sm font-medium" style="color: var(--text-primary); border-bottom: 1px solid var(--border-default);">
                            {{ entry.registration.player.displayName }}
                        </td>
                        <td class="px-4 py-3 whitespace-nowrap text-sm text-center" style="border-bottom: 1px solid var(--border-default);">
                            {% if entry.registration.hero %}
                                <div class="flex flex-col items-center">
                                    <div class="w-10 h-10 rounded-full overflow-hidden border-2 mb-1" style="border-color: {{ entry.registration.faction ? entry.registration.faction.color : 'var(--border-muted)' }};">
                                        <img src="{{ entry.registration.heroImage }}" alt="{{ entry.registration.heroLabel }}" class="w-full h-full object-cover" onerror="this.parentElement.innerHTML='<div class=\'w-full h-full flex items-center justify-center bg-gray-200\'><span class=\'text-xs text-gray-500\'>?</span></div>'">
                                    </div>
                                    <span class="text-xs" style="color: var(--text-muted);">{{ entry.registration.heroLabel }}</span>
                                </div>
                            {% else %}
                                <span class="text-xs" style="color: var(--text-muted);">-</span>
                            {% endif %}
                        </td>
                        <td class="px-4 py-3 whitespace-nowrap text-sm text-center text-green-600 font-medium" style="border-bottom: 1px solid var(--border-default);">
                            {{ entry.wins }}
                        </td>
                        <td class="px-4 py-3 whitespace-nowrap text-sm text-center text-amber-600" style="border-bottom: 1px solid var(--border-default);">
                            {{ entry.draws }}
                        </td>
                        <td class="px-4 py-3 whitespace-nowrap text-sm text-center text-red-600" style="border-bottom: 1px solid var(--border-default);">
                            {{ entry.losses }}
                        </td>
                        <td class="px-4 py-3 whitespace-nowrap text-sm text-center font-bold" style="border-bottom: 1px solid var(--border-default);">
                            {{ entry.matchPoints }}
                        </td>
                        <td class="px-4 py-3 whitespace-nowrap text-sm text-center" style="color: var(--text-muted); border-bottom: 1px solid var(--border-default);">
                            {{ (entry.opponentMatchWinPercentage * 100)|number_format(1) }}%
                        </td>
                        <td class="px-4 py-3 whitespace-nowrap text-sm text-center" style="color: var(--text-muted); border-bottom: 1px solid var(--border-default);">
                            {{ (entry.gameWinPercentage * 100)|number_format(1) }}%
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="9" class="px-4 py-8 text-center" style="color: var(--text-muted);">
                            Aucun classement disponible.
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    {# Legend #}
    <div class="mt-4 text-xs" style="color: var(--text-muted);">
        <p>V = Victoires | N = Nuls (egalites) | D = Defaites | Points = Points de match | OMW% = % victoires adversaires | GW% = % victoires games</p>
    </div>
</div>
{% endblock %}
