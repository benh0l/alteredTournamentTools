{% extends 'base.html.twig' %}

{% block title %}{{ 'dispute.list.page_title'|trans({'%tournament%': tournament.name}) }}{% endblock %}

{% block body %}
<div class="max-w-4xl mx-auto px-4 py-6">
    <div class="mb-6">
        <a href="{{ path('round_list', {id: tournament.id}) }}" class="font-medium hover:underline" style="color: var(--color-primary-600);">
            &larr; {{ 'dispute.list.back_to_rounds'|trans }}
        </a>
    </div>

    <div class="flex justify-between items-center mb-6">
        <h1 class="text-3xl font-bold" style="color: var(--text-primary);">{{ 'dispute.list.title'|trans }}</h1>
        <span style="color: var(--text-secondary);">{{ tournament.name }}</span>
    </div>

    {% if disputes|length == 0 %}
        <div class="bg-green-500/10 dark:bg-green-500/20 border border-green-200 dark:border-green-500/30 rounded-lg p-6 text-center">
            <div class="w-16 h-16 bg-green-500/20 rounded-full flex items-center justify-center mx-auto mb-4">
                {{ ux_icon('lucide:check', {class: 'w-8 h-8 text-green-600 dark:text-green-400'}) }}
            </div>
            <p class="text-green-800 dark:text-green-300 font-medium">{{ 'dispute.list.no_disputes'|trans }}</p>
            <p class="text-green-600 dark:text-green-400 text-sm mt-1">{{ 'dispute.list.all_results_ok'|trans }}</p>
        </div>
    {% else %}
        <div class="rounded-lg shadow overflow-hidden" style="background-color: var(--card-bg);">
            <table class="min-w-full divide-y" style="border-color: var(--border-default);">
                <thead style="background-color: var(--bg-subtle);">
                    <tr>
                        <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider" style="color: var(--text-muted);">
                            {{ 'common.round'|trans }}
                        </th>
                        <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider" style="color: var(--text-muted);">
                            {{ 'common.table'|trans }}
                        </th>
                        <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider" style="color: var(--text-muted);">
                            {{ 'common.players'|trans }}
                        </th>
                        <th class="px-6 py-3 text-right text-xs font-medium uppercase tracking-wider" style="color: var(--text-muted);">
                            {{ 'common.actions'|trans }}
                        </th>
                    </tr>
                </thead>
                <tbody class="divide-y" style="background-color: var(--card-bg); border-color: var(--border-default);">
                    {% for dispute in disputes %}
                        <tr class="hover:opacity-80 transition-opacity">
                            <td class="px-6 py-4 whitespace-nowrap text-sm" style="color: var(--text-primary);">
                                {{ 'dashboard.round.title'|trans({'%number%': dispute.round.roundNumber}) }}
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm" style="color: var(--text-primary);">
                                {{ 'common.table'|trans }} {{ dispute.tableNumber }}
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm" style="color: var(--text-primary);">
                                {{ dispute.player1.player.displayName }} vs {{ dispute.player2.player.displayName }}
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-right text-sm">
                                <a href="{{ path('dispute_show', {tournamentId: tournament.id, matchId: dispute.id}) }}"
                                   class="inline-flex items-center px-3 py-1 bg-red-500/20 text-red-700 dark:text-red-300 rounded-full hover:bg-red-500/30 transition-colors">
                                    {{ 'dashboard.matches.resolve'|trans }}
                                </a>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        <p class="text-sm mt-4" style="color: var(--text-muted);">
            {{ 'dispute.list.disputes_to_resolve'|trans({'%count%': disputes|length}) }}
        </p>
    {% endif %}
</div>
{% endblock %}
