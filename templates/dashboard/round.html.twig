{% extends 'base.html.twig' %}

{% block title %}{{ 'dashboard.round.page_title'|trans({'%number%': round.roundNumber, '%tournament%': tournament.name}) }}{% endblock %}

{% block body %}
<div class="max-w-7xl mx-auto">
    {# Header with tournament info #}
    <div class="mb-6 flex items-center justify-between gap-4">
        <div class="min-w-0 flex-1">
            <h1 class="text-2xl sm:text-3xl font-bold truncate" style="color: var(--text-primary);">{{ tournament.name }}</h1>
            <p class="mt-1 text-sm sm:text-base" style="color: var(--text-secondary);">
                {% if can_manage %}{{ 'dashboard.title_organizer'|trans }}{% else %}{{ 'dashboard.title'|trans }}{% endif %} - {{ 'dashboard.round.title'|trans({'%number%': round.roundNumber}) }}
            </p>
        </div>
        <a href="{{ path('tournament_dashboard', {id: tournament.id}) }}" class="inline-flex items-center px-4 py-2 font-medium rounded-xl border-2 shadow-md hover:shadow-lg transition-all duration-200 flex-shrink-0" style="background-color: var(--card-bg); color: var(--color-primary-600); border-color: var(--color-primary-200);">
            {{ ux_icon('lucide:arrow-left', {class: 'w-4 h-4 sm:mr-2'}) }}
            <span class="hidden sm:inline">{{ 'dashboard.round.back_to_dashboard'|trans }}</span>
        </a>
    </div>

    {# Main grid layout #}
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        {# Left column: Round info + Navigation #}
        <div class="lg:col-span-1 space-y-6">
            {# Round info card #}
            <div class="rounded-lg shadow p-6" style="background-color: var(--card-bg);">
                <h2 class="text-lg font-semibold mb-4" style="color: var(--text-primary);">{{ 'dashboard.round.title'|trans({'%number%': round.roundNumber}) }}</h2>

                <div class="space-y-3">
                    <div class="flex justify-between items-center">
                        <span style="color: var(--text-secondary);">{{ 'dashboard.round.info.status'|trans }}</span>
                        <span class="{{ round.status.badgeClasses }} px-2 py-1 rounded text-sm">
                            {{ round.status.label|trans }}
                        </span>
                    </div>

                    {% if round.startedAt %}
                        <div class="flex justify-between items-center">
                            <span style="color: var(--text-secondary);">{{ 'dashboard.round.info.started'|trans }}</span>
                            <span class="text-sm" style="color: var(--text-primary);">
                                {{ round.startedAt|date('d/m/Y H:i') }}
                            </span>
                        </div>
                    {% endif %}

                    {% if round.completedAt %}
                        <div class="flex justify-between items-center">
                            <span style="color: var(--text-secondary);">{{ 'dashboard.round.info.completed'|trans }}</span>
                            <span class="text-sm" style="color: var(--text-primary);">
                                {{ round.completedAt|date('d/m/Y H:i') }}
                            </span>
                        </div>
                    {% endif %}

                    <div class="flex justify-between items-center">
                        <span style="color: var(--text-secondary);">{{ 'dashboard.round.info.total_matches'|trans }}</span>
                        <span class="font-medium" style="color: var(--text-primary);">{{ matches|length }}</span>
                    </div>

                    <div class="flex justify-between items-center">
                        <span style="color: var(--text-secondary);">{{ 'dashboard.round.info.completed_count'|trans }}</span>
                        <span class="font-medium text-green-600">{{ round.completedMatchesCount }}</span>
                    </div>

                    {% if round.hasDisputes %}
                        <div class="flex justify-between items-center">
                            <span style="color: var(--text-secondary);">{{ 'dashboard.round.info.disputes'|trans }}</span>
                            <span class="font-medium text-red-600">
                                {{ round.matches|filter(m => m.disputed)|length }}
                            </span>
                        </div>
                    {% endif %}
                </div>

                {# Duration if completed #}
                {% if round.startedAt and round.completedAt %}
                    {% set duration = round.completedAt.timestamp - round.startedAt.timestamp %}
                    <div class="mt-4 pt-4" style="border-top: 1px solid var(--border-default);">
                        <div class="text-center">
                            <span class="text-2xl font-bold" style="color: var(--text-secondary);">
                                {{ (duration / 60)|round }}
                            </span>
                            <span style="color: var(--text-muted);">{{ 'dashboard.round.info.min'|trans }}</span>
                            <p class="text-xs mt-1" style="color: var(--text-muted);">{{ 'dashboard.round.info.duration'|trans }}</p>
                        </div>
                    </div>
                {% endif %}
            </div>

            {# Round navigation #}
            <div class="rounded-lg shadow p-6" style="background-color: var(--card-bg);">
                <h2 class="text-lg font-semibold mb-4" style="color: var(--text-primary);">{{ 'dashboard.rounds.title'|trans }}</h2>
                <div class="space-y-2">
                    {% for r in rounds %}
                        <a href="{{ path('tournament_dashboard_round', {id: tournament.id, roundNumber: r.roundNumber}) }}"
                           class="block px-4 py-2 rounded-lg border {% if r.id == round.id %}bg-blue-500/10 border-blue-300 dark:border-blue-500/50{% elseif current_round and r.id == current_round.id %}bg-green-500/10 border-green-300 dark:border-green-500/50{% else %}{% endif %}" style="{% if not (r.id == round.id) and not (current_round and r.id == current_round.id) %}border-color: var(--border-default);{% endif %}">
                            <div class="flex justify-between items-center">
                                <span class="font-medium" style="color: var(--text-primary);">
                                    {{ 'dashboard.round.title'|trans({'%number%': r.roundNumber}) }}
                                    {% if current_round and r.id == current_round.id %}
                                        <span class="text-xs text-green-600">{{ 'dashboard.rounds.current'|trans }}</span>
                                    {% endif %}
                                </span>
                                <span class="{{ r.status.badgeClasses }} px-2 py-1 rounded text-xs">
                                    {{ r.status.label|trans }}
                                </span>
                            </div>
                        </a>
                    {% endfor %}
                </div>
            </div>
        </div>

        {# Right column: Matches list #}
        <div class="lg:col-span-2">
            <div class="rounded-lg shadow overflow-hidden" style="background-color: var(--card-bg);">
                <div class="px-6 py-4" style="background-color: var(--bg-subtle); border-bottom: 1px solid var(--border-default);">
                    <div class="flex justify-between items-center">
                        <h2 class="text-lg font-semibold" style="color: var(--text-primary);">
                            {{ 'dashboard.matches.title'|trans({'%number%': round.roundNumber}) }}
                        </h2>
                        <a href="{{ path('round_standings', {id: tournament.id}) }}"
                           class="inline-flex items-center px-3 py-1.5 text-sm font-medium rounded-xl border-2 shadow-sm hover:shadow-md transition-all duration-200"
                           style="background-color: var(--card-bg); color: var(--color-primary-600); border-color: var(--color-primary-200);">
                            {{ 'dashboard.matches.standings'|trans }}
                            {{ ux_icon('lucide:arrow-right', {class: 'w-4 h-4 ml-1'}) }}
                        </a>
                    </div>
                </div>

                {# Mobile view: Cards #}
                <div class="lg:hidden p-4 space-y-3">
                    {% for match in matches %}
                        <div class="rounded-lg p-4 {% if match.disputed %}bg-red-500/10{% endif %}" style="background-color: var(--bg-subtle); border: 1px solid var(--border-default);">
                            {# Header: Table number + Status #}
                            <div class="flex justify-between items-center mb-3">
                                <span class="text-xs font-medium px-2 py-1 rounded" style="background-color: var(--card-bg); color: var(--text-secondary);">
                                    {{ 'common.table'|trans }} {{ match.tableNumber }}
                                </span>
                                <span class="{{ match.status.badgeClasses }} px-2 py-1 rounded text-xs">
                                    {{ match.status.label|trans }}
                                </span>
                            </div>

                            {# Players and Score #}
                            <div class="flex items-center justify-between gap-2">
                                {# Player 1 #}
                                <div class="flex-1 text-center">
                                    <div class="text-sm font-medium truncate {% if match.winner and match.winner == match.player1 %}text-green-600{% endif %}" style="{% if not (match.winner and match.winner == match.player1) %}color: var(--text-primary);{% endif %}">
                                        {{ match.player1.player.displayName }}
                                    </div>
                                    {% if match.winner and match.winner == match.player1 %}
                                        <div class="text-xs text-green-600">{{ 'dashboard.matches.winner'|trans }}</div>
                                    {% endif %}
                                </div>

                                {# Score #}
                                <div class="flex-shrink-0 px-3">
                                    {% if match.completed %}
                                        {% if match.winner %}
                                            <span class="text-lg font-bold" style="color: var(--text-primary);">{{ match.player1Score ?? '-' }} - {{ match.player2Score ?? '-' }}</span>
                                        {% else %}
                                            <span class="text-lg font-bold text-amber-600" title="{{ 'dashboard.matches.draw'|trans }}">{{ match.player1Score ?? '-' }} - {{ match.player2Score ?? '-' }}</span>
                                        {% endif %}
                                    {% elseif match.isByeMatch %}
                                        <span class="text-sm" style="color: var(--text-muted);">{{ 'home.bye'|trans }}</span>
                                    {% else %}
                                        <span class="text-lg font-bold" style="color: var(--text-muted);">vs</span>
                                    {% endif %}
                                </div>

                                {# Player 2 #}
                                <div class="flex-1 text-center">
                                    {% if match.player2 %}
                                        <div class="text-sm font-medium truncate {% if match.winner and match.player2 and match.winner == match.player2 %}text-green-600{% endif %}" style="{% if not (match.winner and match.player2 and match.winner == match.player2) %}color: var(--text-primary);{% endif %}">
                                            {{ match.player2.player.displayName }}
                                        </div>
                                        {% if match.winner and match.winner == match.player2 %}
                                            <div class="text-xs text-green-600">{{ 'dashboard.matches.winner'|trans }}</div>
                                        {% endif %}
                                    {% else %}
                                        <span class="text-sm italic" style="color: var(--text-muted);">{{ 'home.bye'|trans }}</span>
                                    {% endif %}
                                </div>
                            </div>

                            {# Action button #}
                            <div class="mt-3 pt-3" style="border-top: 1px solid var(--border-default);">
                                {% if can_manage and match.disputed %}
                                    <a href="{{ path('dispute_show', {tournamentId: tournament.id, matchId: match.id}) }}"
                                       class="block w-full text-center px-4 py-2 bg-red-500 text-white rounded-lg text-sm font-medium hover:bg-red-600 transition-colors">
                                        {{ 'dashboard.matches.resolve'|trans }}
                                    </a>
                                {% elseif not match.completed and not match.isByeMatch %}
                                    {# Check if current user is a player in this match (but not if they're the organizer) #}
                                    {% set isPlayerInMatch = app.user and not can_manage and (
                                        (match.player1 and match.player1.player.id == app.user.id) or
                                        (match.player2 and match.player2.player.id == app.user.id)
                                    ) %}
                                    {% if isPlayerInMatch %}
                                        <a href="{{ path('match_submit_form', {id: match.id}) }}"
                                           class="block w-full text-center px-4 py-2 bg-gradient-to-r from-emerald-500 to-teal-500 text-white rounded-lg text-sm font-semibold hover:from-emerald-600 hover:to-teal-600 transition-all shadow-sm">
                                            {{ ux_icon('lucide:check-circle', {class: 'w-4 h-4 inline mr-1'}) }}
                                            {{ 'dashboard.matches.submit'|trans }}
                                        </a>
                                    {% else %}
                                        <a href="{{ path('match_show', {id: match.id}) }}"
                                           class="block w-full text-center px-4 py-2 rounded-lg text-sm font-medium transition-colors" style="background-color: var(--card-bg); color: var(--color-primary-600); border: 1px solid var(--border-default);">
                                            {{ 'common.details'|trans }}
                                        </a>
                                    {% endif %}
                                {% else %}
                                    <span class="block text-center text-sm" style="color: var(--text-muted);">
                                        {% if match.completed %}{{ 'dashboard.matches.match_completed'|trans }}{% else %}-{% endif %}
                                    </span>
                                {% endif %}
                            </div>
                        </div>
                    {% else %}
                        <div class="text-center py-8" style="color: var(--text-muted);">
                            {{ 'dashboard.round.no_matches'|trans }}
                        </div>
                    {% endfor %}
                </div>

                {# Desktop view: Table #}
                <div class="hidden lg:block overflow-x-auto">
                    <table class="min-w-full" style="border-collapse: separate; border-spacing: 0;">
                        <thead style="background-color: var(--bg-subtle);">
                            <tr>
                                <th class="px-4 py-3 text-left text-xs font-medium uppercase" style="color: var(--text-muted); border-bottom: 1px solid var(--border-default);">{{ 'common.table'|trans }}</th>
                                <th class="px-4 py-3 text-left text-xs font-medium uppercase" style="color: var(--text-muted); border-bottom: 1px solid var(--border-default);">{{ 'dashboard.matches.player1'|trans }}</th>
                                <th class="px-4 py-3 text-center text-xs font-medium uppercase" style="color: var(--text-muted); border-bottom: 1px solid var(--border-default);">{{ 'common.score'|trans }}</th>
                                <th class="px-4 py-3 text-right text-xs font-medium uppercase" style="color: var(--text-muted); border-bottom: 1px solid var(--border-default);">{{ 'dashboard.matches.player2'|trans }}</th>
                                <th class="px-4 py-3 text-center text-xs font-medium uppercase" style="color: var(--text-muted); border-bottom: 1px solid var(--border-default);">{{ 'common.status'|trans }}</th>
                                <th class="px-4 py-3 text-center text-xs font-medium uppercase" style="color: var(--text-muted); border-bottom: 1px solid var(--border-default);">{{ 'common.actions'|trans }}</th>
                            </tr>
                        </thead>
                        <tbody style="background-color: var(--card-bg);">
                            {% for match in matches %}
                                <tr class="{% if match.disputed %}bg-red-500/10{% endif %}" style="border-bottom: 1px solid var(--border-default);">
                                    <td class="px-4 py-3 whitespace-nowrap text-sm font-medium" style="color: var(--text-primary);">
                                        {{ match.tableNumber }}
                                    </td>
                                    <td class="px-4 py-3 whitespace-nowrap text-sm {% if match.winner and match.winner == match.player1 %}font-bold text-green-600{% endif %}" style="{% if not (match.winner and match.winner == match.player1) %}color: var(--text-primary);{% endif %}">
                                        {{ match.player1.player.displayName }}
                                    </td>
                                    <td class="px-4 py-3 whitespace-nowrap text-sm text-center" style="color: var(--text-primary);">
                                        {% if match.completed %}
                                            {% if match.winner %}
                                                <span class="font-medium">{{ match.player1Score ?? '-' }} - {{ match.player2Score ?? '-' }}</span>
                                            {% else %}
                                                <span class="font-medium text-amber-600" title="{{ 'dashboard.matches.draw'|trans }}">{{ match.player1Score ?? '-' }} - {{ match.player2Score ?? '-' }}</span>
                                            {% endif %}
                                        {% elseif match.isByeMatch %}
                                            <span style="color: var(--text-muted);">{{ 'home.bye'|trans }}</span>
                                        {% else %}
                                            <span style="color: var(--text-muted);">-</span>
                                        {% endif %}
                                    </td>
                                    <td class="px-4 py-3 whitespace-nowrap text-sm text-right {% if match.winner and match.player2 and match.winner == match.player2 %}font-bold text-green-600{% endif %}" style="{% if not (match.winner and match.player2 and match.winner == match.player2) %}color: var(--text-primary);{% endif %}">
                                        {% if match.player2 %}
                                            {{ match.player2.player.displayName }}
                                        {% else %}
                                            <span class="italic" style="color: var(--text-muted);">{{ 'home.bye'|trans }}</span>
                                        {% endif %}
                                    </td>
                                    <td class="px-4 py-3 whitespace-nowrap text-center">
                                        <span class="{{ match.status.badgeClasses }} px-2 py-1 rounded text-xs">
                                            {{ match.status.label|trans }}
                                        </span>
                                    </td>
                                    <td class="px-4 py-3 whitespace-nowrap text-center">
                                        {% if can_manage and match.disputed %}
                                            <a href="{{ path('dispute_show', {tournamentId: tournament.id, matchId: match.id}) }}"
                                               class="text-red-600 hover:underline text-sm font-medium">
                                                {{ 'dashboard.matches.resolve'|trans }}
                                            </a>
                                        {% elseif not match.completed and not match.isByeMatch %}
                                            {# Check if current user is a player in this match (but not if they're the organizer) #}
                                            {% set isPlayerInMatch = app.user and not can_manage and (
                                                (match.player1 and match.player1.player.id == app.user.id) or
                                                (match.player2 and match.player2.player.id == app.user.id)
                                            ) %}
                                            {% if isPlayerInMatch %}
                                                <a href="{{ path('match_submit_form', {id: match.id}) }}"
                                                   class="inline-flex items-center px-3 py-1.5 bg-gradient-to-r from-emerald-500 to-teal-500 text-white rounded-lg text-sm font-semibold hover:from-emerald-600 hover:to-teal-600 transition-all shadow-sm">
                                                    {{ ux_icon('lucide:check-circle', {class: 'w-4 h-4 mr-1'}) }}
                                                    {{ 'dashboard.matches.submit'|trans }}
                                                </a>
                                            {% else %}
                                                <a href="{{ path('match_show', {id: match.id}) }}"
                                                   class="hover:underline text-sm" style="color: var(--color-primary-600);">
                                                    {{ 'common.details'|trans }}
                                                </a>
                                            {% endif %}
                                        {% else %}
                                            <span class="text-sm" style="color: var(--text-muted);">-</span>
                                        {% endif %}
                                    </td>
                                </tr>
                            {% else %}
                                <tr>
                                    <td colspan="6" class="px-4 py-8 text-center" style="color: var(--text-muted);">
                                        {{ 'dashboard.round.no_matches'|trans }}
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>

                {# Footer with summary #}
                <div class="px-6 py-4" style="background-color: var(--bg-subtle); border-top: 1px solid var(--border-default);">
                    <div class="text-sm" style="color: var(--text-secondary);">
                        {{ 'dashboard.round.matches_completed'|trans({'%completed%': round.completedMatchesCount, '%total%': matches|length}) }}
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
