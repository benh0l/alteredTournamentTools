{% extends 'base.html.twig' %}

{% block title %}Tailwind CSS Test{% endblock %}

{% block body %}
<div class="max-w-4xl mx-auto">
    <h1 class="text-3xl font-bold mb-6">Tailwind CSS Test Page</h1>

    {# Responsive breakpoints test #}
    <section class="mb-8">
        <h2 class="text-xl font-semibold mb-4">Responsive Breakpoints</h2>
        <div class="p-4 bg-red-500 md:bg-yellow-500 lg:bg-green-500 rounded-lg text-white">
            <p class="block md:hidden">Mobile View (&lt; 768px)</p>
            <p class="hidden md:block lg:hidden">Tablet View (768-1024px)</p>
            <p class="hidden lg:block">Desktop View (&gt; 1024px)</p>
        </div>
    </section>

    {# Custom colors test #}
    <section class="mb-8">
        <h2 class="text-xl font-semibold mb-4">Custom Colors</h2>
        <div class="flex flex-wrap gap-4">
            <div class="p-4 bg-tournament-primary text-white rounded-lg">Primary</div>
            <div class="p-4 bg-tournament-secondary text-white rounded-lg">Secondary</div>
            <div class="p-4 bg-tournament-success text-white rounded-lg">Success</div>
            <div class="p-4 bg-tournament-warning text-white rounded-lg">Warning</div>
            <div class="p-4 bg-tournament-danger text-white rounded-lg">Danger</div>
        </div>
    </section>

    {# Timer colors test #}
    <section class="mb-8">
        <h2 class="text-xl font-semibold mb-4">Timer Colors (FR43)</h2>
        <div class="flex flex-wrap gap-4">
            <div class="p-4 bg-timer-green text-white rounded-lg">Green (0-30 min)</div>
            <div class="p-4 bg-timer-orange text-white rounded-lg">Orange (30-45 min)</div>
            <div class="p-4 bg-timer-red text-white rounded-lg">Red (45+ min)</div>
        </div>
    </section>

    {# Button components test #}
    <section class="mb-8">
        <h2 class="text-xl font-semibold mb-4">Buttons (Touch-friendly - NFR32)</h2>
        <div class="flex flex-wrap gap-4">
            <button class="btn-primary">Primary Button</button>
            <button class="btn-secondary">Secondary Button</button>
            <button class="btn-success">Success Button</button>
            <button class="btn-danger">Danger Button</button>
        </div>
    </section>

    {# Badge components test #}
    <section class="mb-8">
        <h2 class="text-xl font-semibold mb-4">Match Status Badges</h2>
        <div class="flex flex-wrap gap-4">
            <span class="badge-pending">Pending</span>
            <span class="badge-ongoing">Ongoing</span>
            <span class="badge-completed">Completed</span>
            <span class="badge-dispute">Dispute</span>
        </div>
    </section>

    {# Card component test #}
    <section class="mb-8">
        <h2 class="text-xl font-semibold mb-4">Card Component</h2>
        <div class="card">
            <h3 class="text-lg font-semibold mb-2">Tournament Card</h3>
            <p class="text-gray-600 mb-4">This is a sample tournament description.</p>
            <div class="flex justify-between items-center">
                <span class="badge-ongoing">En cours</span>
                <button class="btn-primary">Voir</button>
            </div>
        </div>
    </section>

    {# Form elements test #}
    <section class="mb-8">
        <h2 class="text-xl font-semibold mb-4">Form Elements</h2>
        <form class="space-y-4 max-w-md">
            <div>
                <label for="name" class="form-label">Nom du tournoi</label>
                <input type="text" id="name" class="form-input" placeholder="Entrez le nom">
            </div>
            <div>
                <label for="format" class="form-label">Format</label>
                <select id="format" class="form-input">
                    <option>Construit</option>
                    <option>Limite</option>
                </select>
            </div>
            <button type="submit" class="btn-primary w-full">Creer le tournoi</button>
        </form>
    </section>

    {# Accessibility test - Focus visible (NFR62) #}
    <section class="mb-8">
        <h2 class="text-xl font-semibold mb-4">Accessibility - Focus Visible</h2>
        <p class="text-gray-600 mb-2">Use Tab key to navigate between these buttons:</p>
        <div class="flex gap-4">
            <button class="btn-primary">Button 1</button>
            <button class="btn-secondary">Button 2</button>
            <a href="#" class="btn-primary">Link Button</a>
        </div>
    </section>
</div>
{% endblock %}
