{% if app.user and not app.user.guest %}
<div data-controller="onboarding"
     data-onboarding-storage-key-value="att_onboarding_seen">

    <div data-onboarding-target="backdrop"
         class="hidden fixed inset-0 z-[60] flex items-center justify-center p-4"
         style="background: rgba(0,0,0,0.6); backdrop-filter: blur(2px);">

        <div data-onboarding-target="modal"
             class="relative w-full max-w-lg rounded-2xl shadow-2xl p-8"
             style="background-color: var(--card-bg); border: 1px solid var(--border-default);">

            <button data-action="click->onboarding#dismiss"
                    class="absolute top-4 right-4 p-1.5 rounded-lg transition-colors hover:opacity-70"
                    style="color: var(--text-muted);"
                    aria-label="{{ 'action.close'|trans }}">
                {{ ux_icon('lucide:x', {class: 'w-5 h-5'}) }}
            </button>

            <div class="text-center mb-6">
                <div class="inline-flex items-center justify-center w-16 h-16 rounded-2xl mb-4 theme-primary-gradient">
                    {{ ux_icon('lucide:trophy', {class: 'w-8 h-8 text-white'}) }}
                </div>
                <h2 class="text-2xl font-bold mb-2" style="color: var(--text-primary);">
                    {{ 'onboarding.title'|trans }}
                </h2>
                <p class="text-sm" style="color: var(--text-muted);">
                    {{ 'onboarding.subtitle'|trans }}
                </p>
            </div>

            <div class="space-y-3 mb-6">
                <a href="{{ path('tournament_list') }}"
                   data-action="click->onboarding#dismiss"
                   class="flex items-center gap-4 p-4 rounded-xl border-2 transition-all"
                   style="border-color: var(--border-default);"
                   onmouseover="this.style.borderColor='var(--color-primary-300)'; this.style.backgroundColor='var(--bg-subtle)';"
                   onmouseout="this.style.borderColor='var(--border-default)'; this.style.backgroundColor='transparent';">
                    <div class="w-10 h-10 rounded-xl bg-blue-500/20 flex items-center justify-center flex-shrink-0">
                        {{ ux_icon('lucide:search', {class: 'w-5 h-5 text-blue-600 dark:text-blue-400'}) }}
                    </div>
                    <div class="flex-1">
                        <div class="font-semibold text-sm" style="color: var(--text-primary);">{{ 'onboarding.action.browse.title'|trans }}</div>
                        <div class="text-xs mt-0.5" style="color: var(--text-muted);">{{ 'onboarding.action.browse.desc'|trans }}</div>
                    </div>
                    {{ ux_icon('lucide:chevron-right', {class: 'w-4 h-4 flex-shrink-0', style: 'color: var(--text-muted);'}) }}
                </a>

                <a href="{{ path('tournament_create') }}"
                   data-action="click->onboarding#dismiss"
                   class="flex items-center gap-4 p-4 rounded-xl border-2 transition-all"
                   style="border-color: var(--border-default);"
                   onmouseover="this.style.borderColor='var(--color-primary-300)'; this.style.backgroundColor='var(--bg-subtle)';"
                   onmouseout="this.style.borderColor='var(--border-default)'; this.style.backgroundColor='transparent';">
                    <div class="w-10 h-10 rounded-xl flex items-center justify-center flex-shrink-0" style="background-color: var(--color-primary-100);">
                        {{ ux_icon('lucide:plus-circle', {class: 'w-5 h-5', style: 'color: var(--color-primary-600);'}) }}
                    </div>
                    <div class="flex-1">
                        <div class="font-semibold text-sm" style="color: var(--text-primary);">{{ 'onboarding.action.create.title'|trans }}</div>
                        <div class="text-xs mt-0.5" style="color: var(--text-muted);">{{ 'onboarding.action.create.desc'|trans }}</div>
                    </div>
                    {{ ux_icon('lucide:chevron-right', {class: 'w-4 h-4 flex-shrink-0', style: 'color: var(--text-muted);'}) }}
                </a>

                <a href="{{ path('tournament_list') }}"
                   data-action="click->onboarding#dismiss"
                   class="flex items-center gap-4 p-4 rounded-xl border-2 transition-all"
                   style="border-color: var(--border-default);"
                   onmouseover="this.style.borderColor='var(--color-primary-300)'; this.style.backgroundColor='var(--bg-subtle)';"
                   onmouseout="this.style.borderColor='var(--border-default)'; this.style.backgroundColor='transparent';">
                    <div class="w-10 h-10 rounded-xl bg-green-500/20 flex items-center justify-center flex-shrink-0">
                        {{ ux_icon('lucide:user-plus', {class: 'w-5 h-5 text-green-600 dark:text-green-400'}) }}
                    </div>
                    <div class="flex-1">
                        <div class="font-semibold text-sm" style="color: var(--text-primary);">{{ 'onboarding.action.register.title'|trans }}</div>
                        <div class="text-xs mt-0.5" style="color: var(--text-muted);">{{ 'onboarding.action.register.desc'|trans }}</div>
                    </div>
                    {{ ux_icon('lucide:chevron-right', {class: 'w-4 h-4 flex-shrink-0', style: 'color: var(--text-muted);'}) }}
                </a>
            </div>

            <button data-action="click->onboarding#dismiss"
                    class="w-full py-3 rounded-xl font-semibold text-white transition-all theme-primary-gradient hover:opacity-90">
                {{ 'onboarding.cta'|trans }}
            </button>
        </div>
    </div>
</div>
{% endif %}
