{% extends 'base.html.twig' %}

{% block title %}Choisir un pseudo{% endblock %}

{% block body %}
<div class="min-h-screen py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-md mx-auto">
        {# Header #}
        <div class="text-center mb-8">
            <div class="inline-flex items-center justify-center w-16 h-16 rounded-2xl shadow-lg mb-4 theme-primary-gradient">
                {{ ux_icon('lucide:user-plus', {class: 'w-8 h-8 text-white'}) }}
            </div>
            <h1 class="text-3xl font-bold" style="color: var(--text-primary);">Choisir un pseudo</h1>
            <p class="mt-2" style="color: var(--text-secondary);">
                Le pseudo "{{ original_pseudo }}" est déjà utilisé. Veuillez en choisir un autre.
            </p>
        </div>

        {# Form Card #}
        <div class="rounded-2xl shadow-xl overflow-hidden" style="background-color: var(--card-bg);">
            <div class="p-8">
                {{ form_start(form, {'attr': {'class': 'space-y-6'}}) }}

                    {# Pseudo choices #}
                    <div>
                        {{ form_label(form.pseudo_choice, null, {'label_attr': {'class': 'form-label mb-3 block'}}) }}
                        <div class="space-y-2">
                            {% for child in form.pseudo_choice %}
                                <div class="flex items-center">
                                    {{ form_widget(child, {'attr': {'class': 'h-4 w-4 rounded', 'style': 'accent-color: var(--color-primary-600);'}}) }}
                                    {{ form_label(child, null, {'label_attr': {'class': 'ml-3 text-sm', 'style': 'color: var(--text-primary);'}}) }}
                                </div>
                            {% endfor %}
                        </div>
                        {{ form_errors(form.pseudo_choice) }}
                    </div>

                    {# Custom pseudo field #}
                    <div>
                        {{ form_label(form.custom_pseudo, null, {'label_attr': {'class': 'form-label'}}) }}
                        {{ form_widget(form.custom_pseudo, {'attr': {'class': 'form-input w-full mt-1'}}) }}
                        {{ form_errors(form.custom_pseudo) }}
                    </div>

                    {# Submit button #}
                    <div class="pt-2">
                        {{ form_widget(form.submit, {'attr': {
                            'class': 'w-full flex items-center justify-center px-6 py-3 text-white font-semibold rounded-xl shadow-md hover:shadow-lg transition-all',
                            'style': 'background: linear-gradient(135deg, var(--color-primary-500), var(--color-accent-500));'
                        }}) }}
                    </div>

                {{ form_end(form) }}
            </div>
        </div>

        {# Cancel link #}
        <div class="mt-6 text-center">
            <a href="{{ path('app_login') }}" class="font-semibold" style="color: var(--text-secondary);">
                Annuler et retourner à la connexion
            </a>
        </div>
    </div>
</div>
{% endblock %}
