<!DOCTYPE html>
<html lang="{{ app.request.locale }}" data-theme-color="{{ app.user ? app.user.themeColor : 'orange' }}" data-theme-mode="{{ app.user ? app.user.themeMode : 'light' }}">
<head>
    {# Theme initialization - prevents flash of wrong theme #}
    <script>
        (function() {
            const saved = localStorage.getItem('theme');
            if (saved) {
                try {
                    const { color, mode } = JSON.parse(saved);
                    if (color) document.documentElement.setAttribute('data-theme-color', color);
                    if (mode) document.documentElement.setAttribute('data-theme-mode', mode);
                } catch (e) {}
            }
        })();
    </script>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Altered Tournament Tools{% endblock %}</title>
    <link rel="icon" type="image/png" href="{{ asset('logo/alteredTT_logo.png') }}">

    {# Open Graph meta tags for social sharing (FR63) #}
    {% block meta %}
    <meta property="og:title" content="{% block og_title %}Altered Tournament Tools{% endblock %}">
    <meta property="og:description" content="{% block og_description %}{{ 'home.landing.subtitle'|trans }}{% endblock %}">
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="Altered Tournament Tools">
    <meta name="twitter:card" content="summary">
    {% endblock %}

    {% block stylesheets %}
        {# Tailwind CSS via CDN - pour developpement local #}
        <script src="https://cdn.tailwindcss.com"></script>
        <script>
            tailwind.config = {
                theme: {
                    extend: {
                        colors: {
                            'tournament': {
                                'primary': '#f97316',
                                'secondary': '#ea580c',
                                'accent': '#fbbf24',
                                'highlight': '#f43f5e',
                                'success': '#10b981',
                                'warning': '#f59e0b',
                                'danger': '#ef4444',
                            }
                        },
                        minHeight: { 'touch': '44px' },
                        minWidth: { 'touch': '44px' },
                    }
                }
            }
        </script>
        <style>
            body {
                background: linear-gradient(135deg, var(--bg-gradient-from) 0%, var(--bg-gradient-via) 50%, var(--bg-gradient-to) 100%);
                color: var(--text-primary);
                min-height: 100vh;
            }
            /* Accent text with subtle glow - modern heading style */
            .text-accent-glow {
                color: var(--color-accent-500);
                text-shadow: 0 0 20px rgba(245, 158, 11, 0.3);
            }
            /* Gold text - winner/champion style */
            .text-gold {
                color: #f59e0b;
                text-shadow: 0 0 10px rgba(245, 158, 11, 0.4);
            }
            .dark .text-gold {
                color: #fbbf24;
                text-shadow: 0 0 15px rgba(251, 191, 36, 0.5);
            }
            /* Mobile menu styles */
            .mobile-menu-panel {
                transform: translateY(-100%);
                opacity: 0;
                transition: transform 0.3s ease-out, opacity 0.3s ease-out;
            }
            .mobile-menu-panel.mobile-menu-open {
                transform: translateY(0);
                opacity: 1;
            }
            .mobile-menu-panel a:hover {
                background-color: var(--bg-muted);
            }
            .mobile-menu-panel a:active {
                background-color: var(--bg-subtle);
            }
        </style>
    {% endblock %}

    {% block javascripts %}
        {% block importmap %}{{ importmap('app') }}{% endblock %}
    {% endblock %}
</head>
<body class="min-h-screen flex flex-col">
    {# Skip link for accessibility (NFR61) #}
    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-0 focus:left-0 p-2 z-50" style="background-color: var(--card-bg); color: var(--text-primary);">
        {% if app.request.locale == 'fr' %}Aller au contenu principal{% else %}Skip to main content{% endif %}
    </a>

    <header class="shadow-lg theme-header-gradient">
        {% block header %}
            <nav class="container mx-auto px-4 py-4" data-controller="mobile-menu">
                <div class="flex items-center justify-between">
                    <a href="/" class="flex items-center space-x-2 group">
                        <img src="{{ asset('logo/alteredTT_logo.png') }}" alt="Altered Tournament Tools" class="w-10 h-10 rounded-lg shadow-md group-hover:scale-105 transition-transform">
                        <span class="text-xl font-bold text-white drop-shadow-sm hidden sm:inline">
                            Altered Tournament Tools
                        </span>
                        <span class="text-xl font-bold text-white drop-shadow-sm sm:hidden">
                            ATT
                        </span>
                        <span class="px-2 py-0.5 text-xs font-bold uppercase tracking-wider rounded-full bg-white/20 text-white border border-white/30 backdrop-blur-sm">
                            Beta
                        </span>
                    </a>

                    {# Burger button - mobile only #}
                    <button type="button"
                            class="md:hidden p-2 rounded-lg bg-white/10 hover:bg-white/20 transition-colors"
                            data-action="click->mobile-menu#toggle"
                            data-mobile-menu-target="button"
                            aria-expanded="false"
                            aria-label="{% if app.request.locale == 'fr' %}Menu de navigation{% else %}Navigation menu{% endif %}">
                        <span data-mobile-menu-target="iconOpen">
                            {{ ux_icon('lucide:menu', {class: 'w-6 h-6 text-white'}) }}
                        </span>
                        <span data-mobile-menu-target="iconClose" class="hidden">
                            {{ ux_icon('lucide:x', {class: 'w-6 h-6 text-white'}) }}
                        </span>
                    </button>

                    {# Desktop menu #}
                    <div class="hidden md:flex items-center space-x-4">
                        <a href="{{ path('tournament_list') }}"
                           class="px-3 py-2 rounded-lg font-medium transition-all
                                  {% if app.request.attributes.get('_route') == 'tournament_list' %}
                                      bg-white/20 text-white
                                  {% else %}
                                      text-white/90 hover:bg-white/10 hover:text-white
                                  {% endif %}">
                            {{ 'nav.tournaments'|trans }}
                        </a>
                        {% if app.user %}
                            <a href="{{ path('my_tournaments') }}"
                               class="px-3 py-2 rounded-lg font-medium transition-all
                                      {% if app.request.attributes.get('_route') starts with 'my_tournaments' %}
                                          bg-white/20 text-white
                                      {% else %}
                                          text-white/90 hover:bg-white/10 hover:text-white
                                      {% endif %}">
                                {{ 'nav.my_tournaments'|trans }}
                            </a>
                            <a href="{{ path('tournament_my_list') }}"
                               class="px-3 py-2 rounded-lg font-medium transition-all
                                      {% if app.request.attributes.get('_route') == 'tournament_my_list' %}
                                          bg-white/20 text-white
                                      {% else %}
                                          text-white/90 hover:bg-white/10 hover:text-white
                                      {% endif %}">
                                {% if app.request.locale == 'fr' %}Mes Evenements{% else %}My Events{% endif %}
                            </a>
                            <a href="{{ path('tournament_create') }}"
                               class="bg-white px-4 py-2 rounded-xl font-semibold shadow-md hover:shadow-lg transition-all"
                               style="color: var(--color-primary-600);">
                                + {{ 'tournament.create.title'|trans }}
                            </a>
                            {% if is_granted('ROLE_ADMIN') %}
                                <a href="{{ path('admin_dashboard') }}"
                                   class="px-3 py-2 rounded-lg font-medium transition-all
                                          {% if app.request.attributes.get('_route') starts with 'admin_' %}
                                              bg-white/20 text-white
                                          {% else %}
                                              text-white/90 hover:bg-white/10 hover:text-white
                                          {% endif %}">
                                    {{ 'nav.admin'|trans }}
                                </a>
                            {% endif %}

                            {# Language Switcher #}
                            <div class="relative" data-controller="dropdown">
                                <button type="button"
                                        class="p-2 rounded-lg bg-white/10 hover:bg-white/20 transition-colors flex items-center space-x-1"
                                        data-action="click->dropdown#toggle"
                                        title="{{ 'nav.language'|trans }}">
                                    {{ ux_icon('lucide:globe', {class: 'w-5 h-5 text-white'}) }}
                                    <span class="text-white text-xs font-bold uppercase">{{ app.request.locale }}</span>
                                </button>
                                <div data-dropdown-target="menu"
                                     class="hidden absolute right-0 mt-2 w-32 rounded-xl shadow-xl border z-50"
                                     style="background-color: var(--card-bg); border-color: var(--border-default);">
                                    <a href="{{ path('app_locale_switch', {locale: 'fr'}) }}"
                                       class="flex items-center px-4 py-2 text-sm rounded-t-xl transition-colors {% if app.request.locale == 'fr' %}font-bold{% endif %}"
                                       style="color: var(--text-primary);"
                                       onmouseover="this.style.backgroundColor='var(--bg-muted)'"
                                       onmouseout="this.style.backgroundColor='transparent'">
                                        <span class="mr-2">🇫🇷</span> Francais
                                    </a>
                                    <a href="{{ path('app_locale_switch', {locale: 'en'}) }}"
                                       class="flex items-center px-4 py-2 text-sm rounded-b-xl transition-colors {% if app.request.locale == 'en' %}font-bold{% endif %}"
                                       style="color: var(--text-primary);"
                                       onmouseover="this.style.backgroundColor='var(--bg-muted)'"
                                       onmouseout="this.style.backgroundColor='transparent'">
                                        <span class="mr-2">🇬🇧</span> English
                                    </a>
                                </div>
                            </div>

                            {# Theme Selector #}
                            <div class="relative"
                                 data-controller="theme-selector"
                                 data-theme-selector-color-value="{{ app.user ? app.user.themeColor : 'orange' }}"
                                 data-theme-selector-mode-value="{{ app.user ? app.user.themeMode : 'light' }}"
                                 data-theme-selector-save-url-value="{{ app.user ? path('api_theme_save') : '' }}">
                                {# Toggle Button #}
                                <button type="button"
                                        class="p-2 rounded-lg bg-white/10 hover:bg-white/20 transition-colors"
                                        data-action="click->theme-selector#toggleMenu"
                                        title="{% if app.request.locale == 'fr' %}Changer le theme{% else %}Change theme{% endif %}">
                                    {{ ux_icon('lucide:palette', {class: 'w-5 h-5 text-white'}) }}
                                </button>

                                {# Dropdown Menu #}
                                <div data-theme-selector-target="menu"
                                     class="hidden absolute right-0 mt-2 w-64 rounded-xl shadow-xl border p-4 z-50"
                                     style="background-color: var(--card-bg); border-color: var(--border-default);">
                                    {# Title #}
                                    <div class="text-sm font-semibold mb-3" style="color: var(--text-primary);">Theme</div>

                                    {# Color Grid #}
                                    <div class="grid grid-cols-5 gap-2 mb-4">
                                        <button data-action="click->theme-selector#selectColor"
                                                data-color="orange"
                                                data-theme-selector-target="colorButton"
                                                class="w-10 h-10 rounded-lg bg-gradient-to-br from-orange-400 to-amber-500 hover:scale-110 transition-transform"
                                                title="Orange">
                                        </button>
                                        <button data-action="click->theme-selector#selectColor"
                                                data-color="blue"
                                                data-theme-selector-target="colorButton"
                                                class="w-10 h-10 rounded-lg bg-gradient-to-br from-blue-400 to-cyan-500 hover:scale-110 transition-transform"
                                                title="{% if app.request.locale == 'fr' %}Bleu{% else %}Blue{% endif %}">
                                        </button>
                                        <button data-action="click->theme-selector#selectColor"
                                                data-color="green"
                                                data-theme-selector-target="colorButton"
                                                class="w-10 h-10 rounded-lg bg-gradient-to-br from-green-400 to-teal-500 hover:scale-110 transition-transform"
                                                title="{% if app.request.locale == 'fr' %}Vert{% else %}Green{% endif %}">
                                        </button>
                                        <button data-action="click->theme-selector#selectColor"
                                                data-color="purple"
                                                data-theme-selector-target="colorButton"
                                                class="w-10 h-10 rounded-lg bg-gradient-to-br from-purple-400 to-pink-500 hover:scale-110 transition-transform"
                                                title="{% if app.request.locale == 'fr' %}Violet{% else %}Purple{% endif %}">
                                        </button>
                                        <button data-action="click->theme-selector#selectColor"
                                                data-color="rose"
                                                data-theme-selector-target="colorButton"
                                                class="w-10 h-10 rounded-lg bg-gradient-to-br from-rose-400 to-orange-500 hover:scale-110 transition-transform"
                                                title="Rose">
                                        </button>
                                    </div>

                                    {# Separator #}
                                    <hr class="mb-3" style="border-color: var(--border-default);">

                                    {# Dark Mode Toggle #}
                                    <button data-action="click->theme-selector#toggleMode"
                                            data-theme-selector-target="modeToggle"
                                            class="w-full flex items-center justify-between px-3 py-2 rounded-lg transition-colors"
                                            style="color: var(--text-primary);"
                                            onmouseover="this.style.backgroundColor='var(--bg-muted)'"
                                            onmouseout="this.style.backgroundColor='transparent'">
                                        <span class="flex items-center text-sm">
                                            {{ ux_icon('lucide:moon', {class: 'w-4 h-4 mr-2', 'data-theme-selector-target': 'modeIcon', 'data-mode-icon': 'moon'}) }}
                                            {{ ux_icon('lucide:sun', {class: 'w-4 h-4 mr-2 hidden', 'data-theme-selector-target': 'modeIcon', 'data-mode-icon': 'sun'}) }}
                                            {% if app.request.locale == 'fr' %}Mode sombre{% else %}Dark mode{% endif %}
                                        </span>
                                        <div class="w-10 h-6 rounded-full relative" style="background-color: var(--bg-muted);">
                                            <div data-toggle-knob
                                                 class="absolute top-1 left-1 w-4 h-4 bg-white rounded-full shadow transition-transform">
                                            </div>
                                        </div>
                                    </button>
                                </div>
                            </div>

                            <div class="flex items-center space-x-3 ml-2 pl-4 border-l border-white/30">
                                <a href="{{ path('app_profile') }}" class="flex items-center space-x-2 hover:opacity-90 transition-opacity">
                                    {% if app.user.avatar %}
                                        <img src="/uploads/avatars/{{ app.user.avatar }}" alt="Avatar"
                                             class="w-8 h-8 rounded-full object-cover border-2 border-white/30">
                                    {% else %}
                                        <div class="w-8 h-8 bg-white/20 rounded-full flex items-center justify-center">
                                            <span class="text-white font-semibold text-sm">{{ app.user.pseudo|slice(0,1)|upper }}</span>
                                        </div>
                                    {% endif %}
                                    <span class="text-white font-medium">{{ app.user.displayName }}</span>
                                </a>
                                <a href="{{ path('app_logout') }}" class="text-white/80 hover:text-white text-sm transition-colors">
                                    {{ 'nav.logout'|trans }}
                                </a>
                            </div>
                        {% else %}
                            {# Language Switcher for anonymous users #}
                            <div class="relative" data-controller="dropdown">
                                <button type="button"
                                        class="p-2 rounded-lg bg-white/10 hover:bg-white/20 transition-colors flex items-center space-x-1"
                                        data-action="click->dropdown#toggle"
                                        title="{{ 'nav.language'|trans }}">
                                    {{ ux_icon('lucide:globe', {class: 'w-5 h-5 text-white'}) }}
                                    <span class="text-white text-xs font-bold uppercase">{{ app.request.locale }}</span>
                                </button>
                                <div data-dropdown-target="menu"
                                     class="hidden absolute right-0 mt-2 w-32 rounded-xl shadow-xl border z-50"
                                     style="background-color: var(--card-bg); border-color: var(--border-default);">
                                    <a href="{{ path('app_locale_switch', {locale: 'fr'}) }}"
                                       class="flex items-center px-4 py-2 text-sm rounded-t-xl transition-colors {% if app.request.locale == 'fr' %}font-bold{% endif %}"
                                       style="color: var(--text-primary);"
                                       onmouseover="this.style.backgroundColor='var(--bg-muted)'"
                                       onmouseout="this.style.backgroundColor='transparent'">
                                        <span class="mr-2">🇫🇷</span> Francais
                                    </a>
                                    <a href="{{ path('app_locale_switch', {locale: 'en'}) }}"
                                       class="flex items-center px-4 py-2 text-sm rounded-b-xl transition-colors {% if app.request.locale == 'en' %}font-bold{% endif %}"
                                       style="color: var(--text-primary);"
                                       onmouseover="this.style.backgroundColor='var(--bg-muted)'"
                                       onmouseout="this.style.backgroundColor='transparent'">
                                        <span class="mr-2">🇬🇧</span> English
                                    </a>
                                </div>
                            </div>

                            {# Theme Selector for anonymous users #}
                            <div class="relative"
                                 data-controller="theme-selector"
                                 data-theme-selector-color-value="orange"
                                 data-theme-selector-mode-value="light"
                                 data-theme-selector-save-url-value="">
                                <button type="button"
                                        class="p-2 rounded-lg bg-white/10 hover:bg-white/20 transition-colors"
                                        data-action="click->theme-selector#toggleMenu"
                                        title="{% if app.request.locale == 'fr' %}Changer le theme{% else %}Change theme{% endif %}">
                                    {{ ux_icon('lucide:palette', {class: 'w-5 h-5 text-white'}) }}
                                </button>

                                <div data-theme-selector-target="menu"
                                     class="hidden absolute right-0 mt-2 w-64 rounded-xl shadow-xl border p-4 z-50"
                                     style="background-color: var(--card-bg); border-color: var(--border-default);">
                                    <div class="text-sm font-semibold mb-3" style="color: var(--text-primary);">Theme</div>

                                    <div class="grid grid-cols-5 gap-2 mb-4">
                                        <button data-action="click->theme-selector#selectColor"
                                                data-color="orange"
                                                data-theme-selector-target="colorButton"
                                                class="w-10 h-10 rounded-lg bg-gradient-to-br from-orange-400 to-amber-500 hover:scale-110 transition-transform"
                                                title="Orange">
                                        </button>
                                        <button data-action="click->theme-selector#selectColor"
                                                data-color="blue"
                                                data-theme-selector-target="colorButton"
                                                class="w-10 h-10 rounded-lg bg-gradient-to-br from-blue-400 to-cyan-500 hover:scale-110 transition-transform"
                                                title="{% if app.request.locale == 'fr' %}Bleu{% else %}Blue{% endif %}">
                                        </button>
                                        <button data-action="click->theme-selector#selectColor"
                                                data-color="green"
                                                data-theme-selector-target="colorButton"
                                                class="w-10 h-10 rounded-lg bg-gradient-to-br from-green-400 to-teal-500 hover:scale-110 transition-transform"
                                                title="{% if app.request.locale == 'fr' %}Vert{% else %}Green{% endif %}">
                                        </button>
                                        <button data-action="click->theme-selector#selectColor"
                                                data-color="purple"
                                                data-theme-selector-target="colorButton"
                                                class="w-10 h-10 rounded-lg bg-gradient-to-br from-purple-400 to-pink-500 hover:scale-110 transition-transform"
                                                title="{% if app.request.locale == 'fr' %}Violet{% else %}Purple{% endif %}">
                                        </button>
                                        <button data-action="click->theme-selector#selectColor"
                                                data-color="rose"
                                                data-theme-selector-target="colorButton"
                                                class="w-10 h-10 rounded-lg bg-gradient-to-br from-rose-400 to-orange-500 hover:scale-110 transition-transform"
                                                title="Rose">
                                        </button>
                                    </div>

                                    <hr class="mb-3" style="border-color: var(--border-default);">

                                    <button data-action="click->theme-selector#toggleMode"
                                            data-theme-selector-target="modeToggle"
                                            class="w-full flex items-center justify-between px-3 py-2 rounded-lg transition-colors"
                                            style="color: var(--text-primary);"
                                            onmouseover="this.style.backgroundColor='var(--bg-muted)'"
                                            onmouseout="this.style.backgroundColor='transparent'">
                                        <span class="flex items-center text-sm">
                                            {{ ux_icon('lucide:moon', {class: 'w-4 h-4 mr-2', 'data-theme-selector-target': 'modeIcon', 'data-mode-icon': 'moon'}) }}
                                            {{ ux_icon('lucide:sun', {class: 'w-4 h-4 mr-2 hidden', 'data-theme-selector-target': 'modeIcon', 'data-mode-icon': 'sun'}) }}
                                            {% if app.request.locale == 'fr' %}Mode sombre{% else %}Dark mode{% endif %}
                                        </span>
                                        <div class="w-10 h-6 rounded-full relative" style="background-color: var(--bg-muted);">
                                            <div data-toggle-knob
                                                 class="absolute top-1 left-1 w-4 h-4 bg-white rounded-full shadow transition-transform">
                                            </div>
                                        </div>
                                    </button>
                                </div>
                            </div>

                            <a href="{{ path('app_login') }}"
                               class="text-white/90 hover:text-white px-3 py-2 transition-colors">
                                {{ 'nav.login'|trans }}
                            </a>
                            <a href="{{ path('app_register') }}"
                               class="bg-white px-4 py-2 rounded-xl font-semibold shadow-md hover:shadow-lg transition-all"
                               style="color: var(--color-primary-600);">
                                {{ 'nav.register'|trans }}
                            </a>
                        {% endif %}
                        {% block navigation %}{% endblock %}
                    </div>
                </div>

                {# Mobile menu panel #}
                <div data-mobile-menu-target="panel"
                     class="hidden md:hidden fixed inset-0 top-[72px] z-50 mobile-menu-panel"
                     style="background-color: var(--card-bg);">
                    <div class="flex flex-col h-full overflow-y-auto">
                        <div class="flex flex-col p-4 space-y-2">
                            <a href="{{ path('tournament_list') }}"
                               class="flex items-center px-4 py-3 rounded-xl font-medium transition-all"
                               style="color: var(--text-primary);"
                               data-action="click->mobile-menu#close">
                                {{ ux_icon('lucide:trophy', {class: 'w-5 h-5 mr-3', style: 'color: var(--color-primary-500);'}) }}
                                {{ 'nav.tournaments'|trans }}
                            </a>

                            {% if app.user %}
                                <a href="{{ path('my_tournaments') }}"
                                   class="flex items-center px-4 py-3 rounded-xl font-medium transition-all"
                                   style="color: var(--text-primary);"
                                   data-action="click->mobile-menu#close">
                                    {{ ux_icon('lucide:calendar', {class: 'w-5 h-5 mr-3', style: 'color: var(--color-primary-500);'}) }}
                                    {{ 'nav.my_tournaments'|trans }}
                                </a>

                                <a href="{{ path('tournament_my_list') }}"
                                   class="flex items-center px-4 py-3 rounded-xl font-medium transition-all"
                                   style="color: var(--text-primary);"
                                   data-action="click->mobile-menu#close">
                                    {{ ux_icon('lucide:folder', {class: 'w-5 h-5 mr-3', style: 'color: var(--color-primary-500);'}) }}
                                    {% if app.request.locale == 'fr' %}Mes Evenements{% else %}My Events{% endif %}
                                </a>

                                <a href="{{ path('tournament_create') }}"
                                   class="flex items-center justify-center px-4 py-3 rounded-xl font-semibold text-white shadow-md transition-all mt-2"
                                   style="background: linear-gradient(135deg, var(--color-primary-500), var(--color-accent-500));"
                                   data-action="click->mobile-menu#close">
                                    {{ ux_icon('lucide:plus', {class: 'w-5 h-5 mr-2'}) }}
                                    {{ 'tournament.create.title'|trans }}
                                </a>

                                {% if is_granted('ROLE_ADMIN') %}
                                    <a href="{{ path('admin_dashboard') }}"
                                       class="flex items-center px-4 py-3 rounded-xl font-medium transition-all"
                                       style="color: var(--text-primary);"
                                       data-action="click->mobile-menu#close">
                                        {{ ux_icon('lucide:shield', {class: 'w-5 h-5 mr-3', style: 'color: var(--color-primary-500);'}) }}
                                        {{ 'nav.admin'|trans }}
                                    </a>
                                {% endif %}

                                <hr class="my-2" style="border-color: var(--border-default);">

                                {# User section #}
                                <a href="{{ path('app_profile') }}"
                                   class="flex items-center px-4 py-3 rounded-xl font-medium transition-all"
                                   style="color: var(--text-primary);"
                                   data-action="click->mobile-menu#close">
                                    {% if app.user.avatar %}
                                        <img src="/uploads/avatars/{{ app.user.avatar }}" alt="Avatar"
                                             class="w-8 h-8 rounded-full object-cover mr-3">
                                    {% else %}
                                        <div class="w-8 h-8 rounded-full flex items-center justify-center mr-3" style="background-color: var(--color-primary-100);">
                                            <span class="font-semibold text-sm" style="color: var(--color-primary-600);">{{ app.user.pseudo|slice(0,1)|upper }}</span>
                                        </div>
                                    {% endif %}
                                    {{ app.user.displayName }}
                                </a>

                                <a href="{{ path('app_logout') }}"
                                   class="flex items-center px-4 py-3 rounded-xl font-medium transition-all"
                                   style="color: var(--text-secondary);">
                                    {{ ux_icon('lucide:log-out', {class: 'w-5 h-5 mr-3'}) }}
                                    {{ 'nav.logout'|trans }}
                                </a>
                            {% else %}
                                <hr class="my-2" style="border-color: var(--border-default);">

                                <a href="{{ path('app_login') }}"
                                   class="flex items-center px-4 py-3 rounded-xl font-medium transition-all"
                                   style="color: var(--text-primary);"
                                   data-action="click->mobile-menu#close">
                                    {{ ux_icon('lucide:log-in', {class: 'w-5 h-5 mr-3', style: 'color: var(--color-primary-500);'}) }}
                                    {{ 'nav.login'|trans }}
                                </a>

                                <a href="{{ path('app_register') }}"
                                   class="flex items-center justify-center px-4 py-3 rounded-xl font-semibold text-white shadow-md transition-all"
                                   style="background: linear-gradient(135deg, var(--color-primary-500), var(--color-accent-500));"
                                   data-action="click->mobile-menu#close">
                                    {{ ux_icon('lucide:user-plus', {class: 'w-5 h-5 mr-2'}) }}
                                    {{ 'nav.register'|trans }}
                                </a>
                            {% endif %}

                            <hr class="my-2" style="border-color: var(--border-default);">

                            {# Language row #}
                            <div class="flex items-center justify-between px-4 py-2">
                                <span class="text-sm font-medium" style="color: var(--text-secondary);">
                                    {% if app.request.locale == 'fr' %}Langue{% else %}Language{% endif %}
                                </span>
                                <div class="flex space-x-2">
                                    <a href="{{ path('app_locale_switch', {locale: 'fr'}) }}"
                                       class="px-3 py-1.5 rounded-lg text-sm font-medium transition-all {% if app.request.locale == 'fr' %}text-white{% endif %}"
                                       style="{% if app.request.locale == 'fr' %}background: var(--color-primary-500);{% else %}color: var(--text-secondary); background: var(--bg-muted);{% endif %}">
                                        FR
                                    </a>
                                    <a href="{{ path('app_locale_switch', {locale: 'en'}) }}"
                                       class="px-3 py-1.5 rounded-lg text-sm font-medium transition-all {% if app.request.locale == 'en' %}text-white{% endif %}"
                                       style="{% if app.request.locale == 'en' %}background: var(--color-primary-500);{% else %}color: var(--text-secondary); background: var(--bg-muted);{% endif %}">
                                        EN
                                    </a>
                                </div>
                            </div>

                            {# Theme selector - mobile version #}
                            <div class="px-4 py-2"
                                 data-controller="theme-selector"
                                 data-theme-selector-color-value="{{ app.user ? app.user.themeColor : 'orange' }}"
                                 data-theme-selector-mode-value="{{ app.user ? app.user.themeMode : 'light' }}"
                                 data-theme-selector-save-url-value="{{ app.user ? path('api_theme_save') : '' }}">

                                {# Theme colors #}
                                <div class="flex items-center justify-between mb-3">
                                    <span class="text-sm font-medium" style="color: var(--text-secondary);">
                                        {% if app.request.locale == 'fr' %}Couleur{% else %}Color{% endif %}
                                    </span>
                                    <div class="flex space-x-2">
                                        <button data-action="click->theme-selector#selectColor"
                                                data-color="orange"
                                                data-theme-selector-target="colorButton"
                                                class="w-8 h-8 rounded-lg bg-gradient-to-br from-orange-400 to-amber-500 hover:scale-110 transition-transform"
                                                title="Orange">
                                        </button>
                                        <button data-action="click->theme-selector#selectColor"
                                                data-color="blue"
                                                data-theme-selector-target="colorButton"
                                                class="w-8 h-8 rounded-lg bg-gradient-to-br from-blue-400 to-cyan-500 hover:scale-110 transition-transform"
                                                title="{% if app.request.locale == 'fr' %}Bleu{% else %}Blue{% endif %}">
                                        </button>
                                        <button data-action="click->theme-selector#selectColor"
                                                data-color="green"
                                                data-theme-selector-target="colorButton"
                                                class="w-8 h-8 rounded-lg bg-gradient-to-br from-green-400 to-teal-500 hover:scale-110 transition-transform"
                                                title="{% if app.request.locale == 'fr' %}Vert{% else %}Green{% endif %}">
                                        </button>
                                        <button data-action="click->theme-selector#selectColor"
                                                data-color="purple"
                                                data-theme-selector-target="colorButton"
                                                class="w-8 h-8 rounded-lg bg-gradient-to-br from-purple-400 to-pink-500 hover:scale-110 transition-transform"
                                                title="{% if app.request.locale == 'fr' %}Violet{% else %}Purple{% endif %}">
                                        </button>
                                        <button data-action="click->theme-selector#selectColor"
                                                data-color="rose"
                                                data-theme-selector-target="colorButton"
                                                class="w-8 h-8 rounded-lg bg-gradient-to-br from-rose-400 to-orange-500 hover:scale-110 transition-transform"
                                                title="Rose">
                                        </button>
                                    </div>
                                </div>

                                {# Dark mode toggle #}
                                <div class="flex items-center justify-between">
                                    <span class="text-sm font-medium" style="color: var(--text-secondary);">
                                        {% if app.request.locale == 'fr' %}Mode sombre{% else %}Dark mode{% endif %}
                                    </span>
                                    <button data-action="click->theme-selector#toggleMode"
                                            data-theme-selector-target="modeToggle"
                                            class="flex items-center">
                                        <div class="w-12 h-7 rounded-full relative transition-colors" style="background-color: var(--bg-muted);">
                                            <div data-toggle-knob
                                                 class="absolute top-1 left-1 w-5 h-5 bg-white rounded-full shadow transition-transform flex items-center justify-center">
                                                {{ ux_icon('lucide:sun', {class: 'w-3 h-3', style: 'color: var(--color-primary-500);', 'data-theme-selector-target': 'modeIcon', 'data-mode-icon': 'sun'}) }}
                                                {{ ux_icon('lucide:moon', {class: 'w-3 h-3 hidden', style: 'color: var(--color-primary-500);', 'data-theme-selector-target': 'modeIcon', 'data-mode-icon': 'moon'}) }}
                                            </div>
                                        </div>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </nav>
        {% endblock %}
    </header>

    <main id="main-content" class="flex-1 container mx-auto px-4 py-8">
        {# Flash messages with theme-aware styling #}
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="mb-6 {% if label == 'success' %}alert-success{% elseif label == 'error' %}alert-danger{% elseif label == 'warning' %}alert-warning{% else %}alert-info{% endif %}" role="alert">
                    <div class="flex items-center">
                        {% if label == 'success' %}
                            {{ ux_icon('lucide:check-circle', {class: 'w-5 h-5 mr-3'}) }}
                        {% elseif label == 'error' %}
                            {{ ux_icon('lucide:x-circle', {class: 'w-5 h-5 mr-3'}) }}
                        {% elseif label == 'warning' %}
                            {{ ux_icon('lucide:alert-triangle', {class: 'w-5 h-5 mr-3'}) }}
                        {% else %}
                            {{ ux_icon('lucide:info', {class: 'w-5 h-5 mr-3'}) }}
                        {% endif %}
                        <span class="font-medium">{{ message|trans }}</span>
                    </div>
                </div>
            {% endfor %}
        {% endfor %}

        {% block body %}{% endblock %}
    </main>

    <footer class="theme-header-gradient">
        {% block footer %}
            <div class="container mx-auto px-4 py-8">
                <div class="flex flex-col md:flex-row items-center justify-between">
                    <div class="flex items-center space-x-2 mb-4 md:mb-0">
                        <img src="{{ asset('logo/alteredTT_logo.png') }}" alt="Altered Tournament Tools" class="w-8 h-8 rounded">
                        <span class="text-white font-semibold">Altered Tournament Tools</span>
                    </div>

                    {# Ko-fi support button #}
                    <a href="https://ko-fi.com/Benhol"
                       target="_blank"
                       rel="noopener noreferrer"
                       class="flex items-center space-x-2 px-5 py-2.5 rounded-xl bg-[#FF5E5B] hover:bg-[#ff4744] shadow-lg hover:shadow-xl hover:scale-105 transition-all mb-4 md:mb-0 group">
                        {{ ux_icon('lucide:heart', {class: 'w-5 h-5 text-white group-hover:animate-pulse'}) }}
                        <span class="text-white text-sm font-bold">
                            {% if app.request.locale == 'fr' %}Soutenir le projet{% else %}Support the project{% endif %}
                        </span>
                    </a>

                    <div class="text-white/70 text-sm">
                        &copy; {{ 'now'|date('Y') }} {% if app.request.locale == 'fr' %}Tous droits réservés{% else %}All rights reserved{% endif %}
                    </div>
                </div>
            </div>
        {% endblock %}
    </footer>
</body>
</html>
