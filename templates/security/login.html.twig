{% extends 'base.html.twig' %}

{% block title %}{{ 'auth.login.page_title'|trans }}{% endblock %}

{% block body %}
<div class="min-h-screen py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-md mx-auto">
        {# Header #}
        <div class="text-center mb-8">
            <div class="inline-flex items-center justify-center w-16 h-16 rounded-2xl shadow-lg mb-4 theme-primary-gradient">
                {{ ux_icon('lucide:log-in', {class: 'w-8 h-8 text-white'}) }}
            </div>
            <h1 class="text-3xl font-bold" style="color: var(--text-primary);">{{ 'auth.login.title'|trans }}</h1>
            <p class="mt-2" style="color: var(--text-secondary);">
                {{ 'auth.login.subtitle'|trans }}
            </p>
        </div>

        {# Login Card #}
        <div class="rounded-2xl shadow-xl overflow-hidden" style="background-color: var(--card-bg);">
            <div class="p-8">
                {# Error message #}
                {% if error %}
                    <div class="mb-6 alert-danger" role="alert">
                        <div class="flex items-center">
                            {{ ux_icon('lucide:alert-circle', {class: 'w-5 h-5 mr-3 flex-shrink-0'}) }}
                            <span class="text-sm">{{ error.messageKey|trans(error.messageData, 'security') }}</span>
                        </div>
                    </div>
                {% endif %}

                <form method="post" class="space-y-6" data-controller="button-loader">
                    {# CSRF Token #}
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                    {# Email field #}
                    <div>
                        <label for="email" class="form-label">
                            {{ 'auth.login.email_label'|trans }}
                        </label>
                        <div class="relative">
                            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                                {{ ux_icon('lucide:mail', {class: 'w-5 h-5', style: 'color: var(--text-muted);'}) }}
                            </div>
                            <input id="email"
                                   name="_username"
                                   type="email"
                                   autocomplete="email"
                                   required
                                   class="form-input w-full pl-10"
                                   placeholder="{{ 'auth.login.email_placeholder'|trans }}"
                                   value="{{ last_username }}">
                        </div>
                    </div>

                    {# Password field #}
                    <div>
                        <label for="password" class="form-label">
                            {{ 'auth.login.password_label'|trans }}
                        </label>
                        <div class="relative">
                            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                                {{ ux_icon('lucide:lock', {class: 'w-5 h-5', style: 'color: var(--text-muted);'}) }}
                            </div>
                            <input id="password"
                                   name="_password"
                                   type="password"
                                   autocomplete="current-password"
                                   required
                                   class="form-input w-full pl-10"
                                   placeholder="{{ 'auth.login.password_placeholder'|trans }}">
                        </div>
                    </div>

                    {# Remember me and forgot password #}
                    <div class="flex items-center justify-between">
                        <div class="flex items-center">
                            <input id="remember_me"
                                   name="_remember_me"
                                   type="checkbox"
                                   class="h-5 w-5 rounded"
                                   style="accent-color: var(--color-primary-600);">
                            <label for="remember_me" class="ml-3 block text-sm" style="color: var(--text-secondary);">
                                {{ 'auth.login.remember_me'|trans }}
                            </label>
                        </div>

                        <div>
                            <a href="{{ path('app_forgot_password_request') }}" class="text-sm font-medium" style="color: var(--color-primary-600);">
                                {{ 'auth.login.forgot_password'|trans }}
                            </a>
                        </div>
                    </div>

                    {# Submit button #}
                    <div class="pt-2">
                        <button type="submit"
                                class="w-full flex items-center justify-center px-6 py-3 text-white font-semibold rounded-xl shadow-md hover:shadow-lg transition-all"
                                style="background: linear-gradient(135deg, var(--color-primary-500), var(--color-accent-500));">
                            {{ ux_icon('lucide:log-in', {class: 'w-5 h-5 mr-2'}) }}
                            {{ 'auth.login.submit'|trans }}
                        </button>
                    </div>
                </form>

                {# OAuth Login - Altered Re:Union #}
                {% if oauth_altered_reunion_enabled is defined and oauth_altered_reunion_enabled %}
                <div class="mt-6">
                    <div class="relative">
                        <div class="absolute inset-0 flex items-center">
                            <div class="w-full border-t" style="border-color: var(--border-color);"></div>
                        </div>
                        <div class="relative flex justify-center text-sm">
                            <span class="px-2" style="background-color: var(--card-bg); color: var(--text-muted);">ou</span>
                        </div>
                    </div>

                    <div class="mt-6">
                        <a href="{{ path('oauth_altered_reunion_connect') }}"
                           data-turbo="false"
                           class="w-full flex items-center justify-center px-6 py-3 font-semibold rounded-xl border transition-all hover:shadow-md"
                           style="color: var(--text-primary); border-color: var(--border-color); background-color: var(--bg-secondary);">
                            {{ ux_icon('lucide:external-link', {class: 'w-5 h-5 mr-2'}) }}
                            Se connecter avec Altered Re:Union
                        </a>
                    </div>
                </div>
                {% endif %}
            </div>
        </div>

        {# Register link #}
        <div class="mt-6 text-center">
            <p style="color: var(--text-secondary);">
                {{ 'auth.login.no_account'|trans }}
                <a href="{{ path('app_register') }}" class="font-semibold" style="color: var(--color-primary-600);">
                    {{ 'auth.login.register_link'|trans }}
                </a>
            </p>
        </div>
    </div>
</div>
{% endblock %}
