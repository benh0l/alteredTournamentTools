{% extends 'base.html.twig' %}

{% block title %}{{ 'profile.change_password.page_title'|trans }}{% endblock %}

{% block body %}
<div class="min-h-screen py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-md mx-auto">
        {# Header #}
        <div class="text-center mb-8">
            <div class="inline-flex items-center justify-center w-16 h-16 rounded-2xl shadow-lg mb-4 theme-primary-gradient">
                {{ ux_icon('lucide:key-round', {class: 'w-8 h-8 text-white'}) }}
            </div>
            <h1 class="text-3xl font-bold" style="color: var(--text-primary);">{{ 'profile.change_password.title'|trans }}</h1>
            <p class="mt-2" style="color: var(--text-secondary);">{{ 'profile.change_password.subtitle'|trans }}</p>
        </div>

        {# Password Card #}
        <div class="rounded-2xl shadow-xl overflow-hidden" style="background-color: var(--card-bg);">
            <div class="p-8">
                {{ form_start(form, {'attr': {'class': 'space-y-6', 'novalidate': 'novalidate'}}) }}

                    {# Current password #}
                    <div>
                        {{ form_label(form.currentPassword, null, {
                            'label_attr': {'class': 'form-label'}
                        }) }}
                        <div class="relative">
                            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                                {{ ux_icon('lucide:lock', {class: 'w-5 h-5', style: 'color: var(--text-muted);'}) }}
                            </div>
                            {{ form_widget(form.currentPassword, {
                                'attr': {'class': 'form-input w-full pl-10'}
                            }) }}
                        </div>
                        {{ form_errors(form.currentPassword) }}
                    </div>

                    <hr style="border-color: var(--border-default);">

                    {# New password #}
                    <div>
                        {{ form_label(form.newPassword.first, null, {
                            'label_attr': {'class': 'form-label'}
                        }) }}
                        <div class="relative">
                            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                                {{ ux_icon('lucide:key', {class: 'w-5 h-5', style: 'color: var(--text-muted);'}) }}
                            </div>
                            {{ form_widget(form.newPassword.first, {
                                'attr': {'class': 'form-input w-full pl-10'}
                            }) }}
                        </div>
                        <p class="mt-2 text-xs" style="color: var(--text-muted);">{{ 'profile.change_password.password_hint'|trans }}</p>
                        {{ form_errors(form.newPassword.first) }}
                    </div>

                    {# Confirm password #}
                    <div>
                        {{ form_label(form.newPassword.second, null, {
                            'label_attr': {'class': 'form-label'}
                        }) }}
                        <div class="relative">
                            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                                {{ ux_icon('lucide:key', {class: 'w-5 h-5', style: 'color: var(--text-muted);'}) }}
                            </div>
                            {{ form_widget(form.newPassword.second, {
                                'attr': {'class': 'form-input w-full pl-10'}
                            }) }}
                        </div>
                        {{ form_errors(form.newPassword.second) }}
                    </div>

                    {# Global errors #}
                    {% if form.newPassword.vars.errors|length > 0 %}
                        <div class="alert-danger">
                            <div class="flex items-center">
                                {{ ux_icon('lucide:alert-circle', {class: 'w-5 h-5 mr-3 flex-shrink-0'}) }}
                                <span class="text-sm">{{ form_errors(form.newPassword) }}</span>
                            </div>
                        </div>
                    {% endif %}

                    <div class="pt-2">
                        <button type="submit"
                                class="w-full flex items-center justify-center px-6 py-3 text-white font-semibold rounded-xl shadow-md hover:shadow-lg transition-all"
                                style="background: linear-gradient(135deg, var(--color-primary-500), var(--color-accent-500));">
                            {{ ux_icon('lucide:check', {class: 'w-5 h-5 mr-2'}) }}
                            {{ 'profile.change_password.submit'|trans }}
                        </button>
                    </div>

                {{ form_end(form) }}
            </div>
        </div>

        {# Back link #}
        <div class="mt-6 text-center">
            <a href="{{ path('app_profile') }}" class="inline-flex items-center font-semibold" style="color: var(--color-primary-600);">
                {{ ux_icon('lucide:arrow-left', {class: 'w-4 h-4 mr-2'}) }}
                {{ 'profile.back_to_profile'|trans }}
            </a>
        </div>
    </div>
</div>
{% endblock %}
