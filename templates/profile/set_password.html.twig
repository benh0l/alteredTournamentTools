{% extends 'base.html.twig' %}

{% block title %}Definir un mot de passe{% endblock %}

{% block body %}
<div class="min-h-screen py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-md mx-auto">
        {# Header #}
        <div class="text-center mb-8">
            <div class="inline-flex items-center justify-center w-16 h-16 rounded-2xl shadow-lg mb-4 theme-primary-gradient">
                {{ ux_icon('lucide:key', {class: 'w-8 h-8 text-white'}) }}
            </div>
            <h1 class="text-3xl font-bold" style="color: var(--text-primary);">Definir un mot de passe</h1>
            <p class="mt-2" style="color: var(--text-secondary);">
                Definissez un mot de passe pour pouvoir vous connecter sans Altered Re:Union.
            </p>
        </div>

        {# Form Card #}
        <div class="rounded-2xl shadow-xl overflow-hidden" style="background-color: var(--card-bg);">
            <div class="p-8">
                <div class="alert-info mb-6">
                    <div class="flex">
                        {{ ux_icon('lucide:info', {class: 'w-5 h-5 mr-3 flex-shrink-0'}) }}
                        <p class="text-sm">
                            Votre compte a ete cree via Altered Re:Union. En definissant un mot de passe,
                            vous pourrez egalement vous connecter avec votre email et mot de passe.
                        </p>
                    </div>
                </div>

                {{ form_start(form, {'attr': {'class': 'space-y-6'}}) }}

                    {# New password field #}
                    <div>
                        {{ form_label(form.newPassword.first, null, {'label_attr': {'class': 'form-label'}}) }}
                        <div class="relative mt-1">
                            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                                {{ ux_icon('lucide:lock', {class: 'w-5 h-5', style: 'color: var(--text-muted);'}) }}
                            </div>
                            {{ form_widget(form.newPassword.first, {'attr': {'class': 'form-input w-full pl-10'}}) }}
                        </div>
                        {{ form_errors(form.newPassword.first) }}
                    </div>

                    {# Confirm password field #}
                    <div>
                        {{ form_label(form.newPassword.second, null, {'label_attr': {'class': 'form-label'}}) }}
                        <div class="relative mt-1">
                            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                                {{ ux_icon('lucide:lock', {class: 'w-5 h-5', style: 'color: var(--text-muted);'}) }}
                            </div>
                            {{ form_widget(form.newPassword.second, {'attr': {'class': 'form-input w-full pl-10'}}) }}
                        </div>
                        {{ form_errors(form.newPassword.second) }}
                    </div>

                    {# Submit button #}
                    <div class="pt-2">
                        {{ form_widget(form.submit, {'attr': {
                            'class': 'w-full flex items-center justify-center px-6 py-3 text-white font-semibold rounded-xl shadow-md hover:shadow-lg transition-all',
                            'style': 'background: linear-gradient(135deg, var(--color-primary-500), var(--color-accent-500));'
                        }}) }}
                    </div>

                {{ form_end(form) }}
            </div>
        </div>

        {# Back link #}
        <div class="mt-6 text-center">
            <a href="{{ path('app_profile') }}" class="font-semibold" style="color: var(--text-secondary);">
                {{ ux_icon('lucide:arrow-left', {class: 'w-4 h-4 inline mr-1'}) }}
                Retourner au profil
            </a>
        </div>
    </div>
</div>
{% endblock %}
