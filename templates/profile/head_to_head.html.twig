{% extends 'base.html.twig' %}

{% block title %}{{ 'profile.head_to_head.title'|trans({'%opponent%': opponent.displayName}) }}{% endblock %}

{% block body %}
<div class="min-h-screen py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-4xl mx-auto">
        {# Header #}
        <div class="flex items-center justify-between mb-8">
            <div class="flex items-center gap-4">
                <a href="{{ path('app_profile_match_history') }}" class="p-2 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors" style="color: var(--text-muted);">
                    {{ ux_icon('lucide:arrow-left', {class: 'w-5 h-5'}) }}
                </a>
                <div>
                    <h1 class="text-2xl font-bold" style="color: var(--text-primary);">{{ 'profile.head_to_head.page_title'|trans }}</h1>
                    <p class="text-sm" style="color: var(--text-muted);">{{ 'profile.head_to_head.subtitle'|trans }}</p>
                </div>
            </div>
        </div>

        {# Head-to-Head Card #}
        <div class="rounded-2xl shadow-lg overflow-hidden mb-8" style="background-color: var(--card-bg);">
            <div class="p-6 md:p-8">
                {# Players vs Display #}
                <div class="flex items-center justify-center gap-4 md:gap-8 mb-8">
                    {# Current User #}
                    <div class="text-center">
                        {% if user.avatar %}
                            <img src="/uploads/avatars/{{ user.avatar }}" alt="{{ user.displayName }}"
                                 class="w-20 h-20 md:w-24 md:h-24 rounded-full object-cover border-4 border-green-500 mx-auto mb-2">
                        {% else %}
                            <div class="w-20 h-20 md:w-24 md:h-24 rounded-full flex items-center justify-center text-2xl font-bold border-4 border-green-500 mx-auto mb-2" style="background-color: var(--bg-subtle); color: var(--color-primary-500);">
                                {{ user.pseudo|first|upper }}
                            </div>
                        {% endif %}
                        <p class="font-semibold text-sm md:text-base" style="color: var(--text-primary);">{{ user.displayName }}</p>
                        <p class="text-xs" style="color: var(--text-muted);">{{ 'profile.head_to_head.you'|trans }}</p>
                    </div>

                    {# VS #}
                    <div class="flex flex-col items-center">
                        <div class="text-3xl md:text-4xl font-bold" style="color: var(--text-muted);">VS</div>
                    </div>

                    {# Opponent #}
                    <div class="text-center">
                        {% if opponent.avatar %}
                            <img src="/uploads/avatars/{{ opponent.avatar }}" alt="{{ opponent.displayName }}"
                                 class="w-20 h-20 md:w-24 md:h-24 rounded-full object-cover border-4 border-red-500 mx-auto mb-2">
                        {% else %}
                            <div class="w-20 h-20 md:w-24 md:h-24 rounded-full flex items-center justify-center text-2xl font-bold border-4 border-red-500 mx-auto mb-2" style="background-color: var(--bg-subtle); color: var(--color-primary-500);">
                                {{ opponent.pseudo|first|upper }}
                            </div>
                        {% endif %}
                        <p class="font-semibold text-sm md:text-base" style="color: var(--text-primary);">{{ opponent.displayName }}</p>
                    </div>
                </div>

                {# Score Summary #}
                <div class="flex items-center justify-center gap-8 md:gap-16 mb-6">
                    <div class="text-center">
                        <p class="text-4xl md:text-5xl font-bold text-green-600">{{ stats.wins }}</p>
                        <p class="text-sm" style="color: var(--text-muted);">{{ 'profile.head_to_head.wins'|trans }}</p>
                    </div>

                    <div class="text-center">
                        <p class="text-4xl md:text-5xl font-bold" style="color: var(--text-muted);">{{ stats.draws }}</p>
                        <p class="text-sm" style="color: var(--text-muted);">{{ 'profile.head_to_head.draws'|trans }}</p>
                    </div>

                    <div class="text-center">
                        <p class="text-4xl md:text-5xl font-bold text-red-600">{{ stats.losses }}</p>
                        <p class="text-sm" style="color: var(--text-muted);">{{ 'profile.head_to_head.losses'|trans }}</p>
                    </div>
                </div>

                {# Winrate bar #}
                {% if stats.totalMatches > 0 %}
                <div class="max-w-md mx-auto">
                    <div class="flex justify-between text-sm mb-1">
                        <span class="font-medium text-green-600">{{ stats.winrate }}%</span>
                        <span style="color: var(--text-muted);">{{ stats.totalMatches }} {{ 'profile.head_to_head.matches_total'|trans }}</span>
                        <span class="font-medium text-red-600">{{ 100 - stats.winrate }}%</span>
                    </div>
                    <div class="h-3 rounded-full overflow-hidden flex" style="background-color: var(--bg-muted);">
                        {% if stats.wins > 0 %}
                            <div class="h-full bg-green-500" style="width: {{ (stats.wins / stats.totalMatches) * 100 }}%;"></div>
                        {% endif %}
                        {% if stats.draws > 0 %}
                            <div class="h-full bg-gray-400" style="width: {{ (stats.draws / stats.totalMatches) * 100 }}%;"></div>
                        {% endif %}
                        {% if stats.losses > 0 %}
                            <div class="h-full bg-red-500" style="width: {{ (stats.losses / stats.totalMatches) * 100 }}%;"></div>
                        {% endif %}
                    </div>
                </div>
                {% endif %}
            </div>
        </div>

        {# Match History #}
        <div class="rounded-xl shadow-sm overflow-hidden" style="background-color: var(--card-bg);">
            <div class="px-5 py-4 border-b" style="border-color: var(--border-default);">
                <h2 class="font-semibold flex items-center gap-2" style="color: var(--text-primary);">
                    {{ ux_icon('lucide:history', {class: 'w-5 h-5', style: 'color: var(--text-muted);'}) }}
                    {{ 'profile.head_to_head.match_history'|trans }}
                </h2>
            </div>

            {% if stats.matches is empty %}
                <div class="px-5 py-12 text-center" style="color: var(--text-muted);">
                    {{ ux_icon('lucide:inbox', {class: 'w-12 h-12 mx-auto mb-3 opacity-50'}) }}
                    <p>{{ 'profile.head_to_head.no_matches'|trans }}</p>
                </div>
            {% else %}
                <div class="divide-y" style="border-color: var(--border-default);">
                    {% for matchData in stats.matches %}
                        <div class="px-5 py-4 flex items-center justify-between hover:bg-gray-50 dark:hover:bg-gray-800/50 transition-colors">
                            <div class="flex items-center gap-3">
                                {# User hero portrait #}
                                <div class="flex-shrink-0">
                                    <div class="w-10 h-10 rounded-full overflow-hidden border-2"
                                         style="border-color: {{ matchData.factionColor ?? 'var(--border-default)' }};">
                                        {% if matchData.heroImage %}
                                            <img src="{{ matchData.heroImage }}" alt="{{ matchData.heroLabel }}" class="w-full h-full object-cover">
                                        {% else %}
                                            <div class="w-full h-full flex items-center justify-center" style="background-color: var(--bg-subtle);">
                                                <span style="color: var(--text-muted);">?</span>
                                            </div>
                                        {% endif %}
                                    </div>
                                </div>

                                {# VS #}
                                <div class="flex-shrink-0 text-xs font-bold" style="color: var(--text-muted);">vs</div>

                                {# Opponent hero portrait #}
                                <div class="flex-shrink-0">
                                    <div class="w-10 h-10 rounded-full overflow-hidden border-2"
                                         style="border-color: {{ matchData.opponentFactionColor ?? 'var(--border-default)' }};">
                                        {% if matchData.opponentHeroImage %}
                                            <img src="{{ matchData.opponentHeroImage }}" alt="{{ matchData.opponentHeroLabel }}" class="w-full h-full object-cover">
                                        {% else %}
                                            <div class="w-full h-full flex items-center justify-center" style="background-color: var(--bg-subtle);">
                                                <span style="color: var(--text-muted);">?</span>
                                            </div>
                                        {% endif %}
                                    </div>
                                </div>

                                {# Match info #}
                                <div class="min-w-0">
                                    <p class="font-medium truncate" style="color: var(--text-primary);">
                                        <a href="{{ path('tournament_show', {id: matchData.tournamentId}) }}" class="hover:underline">{{ matchData.tournament }}</a>
                                    </p>
                                    <p class="text-sm" style="color: var(--text-muted);">
                                        {{ 'profile.head_to_head.round'|trans({'%n%': matchData.roundNumber}) }}
                                    </p>
                                </div>
                            </div>

                            <div class="flex items-center gap-3 flex-shrink-0">
                                {# Result badge #}
                                <div class="w-8 h-8 rounded-full flex items-center justify-center text-sm font-bold text-white
                                    {% if matchData.won %}bg-green-500{% else %}bg-red-500{% endif %}">
                                    {% if matchData.won %}W{% else %}L{% endif %}
                                </div>

                                <div class="text-right">
                                    <p class="font-mono font-semibold" style="color: var(--text-primary);">{{ matchData.score }}</p>
                                    <p class="text-xs" style="color: var(--text-muted);">
                                        {% if matchData.date %}
                                            {{ matchData.date|date('d/m/Y') }}
                                        {% endif %}
                                    </p>
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}
