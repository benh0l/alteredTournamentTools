{% set tournament = registration.tournament %}

<div class="rounded-lg shadow-md overflow-hidden hover:shadow-lg transition-shadow duration-200" style="background-color: var(--card-bg);">
    <div class="border-l-4 border-{{ status_color }}-500 p-4">
        <div class="flex justify-between items-start">
            <div class="flex-1">
                <h3 class="font-semibold text-lg" style="color: var(--text-primary);">
                    {{ tournament.name }}
                </h3>
                <p class="text-sm mt-1" style="color: var(--text-muted);">
                    <span class="inline-flex items-center">
                        {{ ux_icon('lucide:calendar', {class: 'w-4 h-4 mr-1'}) }}
                        {{ tournament.date|date('d/m/Y') }}{% if tournament.time %} a {{ tournament.time|date('H:i') }}{% endif %}
                    </span>
                </p>
                {% if tournament.location %}
                <p class="text-sm mt-1" style="color: var(--text-muted);">
                    <span class="inline-flex items-center">
                        {{ ux_icon('lucide:map-pin', {class: 'w-4 h-4 mr-1'}) }}
                        {{ tournament.location }}
                    </span>
                </p>
                {% endif %}
            </div>
            <div class="flex flex-wrap gap-1 ml-2">
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-500/20 text-green-800 dark:text-green-300">
                    {{ 'tournament.list.players_badge'|trans({'%count%': tournament.expectedPlayers}) }}
                </span>
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-{{ status_color }}-100 text-{{ status_color }}-800">
                    {{ tournament.format.label|trans }}
                </span>
            </div>
        </div>

        <div class="mt-4 pt-4 border-t flex justify-between items-center" style="border-color: var(--border-muted);">
            <div class="flex items-center space-x-4">
                <a href="{{ path('tournament_show', {'id': tournament.id}) }}"
                   class="text-sm font-medium" style="color: var(--color-primary-600);">
                    Voir details
                </a>
                {% if show_unregister %}
                <a href="{{ path('tournament_registration_edit', {'id': tournament.id}) }}"
                   class="inline-flex items-center text-sm font-medium" style="color: var(--text-secondary);">
                    {{ ux_icon('lucide:edit', {class: 'w-4 h-4 mr-1'}) }}
                    Modifier
                </a>
                {% endif %}
            </div>

            {% if show_unregister %}
            <form action="{{ path('my_tournaments_unregister', {'id': tournament.id}) }}"
                  method="POST"
                  class="inline"
                  onsubmit="return confirm('Etes-vous sur de vouloir vous desinscrire ?');">
                <input type="hidden" name="_token" value="{{ csrf_token('unregister' ~ tournament.id) }}">
                <button type="submit"
                        class="text-red-600 hover:text-red-800 text-sm font-medium">
                    Se desinscrire
                </button>
            </form>
            {% endif %}
        </div>
    </div>
</div>
