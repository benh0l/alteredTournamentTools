{% extends 'base.html.twig' %}

{% block title %}{{ 'api.request_page_title'|trans }}{% endblock %}

{% block body %}
<div class="min-h-screen py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-2xl mx-auto">
        {# Header #}
        <div class="text-center mb-8">
            <div class="inline-flex items-center justify-center w-16 h-16 rounded-2xl shadow-lg mb-4 theme-primary-gradient">
                {{ ux_icon('lucide:key-round', {class: 'w-8 h-8 text-white'}) }}
            </div>
            <h1 class="text-3xl font-bold" style="color: var(--text-primary);">{{ 'api.request_title'|trans }}</h1>
            <p class="mt-2" style="color: var(--text-secondary);">{{ 'api.request_subtitle'|trans }}</p>
        </div>

        {# Info Box #}
        <div class="mb-8 p-4 rounded-xl bg-blue-50 dark:bg-blue-900/20 border border-blue-200 dark:border-blue-800">
            <div class="flex">
                <div class="flex-shrink-0">
                    {{ ux_icon('lucide:info', {class: 'w-5 h-5 text-blue-500'}) }}
                </div>
                <div class="ml-3">
                    <h3 class="text-sm font-medium text-blue-800 dark:text-blue-200">{{ 'api.info_title'|trans }}</h3>
                    <div class="mt-2 text-sm text-blue-700 dark:text-blue-300">
                        <ul class="list-disc list-inside space-y-1">
                            <li>{{ 'api.info_item_1'|trans }}</li>
                            <li>{{ 'api.info_item_2'|trans }}</li>
                            <li>{{ 'api.info_item_3'|trans }}</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>

        {# Form Card #}
        <div class="rounded-2xl shadow-xl overflow-hidden" style="background-color: var(--card-bg);">
            <div class="theme-header-gradient px-6 py-4">
                <h2 class="text-xl font-bold text-white flex items-center">
                    {{ ux_icon('lucide:file-text', {class: 'w-6 h-6 mr-2'}) }}
                    {{ 'api.request_form_title'|trans }}
                </h2>
            </div>
            <div class="p-6">
                {{ form_start(form, {attr: {class: 'space-y-6'}}) }}
                    {# Project Name #}
                    <div>
                        {{ form_label(form.projectName, null, {label_attr: {class: 'block text-sm font-medium mb-2', style: 'color: var(--text-primary);'}}) }}
                        {{ form_widget(form.projectName, {attr: {class: 'w-full px-4 py-3 rounded-xl border transition-colors focus:ring-2 focus:ring-offset-2', style: 'background-color: var(--input-bg); border-color: var(--border-muted); color: var(--text-primary);'}}) }}
                        {{ form_errors(form.projectName) }}
                        <p class="mt-1 text-sm" style="color: var(--text-muted);">{{ 'api.form.project_name_help'|trans }}</p>
                    </div>

                    {# Intended Use #}
                    <div>
                        {{ form_label(form.intendedUse, null, {label_attr: {class: 'block text-sm font-medium mb-2', style: 'color: var(--text-primary);'}}) }}
                        {{ form_widget(form.intendedUse, {attr: {class: 'w-full px-4 py-3 rounded-xl border transition-colors focus:ring-2 focus:ring-offset-2', style: 'background-color: var(--input-bg); border-color: var(--border-muted); color: var(--text-primary);'}}) }}
                        {{ form_errors(form.intendedUse) }}
                        <p class="mt-1 text-sm" style="color: var(--text-muted);">{{ 'api.form.intended_use_help'|trans }}</p>
                    </div>

                    {# Website URL (optional) #}
                    <div>
                        {{ form_label(form.websiteUrl, null, {label_attr: {class: 'block text-sm font-medium mb-2', style: 'color: var(--text-primary);'}}) }}
                        {{ form_widget(form.websiteUrl, {attr: {class: 'w-full px-4 py-3 rounded-xl border transition-colors focus:ring-2 focus:ring-offset-2', style: 'background-color: var(--input-bg); border-color: var(--border-muted); color: var(--text-primary);'}}) }}
                        {{ form_errors(form.websiteUrl) }}
                        <p class="mt-1 text-sm" style="color: var(--text-muted);">{{ 'api.form.website_url_help'|trans }}</p>
                    </div>

                    {# Discord Username (optional) #}
                    <div>
                        {{ form_label(form.discordUsername, null, {label_attr: {class: 'block text-sm font-medium mb-2', style: 'color: var(--text-primary);'}}) }}
                        {{ form_widget(form.discordUsername, {attr: {class: 'w-full px-4 py-3 rounded-xl border transition-colors focus:ring-2 focus:ring-offset-2', style: 'background-color: var(--input-bg); border-color: var(--border-muted); color: var(--text-primary);'}}) }}
                        {{ form_errors(form.discordUsername) }}
                        <p class="mt-1 text-sm" style="color: var(--text-muted);">{{ 'api.form.discord_username_help'|trans }}</p>
                    </div>

                    {# Submit Buttons #}
                    <div class="flex items-center justify-between pt-4">
                        <a href="{{ path('user_api_access') }}"
                           class="inline-flex items-center px-4 py-2 rounded-xl font-medium transition-colors"
                           style="color: var(--text-secondary);">
                            {{ ux_icon('lucide:arrow-left', {class: 'w-4 h-4 mr-2'}) }}
                            {{ 'common.back'|trans }}
                        </a>
                        <button type="submit"
                                class="inline-flex items-center px-6 py-3 rounded-xl font-semibold text-white shadow-lg hover:shadow-xl transition-all theme-primary-gradient">
                            {{ ux_icon('lucide:send', {class: 'w-5 h-5 mr-2'}) }}
                            {{ 'api.submit_request'|trans }}
                        </button>
                    </div>
                {{ form_end(form) }}
            </div>
        </div>
    </div>
</div>
{% endblock %}
